# Caddy static-file server for the IoT Fabrikken site.
#
# Auth layers (Railway → Variables):
#
#   Internal dashboard (/en/internal/*, etc.) — always team-only when set:
#     INTERNAL_AUTH_USER
#     INTERNAL_AUTH_HASH  — bcrypt hash from `caddy hash-password`
#
#   Soft-launch site gate (whole public site) — optional:
#     SOFT_LAUNCH_SITE_AUTH=true   — gate all non-internal paths
#     BASIC_AUTH_USER
#     BASIC_AUTH_HASH
#
#   Public launch: set SOFT_LAUNCH_SITE_AUTH=false (or unset). Keep INTERNAL_AUTH_*
#   so /internal/journey/ stays protected while the marketing site is open.

{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# Team-only internal routes (locale-prefixed and bare /internal/).
	@internal path /internal/* /en/internal/* /da/internal/* /de/internal/* /sv/internal/*

	handle @internal {
		basic_auth {
			{$INTERNAL_AUTH_USER} {$INTERNAL_AUTH_HASH}
		}
		file_server
	}

	# Soft launch: password-protect the rest of the site until public go-live.
	@site_gated expression {env.SOFT_LAUNCH_SITE_AUTH} == "true"

	handle @site_gated {
		basic_auth {
			{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
		}
		file_server
	}

	# Public marketing site (default after soft launch).
	handle {
		file_server
	}

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
