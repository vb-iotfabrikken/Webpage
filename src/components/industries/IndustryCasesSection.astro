---
import { resolveCaseStudyLeaf } from "../../data/hubs/caseStudies";
import { getUi } from "../../data/i18n/ui";
import { langPath, type Lang } from "../../data/lang";

interface Props {
  slugs: string[];
  lang?: Lang;
}

const { slugs, lang = "en" } = Astro.props;

if (slugs.length === 0) {
  return;
}

const t = getUi(lang).industries.cases;
const cases = slugs
  .map((slug) => resolveCaseStudyLeaf(slug, lang))
  .filter((leaf): leaf is NonNullable<typeof leaf> => Boolean(leaf));

if (cases.length === 0) {
  return;
}

const casesBase = langPath("case-studies", lang).replace(/\/$/, "");
---

<div class="reveal bg-white border border-stone-100 rounded-xl p-6">
  <h2 class="text-sm font-semibold uppercase tracking-wider text-navy-500 mb-4">
    {t.eyebrow}
  </h2>
  <ul class="space-y-4" role="list">
    {cases.map((entry) => (
      <li>
        <a href={`${casesBase}/${entry.slug}/`} class="group flex items-baseline gap-3">
          <span class="mt-1 w-1.5 h-1.5 rounded-full shrink-0 bg-sky-500"></span>
          <div>
            <div class="font-semibold text-navy-500 group-hover:text-coral-500 transition-colors">
              {entry.title}
            </div>
            <p class="mt-1 text-sm text-stone-900/70 leading-relaxed">{entry.lead}</p>
          </div>
        </a>
      </li>
    ))}
  </ul>
</div>
