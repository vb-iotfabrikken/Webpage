---
import { resolveCaseStudyLeaf } from "../../data/hubs/caseStudies";
import { getUi } from "../../data/i18n/ui";
import { langPath, type Lang } from "../../data/lang";

interface Props {
  slugs: string[];
  lang?: Lang;
}

const { slugs, lang = "en" } = Astro.props;

if (slugs.length === 0) {
  return;
}

const t = getUi(lang).industries.cases;
const cases = slugs
  .map((slug) => resolveCaseStudyLeaf(slug, lang))
  .filter((leaf): leaf is NonNullable<typeof leaf> => Boolean(leaf));

if (cases.length === 0) {
  return;
}

const casesBase = langPath("case-studies", lang);
---

<section class="space-y-6">
  <div>
    <p class="inline-block px-3 py-1 rounded-md bg-stone-100 text-navy-500 text-xs font-semibold uppercase tracking-wider mb-3">
      {t.eyebrow}
    </p>
    <h2 class="text-2xl md:text-3xl font-bold text-navy-500 tracking-tight">
      {t.heading}
    </h2>
  </div>

  <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5" role="list">
    {cases.map((entry) => (
      <li>
        <article class="flex flex-col h-full bg-white border border-stone-100 rounded-xl overflow-hidden hover:border-navy-500 hover:-translate-y-0.5 hover:shadow-md transition-all duration-300">
          {entry.logo && (
            <div class="flex items-center justify-center min-h-[7.5rem] px-8 py-6 border-b border-stone-100 bg-stone-50/60">
              <img
                src={entry.logo}
                alt=""
                width="360"
                height="200"
                class="w-full max-w-[14rem] max-h-20 object-contain"
                loading="lazy"
                decoding="async"
              />
            </div>
          )}
          <div class="flex flex-col flex-1 gap-3 p-5 sm:p-6">
            <h3 class="text-lg font-semibold text-navy-500 leading-snug">{entry.title}</h3>
            <p class="text-sm text-stone-900/70 leading-relaxed flex-1">{entry.lead}</p>
            <a
              href={`${casesBase}/${entry.slug}/`}
              class="inline-flex items-center gap-1 text-sm font-semibold text-sky-600 hover:text-coral-500 transition-colors"
            >
              {t.readMore}
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M3 7h8M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
        </article>
      </li>
    ))}
  </ul>
</section>
