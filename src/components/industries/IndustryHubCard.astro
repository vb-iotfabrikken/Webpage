---
import IndustryIcon from "../IndustryIcon.astro";
import type { IndustrySectorId } from "../../data/industrySectors";

interface Props {
  href: string;
  slug: string;
  title: string;
  titleAccent?: string;
  lead: string;
  ctaLabel: string;
  sectorId?: IndustrySectorId;
  class?: string;
}

const {
  href,
  slug,
  title,
  titleAccent,
  lead,
  ctaLabel,
  sectorId,
  class: className,
} = Astro.props;
---

<a
  href={href}
  class:list={[
    "reveal group relative flex flex-col h-full p-6 md:p-7 bg-white border border-stone-100 rounded-xl hover:border-navy-500 hover:-translate-y-1 hover:shadow-lg transition-all duration-300",
    className,
  ]}
  data-industry-sector={sectorId}
>
  <div class="flex gap-3 items-start">
    <div
      class="shrink-0 w-9 h-9 rounded-lg bg-stone-50 border border-stone-100 text-navy-500 group-hover:bg-stone-100 flex items-center justify-center transition-colors duration-300"
    >
      <IndustryIcon slug={slug} class="w-5 h-5" />
    </div>

    <div class="flex-1 min-w-0">
      <h3 class="text-lg font-semibold text-navy-500 leading-snug pr-1">
        {title}
        {titleAccent && (
          <span class="block text-stone-500 text-sm font-medium mt-0.5 leading-snug">{titleAccent}</span>
        )}
      </h3>
    </div>

    <svg
      width="14"
      height="14"
      viewBox="0 0 14 14"
      fill="none"
      class="shrink-0 text-stone-300 opacity-0 translate-x-0 group-hover:opacity-100 group-hover:translate-x-0.5 group-hover:text-coral-500 transition-all duration-300"
      aria-hidden="true"
    >
      <path d="M3 7h8M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </div>

  <p class="mt-4 text-sm text-stone-900/70 leading-relaxed flex-1">{lead}</p>

  <div class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-navy-500 group-hover:text-coral-500 transition-colors">
    {ctaLabel}
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="transition-transform group-hover:translate-x-1" aria-hidden="true">
      <path d="M3 7h8M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </div>
</a>
