---
import SensorProductPreview from "./SensorProductPreview.astro";

interface Props {
  href: string;
  slug: string;
  title: string;
  titleAccent?: string;
  lead: string;
  ctaLabel: string;
  class?: string;
}

const { href, slug, title, titleAccent, lead, ctaLabel, class: className } = Astro.props;
---

<a
  href={href}
  class:list={[
    "group relative flex flex-col h-full bg-white border border-stone-100 rounded-xl overflow-hidden hover:border-navy-500 hover:-translate-y-1 hover:shadow-lg transition-all duration-300",
    className,
  ]}
>
  <div class="absolute top-0 left-0 right-0 h-1 bg-sky-500 z-10" />

  <SensorProductPreview slug={slug} hoverZoom />

  <div class="flex flex-col flex-1 p-6 md:p-7">
    <h3 class="text-lg font-semibold text-navy-500 mb-2 leading-snug">
      {title}
      {titleAccent && (
        <span class="block text-sky-600 text-base font-medium mt-0.5">{titleAccent}</span>
      )}
    </h3>
    <p class="text-sm text-stone-900/70 leading-relaxed flex-1">{lead}</p>
    <div class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-navy-500 group-hover:text-sky-600 transition-colors">
      {ctaLabel}
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="transition-transform group-hover:translate-x-1" aria-hidden="true">
        <path d="M3 7h8M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </div>
  </div>
</a>
