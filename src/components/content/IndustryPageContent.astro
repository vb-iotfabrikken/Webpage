---
import type { IndustryPageContent } from "../../data/content/types";
import { sensorsHub } from "../../data/hubs/sensors";

interface Props {
  content: IndustryPageContent;
}

const { content } = Astro.props;

const sensorTitleBySlug = Object.fromEntries(
  sensorsHub.leaves.map((leaf) => [leaf.slug, leaf.title.replace(/\.$/, "")]),
);
---

<div class="space-y-16 md:space-y-20">
  <section>
    <p class="inline-block px-3 py-1 rounded-md bg-stone-100 text-navy-500 text-xs font-semibold uppercase tracking-wider mb-5">
      What matters in this sector
    </p>
    <p class="text-lg text-navy-500 leading-relaxed">{content.focus}</p>
  </section>

  <section>
    <p class="inline-block px-3 py-1 rounded-md bg-stone-100 text-navy-500 text-xs font-semibold uppercase tracking-wider mb-5">
      Recommended sensors
    </p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {content.sensorRecommendations.map((rec) => (
        <div class="bg-white rounded-xl border border-stone-100 p-6 md:p-7 hover:border-navy-500 transition-colors">
          <div class="flex flex-wrap items-center gap-2 mb-3">
            <h3 class="text-lg font-semibold text-navy-500">{rec.name}</h3>
            <span class="inline-flex px-2.5 py-0.5 rounded-md bg-sky-50 text-sky-700 text-xs font-semibold">
              {rec.badge}
            </span>
          </div>
          <p class="text-stone-900/70 leading-relaxed">{rec.body}</p>
          <div class="mt-4 flex flex-wrap gap-x-4 gap-y-2">
            {rec.sensorSlugs.map((slug) => (
              <a
                href={`/en/sensors/${slug}/`}
                class="inline-flex items-center gap-1 text-sm font-medium text-sky-600 hover:text-coral-500 transition-colors"
              >
                {sensorTitleBySlug[slug] ?? slug}
                <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M4 10L10 4M10 4H5M10 4V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</div>
