---
interface QA {
  q: string;
  a: string;
}

interface Props {
  title?: string;
  items: QA[];
}

const { title = "Frequently asked questions", items } = Astro.props;
---

<section class="py-20 md:py-24 bg-white">
  <div class="container-page max-w-3xl">
    <h2 class="reveal text-3xl md:text-4xl font-bold text-navy-500 text-center mb-12">
      {title}
    </h2>
    <div class="divide-y divide-stone-100 border-y border-stone-100">
      {items.map((item) => (
        <details class="group py-5 reveal">
          <summary class="flex items-center justify-between cursor-pointer list-none gap-6">
            <span class="text-lg font-medium text-navy-500">{item.q}</span>
            <span class="shrink-0 w-8 h-8 inline-flex items-center justify-center rounded-md border border-stone-100 text-navy-500 transition-transform group-open:rotate-45">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <path d="M7 2v10M2 7h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
              </svg>
            </span>
          </summary>
          <div class="mt-3 pr-12 text-stone-900/70 leading-relaxed">
            {item.a}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
