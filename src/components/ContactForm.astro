---
import Button from "./Button.astro";

interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "Book et møde med os",
  subtitle = "Har du spørgsmål? Vi tager altid gerne en uforpligtende snak om dine muligheder – online eller fysisk.",
} = Astro.props;
---

<section class="py-20 md:py-24 bg-white">
  <div class="container-page">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start">
      <div class="reveal">
        <p class="inline-block px-3 py-1 rounded-md bg-stone-100 text-navy-500 text-xs font-semibold uppercase tracking-wider mb-5">
          Kom i gang
        </p>
        <h2 class="text-3xl md:text-4xl font-bold text-navy-500">{title}</h2>
        <p class="mt-4 text-lg text-stone-900/70">{subtitle}</p>

        <ul class="mt-8 space-y-3 text-navy-500">
          {[
            "Demonstration af RoomAlyzer-platformen",
            "Gennemgang af de sensorer der passer til din case",
            "Prisestimat og tidsplan for opstart",
          ].map((t) => (
            <li class="flex items-start gap-3">
              <span class="mt-0.5 w-5 h-5 inline-flex items-center justify-center rounded-md bg-forest-500 text-white shrink-0">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                  <path d="M2.5 6L5 8.5L9.5 3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              <span>{t}</span>
            </li>
          ))}
        </ul>
      </div>

      <form
        class="reveal bg-stone-50 border border-stone-100 rounded-xl p-6 md:p-8 space-y-4"
        action="#"
        method="post"
      >
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <label class="block">
            <span class="text-sm font-medium text-navy-500">Navn</span>
            <input type="text" name="name" required class="mt-1.5 w-full rounded-md border border-stone-100 bg-white px-3 py-2.5 text-[15px] focus:outline-none focus:ring-2 focus:ring-coral-500 focus:border-coral-500" />
          </label>
          <label class="block">
            <span class="text-sm font-medium text-navy-500">Firma</span>
            <input type="text" name="company" class="mt-1.5 w-full rounded-md border border-stone-100 bg-white px-3 py-2.5 text-[15px] focus:outline-none focus:ring-2 focus:ring-coral-500 focus:border-coral-500" />
          </label>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <label class="block">
            <span class="text-sm font-medium text-navy-500">E-mail</span>
            <input type="email" name="email" required class="mt-1.5 w-full rounded-md border border-stone-100 bg-white px-3 py-2.5 text-[15px] focus:outline-none focus:ring-2 focus:ring-coral-500 focus:border-coral-500" />
          </label>
          <label class="block">
            <span class="text-sm font-medium text-navy-500">Telefon</span>
            <input type="tel" name="phone" class="mt-1.5 w-full rounded-md border border-stone-100 bg-white px-3 py-2.5 text-[15px] focus:outline-none focus:ring-2 focus:ring-coral-500 focus:border-coral-500" />
          </label>
        </div>
        <label class="block">
          <span class="text-sm font-medium text-navy-500">Beskriv dine ønsker</span>
          <textarea name="message" rows="4" class="mt-1.5 w-full rounded-md border border-stone-100 bg-white px-3 py-2.5 text-[15px] focus:outline-none focus:ring-2 focus:ring-coral-500 focus:border-coral-500 resize-none"></textarea>
        </label>
        <div class="flex items-center justify-between gap-4 pt-2">
          <p class="text-xs text-stone-300 leading-relaxed">
            Ved at sende accepterer du vores privatlivspolitik.
          </p>
          <Button type="submit" variant="primary" size="md">Send</Button>
        </div>
      </form>
    </div>
  </div>
</section>
