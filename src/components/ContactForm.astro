---
import Button from "./Button.astro";
import { defaultLang, type Lang } from "../data/lang";
import { getContact } from "../data/i18n/contact";

interface Props {
  title?: string;
  subtitle?: string;
  lang?: Lang;
}

const { title, subtitle, lang = defaultLang } = Astro.props;
const c = getContact(lang);
const f = c.form;
const heading = title ?? c.bookDemo.formTitle;
const sub = subtitle ?? c.bookDemo.formSubtitle;
const validationMessages = JSON.stringify(c.validation);
---

<section class="py-20 md:py-24 bg-white">
  <div class="container-page">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start">
      <div class="reveal">
        <p class="inline-block px-3 py-1 rounded-md bg-stone-100 text-navy-500 text-xs font-semibold uppercase tracking-wider mb-5">
          {f.eyebrow}
        </p>
        <h2 class="text-3xl md:text-4xl font-bold text-navy-500">{heading}</h2>
        <p class="mt-4 text-lg text-stone-900/70">{sub}</p>

        <ul class="mt-8 space-y-3 text-navy-500">
          {f.bullets.map((t) => (
            <li class="flex items-start gap-3">
              <span class="mt-0.5 w-5 h-5 inline-flex items-center justify-center rounded-md bg-forest-500 text-white shrink-0">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                  <path d="M2.5 6L5 8.5L9.5 3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              <span>{t}</span>
            </li>
          ))}
        </ul>
      </div>

      <form
        class="reveal relative bg-stone-50 border border-stone-100 rounded-xl p-6 md:p-8 space-y-4"
        action="#"
        method="post"
        data-contact-form
        data-contact-messages={validationMessages}
        novalidate
      >
        <div class="form-honeypot" aria-hidden="true">
          <label for="contact-website" class="form-honeypot-label">Website</label>
          <input
            type="text"
            id="contact-website"
            name="website"
            tabindex="-1"
            autocomplete="off"
            data-contact-honeypot
          />
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <label class="block">
            <span class="text-sm font-medium text-navy-500">{f.name}</span>
            <input type="text" name="name" required autocomplete="name" class="mt-1.5 w-full rounded-md border border-stone-100 bg-white px-3 py-2.5 text-[15px] focus:outline-none focus:ring-2 focus:ring-coral-500 focus:border-coral-500" />
          </label>
          <label class="block">
            <span class="text-sm font-medium text-navy-500">{f.company}</span>
            <input type="text" name="company" autocomplete="organization" class="mt-1.5 w-full rounded-md border border-stone-100 bg-white px-3 py-2.5 text-[15px] focus:outline-none focus:ring-2 focus:ring-coral-500 focus:border-coral-500" />
          </label>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <label class="block">
            <span class="text-sm font-medium text-navy-500">{f.email}</span>
            <input type="email" name="email" required autocomplete="work email" placeholder={f.emailPlaceholder} class="mt-1.5 w-full rounded-md border border-stone-100 bg-white px-3 py-2.5 text-[15px] focus:outline-none focus:ring-2 focus:ring-coral-500 focus:border-coral-500" />
          </label>
          <label class="block">
            <span class="text-sm font-medium text-navy-500">{f.phone}</span>
            <input type="tel" name="phone" autocomplete="tel" placeholder={f.phonePlaceholder} class="mt-1.5 w-full rounded-md border border-stone-100 bg-white px-3 py-2.5 text-[15px] focus:outline-none focus:ring-2 focus:ring-coral-500 focus:border-coral-500" />
          </label>
        </div>
        <label class="block">
          <span class="text-sm font-medium text-navy-500">{f.message}</span>
          <textarea name="message" rows="4" class="mt-1.5 w-full rounded-md border border-stone-100 bg-white px-3 py-2.5 text-[15px] focus:outline-none focus:ring-2 focus:ring-coral-500 focus:border-coral-500 resize-none"></textarea>
        </label>
        <p class="text-xs text-coral-600 hidden" role="alert" data-contact-error>
          {f.emailError}
        </p>
        <div class="flex items-center justify-between gap-4 pt-2">
          <p class="text-xs text-stone-300 leading-relaxed">
            {f.disclaimer}
          </p>
          <Button type="submit" variant="primary" size="md">{f.submit}</Button>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .form-honeypot {
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
    opacity: 0;
    pointer-events: none;
  }

  .form-honeypot-label,
  .form-honeypot input {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }
</style>

<script>
  import "./contact-form.ts";
</script>
