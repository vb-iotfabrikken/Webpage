---
import type { EventCardCopy } from "../../data/i18n/events";

interface Props {
  href: string;
  logo: string;
  logoAlt: string;
  copy: EventCardCopy;
}

const { href, logo, logoAlt, copy } = Astro.props;
---

<a
  href={href}
  class="reveal group relative flex flex-col h-full rounded-xl overflow-hidden border border-stone-100 bg-gradient-to-br from-navy-500 via-navy-500 to-sky-600 text-white shadow-xl transition-transform duration-200 hover:-translate-y-0.5 hover:shadow-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-coral-500 focus-visible:ring-offset-2"
>
  <div
    class="absolute inset-0 opacity-30 pointer-events-none"
    style="background: radial-gradient(circle at 20% 0%, rgba(85,161,194,0.45), transparent 55%);"
    aria-hidden="true"
  ></div>

  <div class="relative flex flex-col flex-1 p-5 sm:p-6">
    <span class="inline-flex w-fit items-center gap-2 rounded-full border border-white/20 bg-white/10 px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider">
      <span class="h-1.5 w-1.5 rounded-full bg-coral-500" aria-hidden="true"></span>
      {copy.active.eyebrow}
    </span>

    <div class="mt-4 rounded-xl bg-white px-3 py-3 shadow-lg w-fit">
      <img
        src={logo}
        alt={logoAlt}
        width="280"
        height="80"
        class="h-10 w-auto max-w-[10rem] object-contain"
        loading="lazy"
      />
    </div>

    <h2 class="mt-4 text-2xl font-bold leading-tight text-white">{copy.title}</h2>

    <p class="mt-3 border-l-4 border-coral-500 pl-3 text-sm leading-relaxed text-white/90">
      <strong class="block text-white">{copy.date}</strong>
      {copy.location}
    </p>

    <div class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-coral-200 group-hover:text-white transition-colors">
      {copy.active.cta}
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="transition-transform group-hover:translate-x-1" aria-hidden="true">
        <path d="M3 7h8M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </div>
  </div>
</a>
