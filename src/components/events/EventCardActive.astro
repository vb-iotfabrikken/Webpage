---

import type { EventCardCopy } from "../../data/i18n/events";

import {

  eventCardThemeStyles,

  type EventCardTheme,

} from "../../data/eventCardThemes";

import EventActiveCardBody, { type EventVenueBooth } from "./EventActiveCardBody.astro";



interface Props {

  href?: string;

  logo: string;

  logoAlt: string;

  copy: EventCardCopy;

  theme?: EventCardTheme;

  /**

   * Landing-page venue card — same markup as the hub card but links to the

   * official event site (`externalHref`) instead of our detail page.

   */

  static?: boolean;

  externalHref?: string;

  externalAriaLabel?: string;

  /** Booth line on landing venue cards when stand info is known. */

  booth?: EventVenueBooth;

  /** @deprecated Hub Card 1 links to our landing page; external only for venue cards. */

  external?: boolean;

}



const {

  href = "#",

  logo,

  logoAlt,

  copy,

  theme = "navy",

  static: isStatic = false,

  externalHref,

  externalAriaLabel,

  booth,

  external = false,

} = Astro.props;



const palette = eventCardThemeStyles[theme];

/** Card 1 status eyebrow dot — always green (e.g. “Demnächst”). */

const statusDotClass = "bg-emerald-400";

const isExternalVenue = isStatic && Boolean(externalHref);

const cardClass = [

  "group relative flex flex-col h-full rounded-xl overflow-hidden border border-stone-100 text-white shadow-xl",

  "transition-transform duration-200 hover:-translate-y-0.5 hover:shadow-2xl",

  (!isStatic || isExternalVenue) &&

    "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2",

  palette.shell,

];



const bodyProps = { logo, logoAlt, copy, theme, statusDotClass, booth };

---



<div class="reveal h-full">

  {isExternalVenue ? (

    <a

      href={externalHref}

      target="_blank"

      rel="noopener noreferrer"

      aria-label={externalAriaLabel}

      class:list={cardClass}

    >

      <div class="absolute inset-0 opacity-30 pointer-events-none" style={palette.glow} aria-hidden="true"></div>

      <EventActiveCardBody {...bodyProps} />

    </a>

  ) : isStatic ? (

    <div class:list={cardClass}>

      <div class="absolute inset-0 opacity-30 pointer-events-none" style={palette.glow} aria-hidden="true"></div>

      <EventActiveCardBody {...bodyProps} />

    </div>

  ) : (

    <a

      href={href}

      {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}

      class:list={cardClass}

    >

      <div class="absolute inset-0 opacity-30 pointer-events-none" style={palette.glow} aria-hidden="true"></div>

      <EventActiveCardBody {...bodyProps} showCta />

    </a>

  )}

</div>

