---
import type { EventCardCopy } from "../../data/i18n/events";

interface Props {
  logo: string;
  logoAlt: string;
  copy: EventCardCopy;
}

const { logo, logoAlt, copy } = Astro.props;
---

<div class="reveal max-w-3xl rounded-xl border border-stone-100 bg-white p-6 md:p-8 shadow-sm">
  <div class="flex flex-col sm:flex-row gap-5 sm:gap-6">
    <div class="shrink-0 rounded-lg border border-stone-100 bg-stone-50 px-3 py-3 w-fit h-fit">
      <img
        src={logo}
        alt={logoAlt}
        width="280"
        height="80"
        class="h-10 w-auto max-w-[10rem] object-contain"
        loading="lazy"
      />
    </div>

    <div class="min-w-0">
      <p class="text-xs font-semibold uppercase tracking-wider text-sky-600">{copy.news.eyebrow}</p>
      <h2 class="mt-2 text-xl font-bold text-navy-500">{copy.title}</h2>
      <p class="mt-2 text-sm text-stone-600">
        <span class="font-medium text-navy-500">{copy.date}</span>
        <span class="text-stone-300"> · </span>
        {copy.location}
      </p>
      <p class="mt-4 text-base text-stone-900/80 leading-relaxed">{copy.news.note}</p>
    </div>
  </div>
</div>
