---
import type { EventCardCopy } from "../../data/i18n/events";
import {
  eventCardThemeStyles,
  type EventCardTheme,
} from "../../data/eventCardThemes";
import { resolveEventCardLogo } from "../../data/eventCardLogo";

export interface EventVenueBooth {
  label: string;
  detail: string;
}

interface Props {
  logo: string;
  logoAlt: string;
  copy: EventCardCopy;
  theme: EventCardTheme;
  statusDotClass: string;
  booth?: EventVenueBooth;
  showCta?: boolean;
}

const {
  logo,
  logoAlt,
  copy,
  theme,
  statusDotClass,
  booth,
  showCta = false,
} = Astro.props;

const palette = eventCardThemeStyles[theme];
const logoStyle = resolveEventCardLogo(palette.logoPreset);
---

<div class="relative flex flex-col flex-1 p-5 sm:p-6">
  <span class="inline-flex w-fit items-center gap-2 rounded-full border border-white/20 bg-white/10 px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider">
    <span class:list={["h-1.5 w-1.5 rounded-full", statusDotClass]} aria-hidden="true"></span>
    {copy.active.eyebrow}
  </span>

  <div class:list={logoStyle.shell}>
    <img
      src={logo}
      alt={logoAlt}
      width="280"
      height="80"
      class:list={["w-auto object-contain", logoStyle.maxWidth, logoStyle.height]}
      loading="lazy"
    />
  </div>

  <h2 class="mt-4 text-2xl font-bold leading-tight text-white">{copy.title}</h2>

  <p class:list={["mt-3 border-l-4 pl-3 text-sm leading-relaxed text-white/90", palette.borderAccent]}>
    <strong class="block text-white">{copy.date}</strong>
    {copy.location}
  </p>

  {booth && (
    <div class="mt-4 border-t border-white/15 pt-3">
      <p class:list={["text-sm font-bold", palette.boothLabel]}>{booth.label}</p>
      <p class="mt-1 text-sm text-white/55 leading-snug">{booth.detail}</p>
    </div>
  )}

  {showCta && (
    <div class:list={["mt-5 inline-flex items-center gap-1 text-sm font-semibold transition-colors", palette.cta]}>
      {copy.active.cta}
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="transition-transform group-hover:translate-x-1" aria-hidden="true">
        <path d="M3 7h8M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </div>
  )}
</div>
