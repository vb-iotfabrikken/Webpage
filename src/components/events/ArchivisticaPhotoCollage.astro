---
export interface ArchivisticaCollagePhoto {
  src: string;
  alt: string;
  caption: string;
}

interface Props {
  photos: readonly [ArchivisticaCollagePhoto, ArchivisticaCollagePhoto, ArchivisticaCollagePhoto];
}

const { photos } = Astro.props;
const [hero, topRight, bottomRight] = photos;
---

<div class="grid grid-cols-1 gap-4 md:grid-cols-[1.5fr_1fr] md:grid-rows-2 md:gap-[18px]">
  <figure class="relative h-[22rem] overflow-hidden rounded-2xl bg-stone-100 sm:h-[26rem] md:row-span-2 md:h-[37.5rem]">
    <img
      src={hero.src}
      alt={hero.alt}
      class="h-full w-full object-cover object-center"
      loading="lazy"
    />
    <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-navy-500/90 via-navy-500/50 to-transparent px-5 pb-4 pt-14 text-sm font-medium text-white md:text-[0.95rem]">
      {hero.caption}
    </figcaption>
  </figure>

  {[topRight, bottomRight].map((photo) => (
    <figure class="relative h-[18rem] overflow-hidden rounded-2xl bg-stone-100 sm:h-[20rem] md:h-[18.2rem]">
      <img
        src={photo.src}
        alt={photo.alt}
        class="h-full w-full object-cover object-center"
        loading="lazy"
      />
      <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-navy-500/90 via-navy-500/50 to-transparent px-4 pb-3.5 pt-12 text-sm font-medium text-white md:px-[18px] md:pb-3.5 md:pt-10 md:text-[0.88rem]">
        {photo.caption}
      </figcaption>
    </figure>
  ))}
</div>
