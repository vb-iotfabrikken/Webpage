---
import Layout from "../layouts/Layout.astro";
import Hero from "./Hero.astro";
import Button from "./Button.astro";
import CtaBand from "./CtaBand.astro";
import type { Qa } from "../data/faqContent";

interface Breadcrumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description?: string;
  eyebrow: string;
  heroTitle: string;
  heroTitleAccent?: string;
  heroLead: string;
  breadcrumbs?: Breadcrumb[];
  qa: Qa[];
  relatedLinks?: { label: string; href: string }[];
}

const {
  title,
  description,
  eyebrow,
  heroTitle,
  heroTitleAccent,
  heroLead,
  breadcrumbs = [],
  qa,
  relatedLinks = [],
} = Astro.props;

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: qa.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};

const slugify = (s: string) =>
  s
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "")
    .slice(0, 80);
---

<Layout title={title} description={description ?? heroLead}>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  {breadcrumbs.length > 0 && (
    <nav class="container-page pt-6" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-1.5 text-sm text-stone-300">
        {breadcrumbs.map((b, i) => (
          <li class="flex items-center gap-1.5">
            {b.href ? (
              <a href={b.href} class="hover:text-coral-500 transition-colors">{b.label}</a>
            ) : (
              <span class="text-navy-500">{b.label}</span>
            )}
            {i < breadcrumbs.length - 1 && (
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M4.5 3L7.5 6L4.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )}

  <Hero
    eyebrow={eyebrow}
    title={heroTitle}
    titleAccent={heroTitleAccent}
    lead={heroLead}
    align="left"
  >
    <Button href="/en/contact/book-demo/" variant="primary" size="lg" slot="cta">Book demo</Button>
    <Button href="/en/contact/sales/" variant="secondary" size="lg" slot="cta">Ask a question</Button>

    <div slot="visual" class="reveal">
      <div class="bg-white border border-stone-100 rounded-xl p-6 md:p-8 max-w-md">
        <p class="text-xs font-semibold uppercase tracking-wider text-stone-300">On this page</p>
        <ul class="mt-3 space-y-2 text-sm">
          {qa.map((item) => (
            <li>
              <a
                href={`#${slugify(item.q)}`}
                class="text-navy-500 hover:text-coral-500 underline-offset-4 hover:underline transition-colors"
              >
                {item.q}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Hero>

  <section class="py-14">
    <div class="container-page max-w-3xl">
      {qa.map((item) => (
        <article id={slugify(item.q)} class="reveal scroll-mt-24 mb-10 pb-10 border-b border-stone-100 last:border-0 last:mb-0 last:pb-0">
          <h2 class="text-xl md:text-2xl font-bold text-navy-500 tracking-tight">
            {item.q}
          </h2>
          <p class="mt-3 text-stone-900/80 leading-relaxed">
            {item.a}
          </p>
        </article>
      ))}

      {relatedLinks.length > 0 && (
        <div class="mt-10 pt-8 border-t border-stone-100">
          <p class="text-xs font-semibold uppercase tracking-wider text-stone-300">Related</p>
          <ul class="mt-3 space-y-1.5 text-sm">
            {relatedLinks.map((r) => (
              <li>
                <a href={r.href} class="text-navy-500 hover:text-coral-500 underline-offset-4 hover:underline">
                  {r.label} →
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>

  <CtaBand
    title="Didn't find your answer?"
    subtitle="Ask us directly — every question gets turned into future FAQ content."
    primaryLabel="Ask sales"
    primaryHref="/en/contact/sales/"
    secondaryLabel="Book demo"
    secondaryHref="/en/contact/book-demo/"
  />
</Layout>
