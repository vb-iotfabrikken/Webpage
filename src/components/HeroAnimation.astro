---

<div class="hero-stage relative mx-auto max-w-6xl">
  <!-- Neutral ambient shadow behind the scene — just a single soft,  -->
  <!-- heavily blurred blob so the illustration feels lifted off the  -->
  <!-- page without any colour wash.                                  -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute left-[40%] right-[8%] top-[12%] bottom-[-4%] rounded-[48px] bg-navy-500/10 blur-3xl"></div>
  </div>

  <!-- Banner backdrop (wide atrium photo). Grey left of the dashed-line
       midpoint; atrium fades in from that point toward the tablet. See
       .hero-backdrop. -->
  <img
    src={heroBackdropImage.src}
    alt=""
    class="hero-backdrop pointer-events-none absolute inset-0 z-0 h-full w-full"
    width={heroBackdropImage.width}
    height={heroBackdropImage.height}
    srcset={heroBackdropImage.srcSet.map((entry) => `${entry.url} ${entry.width}w`).join(", ")}
    sizes="100vw"
    fetchpriority="high"
    decoding="async"
    aria-hidden="true"
  />

  <!-- Tablet bundle: dashboard SVG + floating-man PNG share one transform
       stack so they always move and scale together. -->
  <div class="hero-tablet-group absolute inset-0 z-[1] pointer-events-none">
    <svg
      class="hero-anim absolute inset-0 z-0 h-full w-full"
      viewBox="0 0 1024 600"
      preserveAspectRatio="xMidYMid meet"
      xmlns="http://www.w3.org/2000/svg"
      role="img"
      aria-label={t.ariaLabel}
    >
    <defs>
      <pattern id="hero-dots" width="28" height="28" patternUnits="userSpaceOnUse">
        <circle cx="1.5" cy="1.5" r="1" fill="#0D3D54" opacity="0.07" />
      </pattern>
      <linearGradient id="chart-area" x1="0" x2="0" y1="0" y2="1">
        <stop offset="0%" stop-color="#55A1C2" stop-opacity="0.28" />
        <stop offset="100%" stop-color="#55A1C2" stop-opacity="0" />
      </linearGradient>
      <!-- Subtle horizontal wash (stone-50) behind the SOLUTION header -->
      <linearGradient id="solution-label-fade" gradientUnits="userSpaceOnUse" x1="488" y1="17" x2="632" y2="17">
        <stop offset="0%" stop-color="#F9F9F9" stop-opacity="0" />
        <stop offset="22%" stop-color="#F9F9F9" stop-opacity="0.1" />
        <stop offset="55%" stop-color="#F9F9F9" stop-opacity="0.14" />
        <stop offset="100%" stop-color="#F9F9F9" stop-opacity="0" />
      </linearGradient>
      <!-- Vertical mask so the SOLUTION wash fades out toward the top
           edge (top transparent → opaque mid/bottom). Uses objectBoundingBox
           so it scales with the rect it's applied to. -->
      <linearGradient id="solution-label-top-fade-grad" gradientUnits="objectBoundingBox" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="white" stop-opacity="0" />
        <stop offset="55%" stop-color="white" stop-opacity="1" />
        <stop offset="100%" stop-color="white" stop-opacity="1" />
      </linearGradient>
      <mask id="solution-label-top-fade-mask" maskUnits="objectBoundingBox" maskContentUnits="objectBoundingBox">
        <rect x="0" y="0" width="1" height="1" fill="url(#solution-label-top-fade-grad)" />
      </mask>
      <filter id="soft-shadow" x="-20%" y="-20%" width="140%" height="150%">
        <feGaussianBlur in="SourceAlpha" stdDeviation="8" />
        <feOffset dx="0" dy="8" />
        <feComponentTransfer>
          <feFuncA type="linear" slope="0.14" />
        </feComponentTransfer>
        <feMerge>
          <feMergeNode />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
      <filter id="puck-shadow" x="-30%" y="-30%" width="160%" height="180%">
        <feGaussianBlur in="SourceAlpha" stdDeviation="3" />
        <feOffset dx="0" dy="4" />
        <feComponentTransfer>
          <feFuncA type="linear" slope="0.18" />
        </feComponentTransfer>
        <feMerge>
          <feMergeNode />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
      <clipPath id="fp-clear-clip" clipPathUnits="userSpaceOnUse">
        <polygon points="204,0 204,172 0,172" />
      </clipPath>
      <clipPath id="fp-blurred-clip" clipPathUnits="userSpaceOnUse">
        <polygon points="0,0 204,0 0,172" />
      </clipPath>
      <filter id="fp-blur" x="-10%" y="-10%" width="120%" height="120%">
        <feGaussianBlur stdDeviation="2.5" />
      </filter>
      <mask id="preserve-safe-band" maskUnits="userSpaceOnUse" x="0" y="0" width="224" height="148">
        <rect x="0" y="0" width="224" height="148" fill="black" />
        <path
          d="M26 108 C 48 96, 72 56, 108 56 S 170 96, 206 108"
          stroke="white"
          stroke-width="16"
          stroke-linecap="round"
          fill="none"
        />
      </mask>
      <symbol id="fp-static" overflow="visible">
        <g stroke="#0D3D54" stroke-width="1.2" stroke-linecap="square" fill="none">
          <path d="M0 50 L44 50 L44 0" />
        </g>
        <g fill="#E7E5E4">
          <rect x="60" y="20" width="76" height="14" rx="3" />
          <rect x="6"  y="72"  width="32" height="14" rx="5" />
          <rect x="6"  y="102" width="32" height="14" rx="5" />
          <rect x="14" y="91"  width="16" height="6"  rx="1" fill="#D7D3D0" />
          <rect x="116" y="72" width="22" height="10" rx="1.5" />
          <rect x="142" y="72" width="22" height="10" rx="1.5" />
          <rect x="116" y="90" width="22" height="10" rx="1.5" />
          <rect x="142" y="90" width="22" height="10" rx="1.5" />
          <circle cx="74"  cy="146" r="7" />
          <circle cx="96"  cy="154" r="6" />
          <circle cx="118" cy="148" r="7" />
          <rect x="84" y="132" width="22" height="5" rx="1" fill="#D7D3D0" />
          <rect x="150" y="128" width="22" height="22" rx="3" />
          <rect x="176" y="128" width="22" height="22" rx="3" />
        </g>
        <g fill="#A8A29E">
          <circle cx="68"  cy="13" r="2.2" />
          <circle cx="84"  cy="13" r="2.2" />
          <circle cx="98"  cy="13" r="2.2" />
          <circle cx="114" cy="13" r="2.2" />
          <circle cx="128" cy="13" r="2.2" />
          <circle cx="68"  cy="41" r="2.2" />
          <circle cx="84"  cy="41" r="2.2" />
          <circle cx="98"  cy="41" r="2.2" />
          <circle cx="114" cy="41" r="2.2" />
          <circle cx="128" cy="41" r="2.2" />
          <circle cx="127" cy="67" r="2" />
          <circle cx="153" cy="67" r="2" />
          <circle cx="127" cy="105" r="2" />
          <circle cx="153" cy="105" r="2" />
        </g>
        <g font-size="6.5" font-weight="700" fill="#78716C" text-anchor="middle" letter-spacing="0.04em">
          <text x="22"  y="26">{t.fpOffice}</text>
        </g>
        <g font-size="5" font-weight="700" fill="#B8B4B1" text-anchor="middle" letter-spacing="0.3em">
          <text x="98"  y="60">{t.fpMeeting}</text>
          <text x="22"  y="66">{t.fpLounge}</text>
          <text x="140" y="118">{t.fpDesks}</text>
          <text x="96"  y="118">{t.fpCollab}</text>
          <text x="174" y="122">{t.fpFocus}</text>
        </g>
        <g stroke="white" stroke-width="1">
          <circle cx="98"  cy="27"  r="3.4" fill="#DC626A" />
          <circle cx="22"  cy="79"  r="3.4" fill="#65A99C" />
          <circle cx="22"  cy="109" r="3.4" fill="#65A99C" />
          <circle cx="127" cy="77"  r="3.4" fill="#65A99C" />
          <circle cx="153" cy="77"  r="3.4" fill="#DC626A" />
          <circle cx="127" cy="95"  r="3.4" fill="#65A99C" />
          <circle cx="153" cy="95"  r="3.4" fill="#DC626A" />
          <circle cx="96"  cy="144" r="3.4" fill="#65A99C" />
          <circle cx="22"  cy="38"  r="3.4" fill="#65A99C" />
          <circle cx="161" cy="139" r="3.4" fill="#65A99C" />
          <circle cx="187" cy="139" r="3.4" fill="#DC626A" />
        </g>
      </symbol>
    </defs>

    <rect width="1024" height="600" fill="url(#hero-dots)" />

    <!-- All drawable content is wrapped in a small leftward shift so    -->
    <!-- the sensor column + dashboard read as visually centred within   -->
    <!-- the 1024px viewBox.                                             -->
    <g transform="translate(-76 0)">

        <!-- Section headers: a little glyph + strong label + accent    -->
        <!-- underline in each side's theme colour, so the two zones    -->
        <!-- read clearly at a glance. Translated up 15 px so the       -->
        <!-- header row sits closer to the top of the SVG.              -->
        <g transform="translate(0 -15)">
          <g transform="translate(-5 0)">
            <!-- SENSORS: a miniature puck icon, coral accent. Positioned -->
            <!-- so the header sits directly above the sensor column       -->
            <!-- (icon flush with the left edge of the puck at x=220).     -->
            <g transform="translate(186 1)">
              <circle cx="11" cy="11" r="11" fill="#DC626A" opacity="0.12" />
              <circle cx="11" cy="11" r="7"  fill="white" stroke="#DC626A" stroke-width="1.6" />
              <circle cx="11" cy="11" r="2.5" fill="#DC626A" />
            </g>
            <text x="218" y="17" font-size="16" font-weight="800" fill="#0D3D54" letter-spacing="0.26em">{t.sensors}</text>
            <rect x="218" y="25" width="70" height="3" rx="1.5" fill="#DC626A" />
          </g>

          <!-- Soft fade behind SOLUTION so the label stays readable over
               the atrium backdrop (icon + text + underline only). -->
          <rect
            x="488"
            y="0"
            width="144"
            height="47"
            fill="url(#solution-label-fade)"
            mask="url(#solution-label-top-fade-mask)"
            pointer-events="none"
          />

          <!-- SOLUTION: a miniature dashboard icon, sky accent. -->
          <g transform="translate(506 1)">
            <rect x="0"  y="2"  width="22" height="18" rx="3" fill="#55A1C2" opacity="0.12" />
            <rect x="2"  y="4"  width="18" height="14" rx="2" fill="white" stroke="#55A1C2" stroke-width="1.4" />
            <rect x="4"  y="7"  width="11" height="1.8" rx="0.9" fill="#55A1C2" />
            <rect x="4"  y="10" width="7"  height="1.8" rx="0.9" fill="#55A1C2" />
            <rect x="4"  y="13" width="9"  height="1.8" rx="0.9" fill="#55A1C2" />
          </g>
          <text x="538" y="17" font-size="16" font-weight="800" fill="#0D3D54" letter-spacing="0.26em">{t.solution}</text>
          <rect x="538" y="25" width="78" height="3" rx="1.5" fill="#55A1C2" />
        </g>

        <g transform="translate(-5 0)">
        <!-- ==================== SENSOR 1 — School (indoor climate) ==================== -->
        <!-- Each sensor used to be drawn as a generic IoT puck. Instead -->
        <!-- the hero now shows the kind of building the sensor lives in -->
        <!-- — a school for indoor air, a church for heritage climate,   -->
        <!-- an office for workspace use. The radiating waves still      -->
        <!-- emanate from the building, so "this place is reporting in"  -->
        <!-- reads at a glance.                                          -->
        <g class="sensor sensor-0" transform="translate(150 125)">
          <!-- Wireless arcs radiating from the building. -->
          <g class="waves" stroke="#55A1C2" fill="none" stroke-linecap="round" stroke-width="1.6">
            <circle class="wave wave-a" cx="110" cy="0" r="42" />
            <circle class="wave wave-b" cx="110" cy="0" r="42" />
            <circle class="wave wave-c" cx="110" cy="0" r="42" />
          </g>

          <!-- Soft elliptical footprint anchors the building visually. -->
          <ellipse cx="110" cy="14" rx="34" ry="2.6" fill="#0D3D54" opacity="0.09" />

          <!-- School: long building with a row of windows and a       -->
          <!-- central arched entrance. Centred on the sensor column.  -->
          <g stroke="#0D3D54" stroke-width="1.4" fill="none" stroke-linejoin="round" stroke-linecap="round">
            <!-- Building shell with a low gable roof -->
            <path d="M83 14 L83 -10 L110 -20 L137 -10 L137 14" />
            <!-- Arched entrance -->
            <path d="M106 14 L106 2 A 4 4 0 0 1 114 2 L114 14" />
            <!-- Windows: two on each side of the entrance -->
            <rect x="88"  y="-4" width="7" height="7" rx="0.5" />
            <rect x="98"  y="-4" width="7" height="7" rx="0.5" />
            <rect x="116" y="-4" width="7" height="7" rx="0.5" />
            <rect x="126" y="-4" width="7" height="7" rx="0.5" />
          </g>

          <!-- Caption: small green "live" dot to the left of the      -->
          <!-- use-case label, then headline reading + supporting line. -->
          <text x="110" y="48" text-anchor="middle" font-size="7.5" font-weight="700" fill="#57534E" letter-spacing="0.18em">{t.school}</text>
          <text x="110" y="62" text-anchor="middle" font-size="11" font-weight="700" fill="#0D3D54">{t.schoolReading}</text>
          <text x="110" y="74" text-anchor="middle" font-size="8"  fill="#44403C">{t.schoolDetail}</text>
        </g>

        <!-- ==================== SENSOR 2 — Church (heritage climate) ==================== -->
        <!-- A historic building with a humidity-sensitive interior:    -->
        <!-- ties the coral wave colour into the dashboard's mould-risk -->
        <!-- alert and preservation chart so the whole hero reads as    -->
        <!-- one connected story.                                       -->
        <g class="sensor sensor-1" transform="translate(150 303)">
          <g class="waves" stroke="#DC626A" fill="none" stroke-linecap="round" stroke-width="1.6">
            <circle class="wave wave-a" cx="110" cy="0" r="42" />
            <circle class="wave wave-b" cx="110" cy="0" r="42" />
            <circle class="wave wave-c" cx="110" cy="0" r="42" />
          </g>

