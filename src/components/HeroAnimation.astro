              d="M26 108 C 32 104, 38 102, 44 98 C 50 108, 56 120, 64 116 C 70 110, 78 90, 86 70 C 92 58, 100 48, 110 52 C 120 56, 128 62, 138 74 C 146 84, 150 108, 158 118 C 164 124, 172 112, 180 102 C 190 104, 200 108, 206 110"
              fill="none"
