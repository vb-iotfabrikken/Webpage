<style>
  .hero-anim {
    font-family: var(--font-sans);
  }

  /* Wireless arcs: three concentric rings that grow and fade, one after
     the other, simulating an antenna transmitting. */
  .wave {
    transform-box: fill-box;
    transform-origin: center;
    animation: wave-grow 2.8s ease-out infinite;
    opacity: 0;
  }
  .wave-a { animation-delay: 0s; }
  .wave-b { animation-delay: 0.9s; }
  .wave-c { animation-delay: 1.8s; }
  .sensor-1 .wave-a { animation-delay: 0.3s; }
  .sensor-1 .wave-b { animation-delay: 1.2s; }
  .sensor-1 .wave-c { animation-delay: 2.1s; }
  .sensor-2 .wave-a { animation-delay: 0.6s; }
  .sensor-2 .wave-b { animation-delay: 1.5s; }
  .sensor-2 .wave-c { animation-delay: 2.4s; }

  @keyframes wave-grow {
    0%   { transform: scale(1);   opacity: 0.5; }
    70%  { opacity: 0.08; }
    100% { transform: scale(1.9); opacity: 0; }
  }

  /* Data packet flying from the puck edge (x=254) to the dashboard
     (x=490). The delta vectors match the dashed lines above. */
  .packet {
    opacity: 0;
    animation-duration: 2.8s;
    animation-timing-function: cubic-bezier(0.4, 0, 0.6, 1);
    animation-iteration-count: infinite;
    will-change: transform, opacity;
  }
  @keyframes packet-0 {
    0%   { transform: translate(0, 0);         opacity: 0; }
    10%  { opacity: 1; }
    85%  { opacity: 1; }
    100% { transform: translate(236px, 60px);  opacity: 0; }
  }
  @keyframes packet-1 {
    0%   { transform: translate(0, 0);         opacity: 0; }
    10%  { opacity: 1; }
    85%  { opacity: 1; }
    100% { transform: translate(236px, 0);     opacity: 0; }
  }
  @keyframes packet-2 {
    0%   { transform: translate(0, 0);         opacity: 0; }
    10%  { opacity: 1; }
    85%  { opacity: 1; }
    100% { transform: translate(236px, -66px); opacity: 0; }
  }
  .packet-0 { animation-name: packet-0; animation-delay: 0s; }
  .packet-1 { animation-name: packet-1; animation-delay: 0.9s; }
  .packet-2 { animation-name: packet-2; animation-delay: 1.8s; }

  /* Green status LED on each sensor. */
  .led {
    animation: led-blink 1.8s ease-in-out infinite;
  }
  .sensor-1 .led { animation-delay: 0.6s; }
  .sensor-2 .led { animation-delay: 1.2s; }
  @keyframes led-blink {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.3; }
  }

  /* Dashboard "live" dot mirrors the sensor LEDs. */
  .live-dot {
    animation: led-blink 1.8s ease-in-out infinite;
  }

  /* Line chart draws itself in once, then sits with a pulsing dot at
     the far end. The dasharray is sized to cover the longer of the
     two line-chart paths (preservation ≈ 384px, CO₂ ≈ 260px). */
  .chart-line {
    stroke-dasharray: 500;
    stroke-dashoffset: 500;
    animation: chart-draw 3.5s cubic-bezier(0.4, 0, 0.2, 1) 0.4s forwards;
  }
  .chart-fill {
    opacity: 0;
    animation: chart-fade-in 1s ease-out 3.4s forwards;
  }
  @keyframes chart-draw {
    to { stroke-dashoffset: 0; }
  }
  @keyframes chart-fade-in {
    to { opacity: 1; }
  }

  /* Pulsing ring at the current chart value. */
  .chart-pulse {
    transform-box: fill-box;
    transform-origin: center;
    animation: chart-ring 2.2s ease-out infinite;
    opacity: 0;
  }
  @keyframes chart-ring {
    0%   { transform: scale(0.8); opacity: 0.8; }
    100% { transform: scale(3);   opacity: 0; }
  }

  /* One room on the floorplan is in alert: emit a coral ring. */
  .alert-ring {
    transform-box: fill-box;
    transform-origin: center;
    animation: alert-ring 1.8s ease-out infinite;
  }
  @keyframes alert-ring {
    0%   { transform: scale(1);   opacity: 0.9; }
    100% { transform: scale(4.5); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .wave,
    .packet,
    .led,
    .live-dot,
    .chart-line,
    .chart-fill,
    .chart-pulse,
    .alert-ring {
      animation: none;
    }
    .packet { opacity: 1; }
    .wave   { opacity: 0.2; }
    .chart-line { stroke-dashoffset: 0; }
    .chart-fill { opacity: 1; }
  }
</style>
