            <text   x="143"  y="144">Breach</text>
          </g>
        </g>

        <!-- Floorplan map (top of right column).                     -->
        <!-- Drawn as an architectural floorplan with thick outer      -->
        <!-- walls, thinner interior walls, door openings with swing   -->
        <!-- arcs, light furniture hints and named rooms.              -->
        <g transform="translate(742 140)">
          <rect width="232" height="234" rx="10" fill="white" stroke="#E7E5E4" />
          <text x="14" y="20" font-size="9" font-weight="700" fill="#A8A29E" letter-spacing="0.14em">FLOORPLAN</text>
          <text x="14" y="34" font-size="11" font-weight="600" fill="#0D3D54">Floor 2 · live status</text>

          <g transform="translate(14 46)">
            <!-- Floor slab (shared background). -->
            <rect x="0" y="0" width="204" height="172" fill="#FAFAF9" />

            <!-- Blurred half (upper-left triangle): the architectural   -->
            <!-- floorplan is softened into an abstract background so    -->
            <!-- the availability number can sit on top of it.           -->
            <g clip-path="url(#fp-blurred-clip)">
              <g filter="url(#fp-blur)" opacity="0.5">
                <use href="#fp-static" />
              </g>
            </g>

            <!-- Clear half (lower-right triangle): the floorplan as it  -->
