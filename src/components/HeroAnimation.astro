---
// Animated hero scene for the homepage.
// It tells the two-part story of what IoT Fabrikken actually sells:
//   • SENSORS — physical hardware (pucks branded "IoT Fabrikken") that
//     measure the room and transmit readings wirelessly.
//   • SOLUTION — the RoomAlyzer platform, where those readings become
//     dashboards, reports, alerts and maps that humans actually use.
// Pure SVG + CSS, no dependencies. Respects prefers-reduced-motion.
//
// Localisation note: every text node below is positioned at a FIXED SVG
// coordinate, and every card/box is a fixed-size <rect>. Translations must
// therefore be kept short enough to fit the existing boxes — the geometry
// never changes between locales, so the pictures and boxes never shift.
// "RoomAlyzer" is a brand name and stays identical across locales.
import { defaultLang, type Lang } from "../data/lang";
import { heroBackdropImage, heroManImage } from "../data/heroImages";

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;

interface HeroScene {
  ariaLabel: string;
  sensors: string;
  solution: string;
  school: string;
  schoolReading: string;
