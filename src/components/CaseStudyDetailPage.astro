---
import Layout from "../layouts/Layout.astro";
import Hero from "./Hero.astro";
import Button from "./Button.astro";
import CtaBand from "./CtaBand.astro";
import { getCaseStudyCategoryLabels } from "../data/hubs/caseStudies";
import { resolveCaseStudyDetail } from "../data/hubs/caseStudyDetails";
import type { CaseStudyLeaf } from "../data/hubs/caseStudies";
import { getCases } from "../data/i18n/cases";
import { langPath, type Lang } from "../data/lang";
import { articleSchema, breadcrumbSchema } from "../lib/seo/schema";

interface Breadcrumb {
  label: string;
  href?: string;
}

interface Props {
  lang: Lang;
  leaf: CaseStudyLeaf;
  breadcrumbs: Breadcrumb[];
  /** Case exists in a single locale — skip hreflang alternates. */
  suppressHreflang?: boolean;
}

const { lang, leaf, breadcrumbs, suppressHreflang = false } = Astro.props;
const detail = resolveCaseStudyDetail(leaf, lang);
const t = getCases(lang);
const categoryLabels = getCaseStudyCategoryLabels(lang);
const casesHref = langPath("case-studies", lang);
const pageTitle = `${leaf.seoTitle ?? leaf.title.replace(/\.$/, "")} | IoT Fabrikken`;
const heroLead = detail.intro[0] ?? leaf.lead;
const metaDescription = leaf.metaDescription ?? heroLead;
const bodyParagraphs = detail.intro.length > 1 ? detail.intro.slice(1) : detail.intro.length === 0 ? [] : [];
const isExternal = (href: string) => /^https?:\/\//i.test(href);

const caseJsonLd = [
  breadcrumbSchema(
    breadcrumbs
      .filter((b) => b.href)
      .map((b) => ({ name: b.label, href: b.href as string }))
      .concat({ name: leaf.title.replace(/\.$/, ""), href: Astro.url.pathname }),
  ),
  articleSchema({
    title: leaf.title.replace(/\.$/, ""),
    description: metaDescription,
    url: Astro.url.pathname,
    image: leaf.ogImage ?? leaf.logo,
    type: "Article",
  }),
].filter(Boolean) as Array<Record<string, unknown>>;
---

<Layout
  title={pageTitle}
  description={metaDescription}
  ogImage={leaf.ogImage ?? leaf.logo}
  noindex={leaf.noindex}
  suppressHreflang={suppressHreflang}
  jsonLd={caseJsonLd}
  analyticsPageType="case_study"
  analyticsContentId={leaf.slug}
>
  <nav class="container-page pt-6" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-1.5 text-sm text-stone-300">
      {breadcrumbs.map((b, i) => (
        <li class="flex items-center gap-1.5">
          {b.href ? (
            <a href={b.href} class="hover:text-coral-500 transition-colors">{b.label}</a>
          ) : (
            <span class="text-navy-500">{b.label}</span>
          )}
          {i < breadcrumbs.length - 1 && (
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path
                d="M4.5 3L7.5 6L4.5 9"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          )}
        </li>
      ))}
    </ol>
  </nav>

  <Hero
    title={leaf.title}
    titleAccent={detail.titleAccent}
    lead={heroLead}
    align="left"
    compactTop={breadcrumbs.length > 0}
  >
    {leaf.logo && (
      <div slot="visual" class="reveal max-w-xs">
        <div class="bg-white border border-stone-100 rounded-xl p-8 flex items-center justify-center">
          <img
            src={leaf.logo}
            alt={leaf.logoAlt ?? ""}
            width="280"
            height="120"
            class="max-h-24 w-auto object-contain"
            loading="eager"
          />
        </div>
      </div>
    )}
  </Hero>

  <section class="py-12 md:py-16 border-b border-stone-100">
    <div class="container-page">
      <div class="max-w-3xl space-y-8">
        {leaf.category && (
          <p class="inline-block px-2.5 py-1 rounded-md bg-stone-50 text-navy-500 text-[11px] font-semibold uppercase tracking-wider">
            {categoryLabels[leaf.category as keyof typeof categoryLabels]}
          </p>
        )}

        {bodyParagraphs.map((paragraph) => (
          <p class="text-lg text-stone-900/80 leading-relaxed">{paragraph}</p>
        ))}

        {leaf.articleHref && (
          <p class="text-lg">
            <a
              href={leaf.articleHref}
              class="inline-flex items-center gap-1.5 font-semibold text-sky-600 hover:text-coral-500 transition-colors"
              target={isExternal(leaf.articleHref) ? "_blank" : undefined}
              rel={isExternal(leaf.articleHref) ? "noopener noreferrer" : undefined}
            >
              {t.readFullCase}
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path
                  d="M3 7h8M7.5 3.5L11 7l-3.5 3.5"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </a>
          </p>
        )}

        {detail.quote && (
          <div class="bg-stone-50 border border-stone-100 rounded-xl p-8 md:p-10">
            <h2 class="text-2xl font-bold text-navy-500 tracking-tight">{detail.quote.heading}</h2>
            {detail.quote.subtitle && (
              <p class="mt-2 text-base font-medium text-sky-600">{detail.quote.subtitle}</p>
            )}
            <blockquote class="mt-6 border-l-4 border-sky-500 pl-6">
              <p class="text-lg text-stone-900/80 leading-relaxed italic">{detail.quote.body}</p>
              {detail.quote.attribution && (
                <footer class="mt-4 text-sm font-semibold text-navy-500 not-italic">
                  {detail.quote.attribution}
                </footer>
              )}
            </blockquote>
          </div>
        )}

        <div class="flex flex-wrap gap-3 pt-2">
          <Button href={casesHref} variant="secondary" size="md">{t.allCases}</Button>
          <Button href={langPath("contact/book-demo", lang)} variant="primary" size="md">
            {t.bookDemo}
          </Button>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    title={t.detailCtaTitle}
    subtitle={t.detailCtaSubtitle}
    primaryLabel={t.bookDemo}
    primaryHref={langPath("contact/book-demo", lang)}
    secondaryLabel={t.contactSales}
    secondaryHref={langPath("contact/sales", lang)}
  />
</Layout>
