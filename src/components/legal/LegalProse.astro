---
/** Readable long-form typography for legal and policy pages. */
---

<div class="landing-prose">
  <slot />
</div>

<style is:global>
  .landing-prose {
    color: var(--color-stone-900);
    line-height: 1.7;
    font-size: 1.0625rem;
  }
  .landing-prose > * + * {
    margin-top: 1.25em;
  }
  .landing-prose h2 {
    font-size: 1.75rem;
    line-height: 1.2;
    margin-top: 2.25em;
    margin-bottom: 0.5em;
    color: var(--color-navy-500);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .landing-prose h3 {
    font-size: 1.25rem;
    margin-top: 1.75em;
    margin-bottom: 0.5em;
    color: var(--color-navy-500);
    font-weight: 600;
  }
  .landing-prose p {
    color: color-mix(in srgb, var(--color-stone-900) 78%, white);
  }
  .landing-prose a {
    color: var(--color-sky-600);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .landing-prose a:hover {
    color: var(--color-coral-500);
  }
  .landing-prose strong {
    color: var(--color-navy-500);
    font-weight: 600;
  }
  .landing-prose ul,
  .landing-prose ol {
    padding-left: 1.25rem;
  }
  .landing-prose ul {
    list-style: disc;
  }
  .landing-prose ol {
    list-style: decimal;
  }
  .landing-prose li + li {
    margin-top: 0.4em;
  }
  .landing-prose hr {
    border: 0;
    border-top: 1px solid var(--color-stone-100);
    margin: 2.5em 0;
  }
</style>
