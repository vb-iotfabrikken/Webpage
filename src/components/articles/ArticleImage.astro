---
import { landingCategories, categoryColorClasses } from "../../data/landingCategories";
import type { LandingCategorySlug } from "../../data/landingCategories";

/**
 * Teaser / hero image slot for article surfaces. When `src` is set it renders
 * a real, crawlable image with descriptive alt text. When no artwork exists
 * yet it falls back to a category-coloured placeholder so every card and page
 * keeps a consistent, SEO/GEO-friendly image structure ready for real photos.
 */
interface Props {
  src?: string;
  alt?: string;
  category: LandingCategorySlug;
  /** Tailwind aspect-ratio utility for the slot (default 16/9 teaser). */
  ratio?: string;
  /** Rounded-corner utility (default `rounded-lg`). */
  rounded?: string;
  /** Extra classes for the outer wrapper. */
  class?: string;
  /** Eager-load for above-the-fold hero usage. */
  eager?: boolean;
}

const {
  src,
  alt,
  category,
  ratio = "aspect-[16/9]",
  rounded = "rounded-lg",
  class: className = "",
  eager = false,
} = Astro.props;

const cat = landingCategories[category];
const cc = categoryColorClasses(cat.color);
---

<div class={`relative overflow-hidden bg-stone-50 ${rounded} ${ratio} ${className}`}>
  {src ? (
    <img
      src={src}
      alt={alt ?? cat.name}
      width="1200"
      height="675"
      loading={eager ? "eager" : "lazy"}
      decoding="async"
      class="absolute inset-0 w-full h-full object-cover"
    />
  ) : (
    <div class="absolute inset-0 flex flex-col items-center justify-center gap-2" aria-hidden="true">
      <div
        class="absolute inset-0 opacity-[0.06]"
        style="background-image: radial-gradient(var(--color-navy-500) 1px, transparent 1px); background-size: 16px 16px;"
      ></div>
      <svg
        class={`relative ${cc.accent}`}
        width="34"
        height="34"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect x="3" y="3" width="18" height="18" rx="2" />
        <circle cx="8.5" cy="8.5" r="1.5" />
        <path d="M21 15l-5-5L5 21" />
      </svg>
      <span class={`relative text-[11px] font-semibold uppercase tracking-wider ${cc.accent}`}>
        {cat.name}
      </span>
    </div>
  )}
</div>
