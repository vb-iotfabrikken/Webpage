---
import { getArticlesIntro } from "../../data/i18n/articles";
import type { Lang } from "../../data/lang";

interface Props {
  lang?: Lang;
}

const { lang = "en" } = Astro.props;
const intro = getArticlesIntro(lang);
---

<section class="reveal mt-8 rounded-xl border border-stone-100 bg-white p-5 md:p-6">
  <details class="group">
    <summary class="flex cursor-pointer list-none items-start justify-between gap-4">
      <div>
        <h2 class="text-lg font-semibold text-navy-500">{intro.title}</h2>
        <p class="mt-1 max-w-2xl text-sm text-stone-900/70 leading-relaxed">{intro.lead}</p>
      </div>
      <span class="mt-1 shrink-0 inline-flex items-center gap-1 text-xs font-semibold text-sky-600">
        <span class="group-open:hidden">Read more</span>
        <span class="hidden group-open:inline">Show less</span>
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" class="transition-transform group-open:rotate-180" aria-hidden="true">
          <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    </summary>

    <div class="mt-4 border-t border-stone-100 pt-4 grid gap-6 md:grid-cols-3">
      <ul class="md:col-span-2 space-y-2">
        {intro.includes.map((item) => (
          <li class="flex items-start gap-2 text-sm text-stone-900/80 leading-relaxed">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-sky-500"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-stone-300">{intro.elsewhereLabel}</p>
        <ul class="mt-2 space-y-1.5">
          {intro.elsewhere.map((link) => (
            <li>
              <a
                href={link.href}
                class="inline-flex items-center gap-1 text-sm font-medium text-navy-500 hover:text-coral-500 transition-colors"
              >
                {link.label}
                <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M3 7h8M7.5 3.5L11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </details>
</section>
