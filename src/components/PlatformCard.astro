---
import PlatformIcon from "./PlatformIcon.astro";

export type PlatformCardData = {
  slug: string;
  href: string;
  title: string;
  titleAccent?: string;
};

interface Props {
  platform: PlatformCardData;
}

const { platform: p } = Astro.props;
---

<a
  href={p.href}
  class="reveal group relative flex flex-col h-full bg-white border border-stone-100 rounded-xl overflow-hidden hover:border-navy-500 hover:-translate-y-1 hover:shadow-lg transition-all duration-300"
>
  <div class="absolute top-0 left-0 right-0 h-1 bg-sky-500"></div>

  <div class="flex flex-col flex-1 p-6 md:p-7">
    <div class="flex gap-3 items-center">
      <div
        class="shrink-0 w-10 h-10 rounded-lg bg-stone-50 text-forest-500 group-hover:bg-forest-50 flex items-center justify-center transition-colors duration-300"
      >
        <PlatformIcon slug={p.slug} />
      </div>

      <h3 class="flex-1 min-w-0 text-lg font-semibold text-navy-500 leading-snug pr-1">
        {p.title}
        {p.titleAccent && (
          <span class="block text-sky-600 text-sm font-medium mt-0.5">{p.titleAccent}</span>
        )}
      </h3>

      <svg
        width="14"
        height="14"
        viewBox="0 0 14 14"
        fill="none"
        class="shrink-0 text-stone-300 opacity-0 translate-x-0 group-hover:opacity-100 group-hover:translate-x-0.5 group-hover:text-sky-600 transition-all duration-300"
        aria-hidden="true"
      >
        <path d="M3 7h8M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </div>
  </div>
</a>
