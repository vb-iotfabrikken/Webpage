---
import ModuleCard from "./ModuleCard.astro";
import { getModulesHub } from "../data/hubs/modules";
import { defaultLang, langPath, type Lang } from "../data/lang";
import { isLivePath } from "../data/launch";

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const hub = getModulesHub(lang);

const cards = hub.leaves
  .map((leaf) => ({
    slug: leaf.slug,
    href: langPath(`/modules/${leaf.slug}/`, lang),
    title: leaf.title.replace(/\.$/, ""),
    titleAccent: leaf.titleAccent,
  }))
  .filter((item) => isLivePath(item.href));
---

<section class="py-12 md:py-16">
  <div class="container-page">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {cards.map((m) => <ModuleCard module={m} />)}
    </div>
  </div>
</section>
