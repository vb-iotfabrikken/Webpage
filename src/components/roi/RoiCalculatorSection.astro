---
import DeskOptimizerPanel from "./DeskOptimizerPanel.astro";
import EnergySaverPanel from "./EnergySaverPanel.astro";
import RoiDemoPanel from "./RoiDemoPanel.astro";
import EmailUnlockPanel from "./EmailUnlockPanel.astro";
import RoiDisqualifyDialog from "./RoiDisqualifyDialog.astro";
import RoiDeskHeatmap from "./RoiDeskHeatmap.astro";
import Button from "../Button.astro";
import { astroLang, langPath } from "../../data/lang";

interface Props {
  id?: string;
  showHeader?: boolean;
  compact?: boolean;
  /** Sit directly under a page hero — same spacing as team group portrait. */
  afterPageHero?: boolean;
  showEmailGate?: boolean;
  salesCtaLabel?: string;
  salesCtaHref?: string;
  eyebrow?: string;
  title?: string;
  titleAccent?: string;
  subtitle?: string;
}

const {
  id = "roi-calculator",
  showHeader = true,
  compact = false,
  afterPageHero = false,
  showEmailGate = true,
  salesCtaLabel = "Discuss your ROI with Sales",
  salesCtaHref: salesCtaHrefProp,
  eyebrow = "ROI calculator",
  title = "See what you could",
  titleAccent = "save.",
  subtitle = "Desk Optimizer and Energy Saver — a full ROI picture with break-even and 3-year cash flow.",
} = Astro.props;

const lang = astroLang(Astro);
const salesCtaHref = salesCtaHrefProp ?? langPath("contact/sales", lang);
const spaceManagementHref = langPath("modules/space-management", lang);
const indoorClimateHref = langPath("modules/indoor-climate", lang);
---

<section
  id={id}
  class:list={[
    "bg-stone-50 scroll-mt-24",
    afterPageHero
      ? "pb-8 md:pb-12"
      : compact
        ? "py-10 md:py-14"
        : "py-20 md:py-28",
  ]}
  data-hero-gap-keep={afterPageHero || undefined}
  data-roi-calculator
>
  <div class="container-page">
    {showHeader && (
      <div class="reveal mb-10 md:mb-12">
        <p class="inline-block px-3 py-1 rounded-md bg-stone-100 text-navy-500 text-xs font-semibold uppercase tracking-wider mb-5">
          {eyebrow}
        </p>
        <h2 class="text-4xl md:text-6xl font-bold leading-[1.05] tracking-tight text-navy-500 max-w-3xl">
          {title} <span class="text-sky-600">{titleAccent}</span>
        </h2>
        <p class="mt-5 text-lg md:text-xl text-stone-900/70 max-w-2xl">
          {subtitle}
        </p>
      </div>
    )}

    <div
      class="reveal bg-white border border-stone-100 rounded-xl p-5 md:p-8 shadow-sm overflow-visible"
    >
      <div class="mb-8 pb-6 border-b border-stone-100">
        <div class="flex rounded-lg border border-stone-100 p-1 bg-stone-50 w-fit" role="tablist" aria-label="Calculator type">
          <button
            type="button"
            role="tab"
            aria-selected="true"
            class="roi-tab is-active px-4 py-2 text-sm font-semibold rounded-md transition-colors"
            data-roi-tab="desk"
          >
            Desk Optimizer
          </button>
          <button
            type="button"
            role="tab"
            aria-selected="false"
            class="roi-tab px-4 py-2 text-sm font-semibold rounded-md transition-colors"
            data-roi-tab="energy"
          >
            Energy Saver
          </button>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
        <div class="min-w-0">
          <p class="text-xs text-stone-300 mb-4" data-roi-module-link-desk>
            <a href={spaceManagementHref} class="text-sky-600 hover:text-coral-500 font-medium">
              Space management →
            </a>
          </p>
          <p class="text-xs text-stone-300 mb-4 hidden" data-roi-module-link-energy>
            <a href={indoorClimateHref} class="text-sky-600 hover:text-coral-500 font-medium">
              Indoor climate →
            </a>
          </p>
          <DeskOptimizerPanel />
          <EnergySaverPanel />
        </div>

        <div class="min-w-0 flex flex-col gap-4" data-roi-right-stack>
          <div data-roi-desk-heatmap-wrap class="hidden">
            <RoiDeskHeatmap />
          </div>
          <div data-roi-demo-wrap class="hidden">
            <RoiDemoPanel />
          </div>
          <div data-roi-email-slot-right></div>
          {showEmailGate && <EmailUnlockPanel />}
          {salesCtaLabel && salesCtaHref && (
            <div class="pt-2 border-t border-stone-100">
              <Button href={salesCtaHref} variant="secondary" size="sm" class="w-full sm:w-auto">
                {salesCtaLabel}
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M4 10L10 4M10 4H5M10 4V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </Button>
            </div>
          )}
        </div>
      </div>

      <RoiDisqualifyDialog />
    </div>
  </div>
</section>

<style>
  .roi-tab.is-active {
    background: var(--color-navy-500);
    color: white;
  }
  .roi-tab:not(.is-active) {
    color: var(--color-navy-500);
  }
  .roi-tab:not(.is-active):hover {
    background: var(--color-stone-100);
  }

  .roi-range {
    height: 0.5rem;
    cursor: pointer;
  }
  .roi-range-hero {
    height: 0.65rem;
  }

</style>

<script>
  import "./roi-calculator.ts";
</script>
