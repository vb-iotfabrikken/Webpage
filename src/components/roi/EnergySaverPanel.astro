---
import { DEFAULTS, ENERGY_LIMITS } from "../../lib/roi/constants";
import RoiCurrencySwitcher from "./RoiCurrencySwitcher.astro";

const { minTemp, maxTemp, defaultTemp, minSqm, maxSqm, defaultSqm } = ENERGY_LIMITS;
const defaultBill = DEFAULTS.EUR.heatingBill;
---

<div data-roi-panel="energy" class="hidden space-y-6">
  <div class="space-y-3">
    <RoiCurrencySwitcher />
    <div>
      <label for="roi-heating-bill" class="text-sm font-medium text-navy-500">
        Estimated annual heating bill
      </label>
      <div class="mt-2 flex items-center gap-2">
        <span class="text-sm text-stone-300 shrink-0" data-roi-currency-symbol-energy>€</span>
        <input
          id="roi-heating-bill"
          type="number"
          min={0}
          step={1000}
          value={defaultBill}
          class="w-full max-w-xs rounded-md border border-stone-100 px-3 py-2.5 text-[15px] focus:outline-none focus:ring-2 focus:ring-sky-500"
          data-roi-heating-bill
        />
      </div>
      <button
        type="button"
        class="mt-2 text-xs text-sky-600 hover:text-coral-500 font-medium underline-offset-2 hover:underline"
        data-roi-heating-estimate-toggle
      >
        I don't know my heating bill
      </button>
      <div class="hidden mt-3 space-y-2 rounded-lg border border-stone-100 bg-stone-50/50 p-4" data-roi-heating-estimate>
        <label for="roi-sqm" class="text-xs font-medium text-navy-500">Office floor area (m²)</label>
        <input
          id="roi-sqm"
          type="number"
          min={minSqm}
          max={maxSqm}
          step={50}
          value={defaultSqm}
          class="w-full max-w-xs rounded-md border border-stone-100 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500"
          data-roi-sqm
        />
        <p class="text-xs text-stone-300">
          We estimate your bill from typical Nordic office heating costs per m².
        </p>
      </div>
    </div>
  </div>

  <div class="space-y-3">
    <div class="roi-toggle-row">
      <div class="roi-toggle-row-text">
        <span class="text-sm font-medium text-navy-500">Heat the office on weekends?</span>
        <span class="roi-toggle-hint hidden" data-roi-badge-weekend>Weekend heating off</span>
      </div>
      <div class="roi-toggle" data-roi-toggle="weekend" data-roi-toggle-on="true" role="group" aria-label="Weekend heating">
        <button type="button" class="roi-toggle-btn is-active" data-roi-toggle-value="true" aria-pressed="true">Yes</button>
        <button type="button" class="roi-toggle-btn" data-roi-toggle-value="false" aria-pressed="false">No</button>
      </div>
    </div>

    <div class="roi-toggle-row">
      <div class="roi-toggle-row-text">
        <span class="text-sm font-medium text-navy-500">Heating on outside working hours?</span>
        <span class="roi-toggle-hint hidden" data-roi-badge-nightly>Night setback on</span>
      </div>
      <div class="roi-toggle" data-roi-toggle="nightly" data-roi-toggle-on="true" role="group" aria-label="Nightly heating">
        <button type="button" class="roi-toggle-btn is-active" data-roi-toggle-value="true" aria-pressed="true">Yes</button>
        <button type="button" class="roi-toggle-btn" data-roi-toggle-value="false" aria-pressed="false">No</button>
      </div>
    </div>
  </div>

  <div class="rounded-xl border-2 border-sky-500/15 bg-sky-50/50 p-5">
    <div class="flex items-baseline justify-between gap-4 mb-2">
      <label for="roi-temp" class="text-sm font-semibold text-navy-500">
        Average office temperature
      </label>
      <span class="text-2xl font-bold text-sky-600 tabular-nums" data-roi-temp-display>
        {defaultTemp}°C
      </span>
    </div>
    <p class="text-xs text-stone-900/60 mb-3">
      Each degree toward 20°C can save ~5% on heating (ENS.dk guideline).
    </p>
    <input
      id="roi-temp"
      type="range"
      min={minTemp}
      max={maxTemp}
      step={0.5}
      value={defaultTemp}
      class="roi-range roi-range-hero w-full accent-sky-500"
      data-roi-temp-range
      aria-valuemin={minTemp}
      aria-valuemax={maxTemp}
      aria-valuenow={defaultTemp}
    />
    <div class="flex justify-between mt-1.5 text-xs font-medium text-stone-300 tabular-nums">
      <span>{minTemp}°C</span>
      <span>{maxTemp}°C</span>
    </div>
  </div>
</div>

<style>
  .roi-toggle-row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    column-gap: 1rem;
    row-gap: 0.25rem;
  }

  .roi-toggle-row-text {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
  }

  .roi-toggle-hint {
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--color-forest-500);
    line-height: 1.3;
  }

  .roi-toggle {
    display: inline-flex;
    flex-shrink: 0;
    padding: 4px;
    gap: 2px;
    border-radius: 0.375rem;
    background: var(--color-stone-50);
    border: 1px solid var(--color-stone-100);
  }

  .roi-toggle-btn {
    min-width: 2.75rem;
    padding: 0.375rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.2;
    border-radius: 0.375rem;
    border: 1px solid transparent;
    color: var(--color-navy-500);
    background: transparent;
    cursor: pointer;
    transition:
      background 180ms ease,
      color 180ms ease,
      border-color 180ms ease;
  }

  .roi-toggle-btn:hover:not(.is-active) {
    background: var(--color-stone-100);
  }

  .roi-toggle-btn[data-roi-toggle-value="true"].is-active {
    background: var(--color-navy-500);
    border-color: var(--color-navy-500);
    color: white;
  }

  .roi-toggle-btn[data-roi-toggle-value="false"].is-active {
    background: var(--color-forest-500);
    border-color: var(--color-forest-500);
    color: white;
  }

</style>
