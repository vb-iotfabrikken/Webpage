---
/**
 * Modal shown when the prospect's inputs disqualify them from a full sensor
 * rollout (subscription >= savings). Captures lightweight contact info so
 * sales can propose a smaller bespoke solution. Logic lives in
 * `roi-calculator.ts`; this file is markup + scoped styles only.
 */
import FormFieldError from "../FormFieldError.astro";
import { astroLang, langPath } from "../../data/lang";

const lang = astroLang(Astro);
const privacyHref = langPath("legal/privacy", lang);
---

<dialog class="roi-disqualify-dialog" data-roi-disqualify-dialog>
  <form
    method="dialog"
    class="roi-disqualify-form space-y-4 relative"
    data-roi-disqualify-form
    novalidate
  >
    <div class="roi-honeypot" aria-hidden="true">
      <input
        type="search"
        name="company_fax"
        tabindex="-1"
        autocomplete="nope"
        inputmode="none"
        data-roi-disqualify-honeypot
      />
    </div>
    <button
      type="button"
      class="roi-disqualify-close"
      aria-label="Close"
      data-roi-disqualify-close
    >
      ×
    </button>

    <div data-roi-disqualify-content>
      <p class="text-xs font-semibold uppercase tracking-wider text-coral-600 mb-2">
        Custom solution recommended
      </p>
      <h3 class="text-xl md:text-2xl font-bold text-navy-500 leading-snug mb-3">
        Your footprint may already be lean.
      </h3>
      <p class="text-sm text-stone-900/80 leading-relaxed mb-4">
        Based on your inputs, your footprint may be too streamlined to see
        massive ROI from a full sensor rollout. Let's talk about a custom,
        lightweight solution that fits your actual setup.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <label class="block">
          <span class="text-xs font-medium text-stone-300">First name</span>
          <FormFieldError field="firstName" />
          <input
            type="text"
            name="firstName"
            aria-required="true"
            autocomplete="given-name"
            class="mt-1 w-full rounded-md border border-stone-100 bg-white px-3 py-2.5 text-[15px] focus:outline-none focus:ring-2 focus:ring-coral-500 focus:border-coral-500"
            data-roi-disqualify-first-name
          />
        </label>
        <label class="block">
          <span class="text-xs font-medium text-stone-300">Last name</span>
          <FormFieldError field="lastName" />
          <input
            type="text"
            name="lastName"
            aria-required="true"
            autocomplete="family-name"
            class="mt-1 w-full rounded-md border border-stone-100 bg-white px-3 py-2.5 text-[15px] focus:outline-none focus:ring-2 focus:ring-coral-500 focus:border-coral-500"
            data-roi-disqualify-last-name
          />
        </label>
      </div>
      <label class="block mt-3">
        <span class="text-xs font-medium text-stone-300">Work email</span>
        <FormFieldError field="email" />
        <input
          type="email"
          name="email"
          aria-required="true"
          autocomplete="work email"
          class="mt-1 w-full rounded-md border border-stone-100 bg-white px-3 py-2.5 text-[15px] focus:outline-none focus:ring-2 focus:ring-coral-500 focus:border-coral-500"
          data-roi-disqualify-email
        />
      </label>
      <label class="block mt-3">
        <span class="text-xs font-medium text-stone-300">Phone</span>
        <FormFieldError field="phone" />
        <input
          type="tel"
          name="phone"
          aria-required="true"
          autocomplete="tel"
          placeholder="+45 12 34 56 78"
          class="mt-1 w-full rounded-md border border-stone-100 bg-white px-3 py-2.5 text-[15px] focus:outline-none focus:ring-2 focus:ring-coral-500 focus:border-coral-500"
          data-roi-disqualify-phone
        />
      </label>

      <p
        class="mt-3 text-xs text-coral-600 hidden"
        role="alert"
        data-roi-disqualify-error
      >
        Please complete all fields with a valid work email and phone.
      </p>

      <button
        type="submit"
        class="mt-4 w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 text-sm font-semibold rounded-md bg-coral-500 text-white hover:bg-coral-600 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-coral-500 focus-visible:ring-offset-2"
      >
        Have sales contact me
      </button>
      <p class="mt-2 text-xs text-stone-300 leading-relaxed">
        By submitting you accept our
        <a href={privacyHref} class="underline hover:text-coral-500">privacy policy</a>.
      </p>
    </div>

    <div class="hidden" data-roi-disqualify-success>
      <p class="text-xs font-semibold uppercase tracking-wider text-forest-500 mb-2">
        Got it
      </p>
      <h3 class="text-xl md:text-2xl font-bold text-navy-500 leading-snug mb-3">
        Sales will be in touch with a custom solution.
      </h3>
      <p class="text-sm text-stone-900/80 leading-relaxed">
        Thanks — we'll review your inputs and reach out within one business day
        with a tailored, lightweight setup that fits your numbers.
      </p>
      <button
        type="button"
        class="mt-4 inline-flex items-center justify-center gap-2 px-4 py-2 text-sm font-medium rounded-md text-stone-300 hover:text-navy-500 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-navy-500 focus-visible:ring-offset-2"
        data-roi-disqualify-close
      >
        Close
      </button>
    </div>
  </form>
</dialog>

<style>
  /* Native <dialog> styling — Astro scopes these to this component only. */
  .roi-disqualify-dialog {
    border: 0;
    padding: 0;
    border-radius: 0.75rem;
    width: 100%;
    max-width: 32rem;
    background: white;
    box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.25);
  }

  .roi-disqualify-dialog::backdrop {
    background: rgba(13, 61, 84, 0.65);
    backdrop-filter: blur(2px);
  }

  .roi-disqualify-form {
    position: relative;
    padding: 1.75rem 1.75rem 1.5rem;
  }

  .roi-disqualify-close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    width: 2rem;
    height: 2rem;
    line-height: 1;
    font-size: 1.5rem;
    color: var(--color-stone-300);
    background: transparent;
    border: 0;
    border-radius: 0.375rem;
    cursor: pointer;
  }

  .roi-disqualify-close:hover {
    color: var(--color-navy-500);
    background: var(--color-stone-100);
  }

  .roi-honeypot {
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
    opacity: 0;
    pointer-events: none;
  }

  .roi-honeypot-label,
  .roi-honeypot input {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }
</style>
