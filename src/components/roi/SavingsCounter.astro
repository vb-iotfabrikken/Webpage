---
import Button from "../Button.astro";

interface Props {
  accent?: "navy" | "sky";
  salesCtaLabel?: string;
  salesCtaHref?: string;
}

const { accent = "navy", salesCtaLabel, salesCtaHref } = Astro.props;
const accentClass = accent === "sky" ? "text-sky-600" : "text-navy-500";
---

<div
  class="roi-savings-counter bg-white border border-stone-100 rounded-xl p-6 md:p-8 shadow-sm"
  data-roi-savings-counter
  data-roi-counter
>
  <p class="text-xs font-semibold uppercase tracking-wider text-stone-300 mb-2">
    Potential annual savings
  </p>
  <p
    class={`text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight tabular-nums ${accentClass}`}
    data-roi-counter-value
    aria-live="polite"
    aria-atomic="true"
  >
    —
  </p>
  <p class="mt-3 text-sm text-stone-900/70 leading-relaxed" data-roi-counter-teaser>
    Adjust the sliders to see your estimate.
  </p>
  <p
    class="mt-2 text-xs text-stone-300 leading-relaxed hidden"
    data-roi-counter-cap-note
  >
    Savings capped at 80% of your heating bill for this illustrative estimate.
  </p>
  <p class="mt-4 text-xs text-stone-300 leading-relaxed">
    Illustrative estimate based on industry rules of thumb — not a formal audit.
  </p>
  {salesCtaLabel && salesCtaHref && (
    <div class="mt-6 pt-6 border-t border-stone-100">
      <Button href={salesCtaHref} variant="primary" size="md" class="w-full sm:w-auto">
        {salesCtaLabel}
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M4 10L10 4M10 4H5M10 4V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </Button>
    </div>
  )}
</div>
