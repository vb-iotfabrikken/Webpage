---
import Button from "../Button.astro";
import { astroLang, langPath } from "../../data/lang";

const lang = astroLang(Astro);
const privacyHref = langPath("legal/privacy", lang);
---

<div data-roi-email-panel>
  <div data-roi-email-gate>
    <p class="text-sm font-medium text-navy-500 mb-2">
      Get your full ROI report
    </p>
    <p class="text-xs text-stone-300 mb-3 leading-relaxed">
      PDF includes break-even, hardware, savings breakdown, and sensor recommendations.
    </p>
    <form class="space-y-3 relative" data-roi-email-form novalidate>
      <div class="roi-honeypot" aria-hidden="true">
        <label for="roi-website" class="roi-honeypot-label">Website</label>
        <input
          type="text"
          id="roi-website"
          name="website"
          tabindex="-1"
          autocomplete="off"
          data-roi-honeypot
        />
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <label class="block">
          <span class="text-xs font-medium text-stone-300">First name</span>
          <input
            type="text"
            name="firstName"
            required
            autocomplete="given-name"
            placeholder="Jane"
            class="mt-1 w-full rounded-md border border-stone-100 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-coral-500 focus:border-coral-500"
            data-roi-first-name-input
          />
        </label>
        <label class="block">
          <span class="text-xs font-medium text-stone-300">Last name</span>
          <input
            type="text"
            name="lastName"
            required
            autocomplete="family-name"
            placeholder="Smith"
            class="mt-1 w-full rounded-md border border-stone-100 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-coral-500 focus:border-coral-500"
            data-roi-last-name-input
          />
        </label>
      </div>
      <label class="block">
        <span class="text-xs font-medium text-stone-300">Work email</span>
        <input
          type="email"
          name="email"
          required
          autocomplete="work email"
          placeholder="you@company.com"
          class="mt-1 w-full rounded-md border border-stone-100 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-coral-500 focus:border-coral-500"
          data-roi-email-input
        />
      </label>
      <label class="block">
        <span class="text-xs font-medium text-stone-300">Phone (optional)</span>
        <input
          type="tel"
          name="phone"
          autocomplete="tel"
          placeholder="+45 12 34 56 78"
          class="mt-1 w-full rounded-md border border-stone-100 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-coral-500 focus:border-coral-500"
          data-roi-phone-input
        />
      </label>
      <p class="text-xs text-coral-600 hidden" data-roi-email-error role="alert"></p>
      <Button type="submit" variant="primary" size="md" class="w-full sm:w-auto">
        Email me my full report
      </Button>
      <p class="text-xs text-stone-300 leading-relaxed">
        By submitting you accept our
        <a href={privacyHref} class="underline hover:text-coral-500">privacy policy</a>.
        Use your company email — personal addresses are not accepted.
      </p>
    </form>
  </div>

  <div class="hidden rounded-lg border border-forest-500/20 bg-forest-500/5 p-4" data-roi-email-success>
    <p class="text-sm font-semibold text-forest-500">Your report is ready</p>
    <p class="mt-1 text-xs text-stone-900/70 leading-relaxed">
      The PDF should download automatically. It includes your full savings breakdown,
      investment summary, and sensor recommendations.
    </p>
    <button
      type="button"
      class="mt-3 inline-flex items-center text-xs font-medium text-stone-300 hover:text-navy-500 transition-colors focus:outline-none focus:ring-2 focus:ring-navy-500 focus:ring-offset-2 rounded-md"
      data-roi-adjust-inputs
    >
      Adjust inputs
    </button>
  </div>
</div>

<style>
  .roi-honeypot {
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
    opacity: 0;
    pointer-events: none;
  }

  .roi-honeypot-label,
  .roi-honeypot input {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }
</style>

<style is:global>
  [data-roi-email-panel].roi-email-inline {
    margin-top: 0;
  }

  [data-roi-email-panel].roi-email-paywall {
    position: relative;
    z-index: 2;
    margin-top: -5.5rem;
    padding: 1rem 1.25rem;
    background: white;
    border: 1px solid var(--color-stone-100);
    border-radius: 0.75rem;
    box-shadow: 0 8px 24px rgb(15 23 42 / 0.08);
  }

  @media (min-width: 768px) {
    [data-roi-email-panel].roi-email-paywall {
      margin-top: -6.5rem;
    }
  }

  [data-roi-email-panel] .roi-field-error {
    border-color: var(--color-coral-500) !important;
    box-shadow: 0 0 0 1px var(--color-coral-500);
  }
</style>
