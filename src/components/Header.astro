</header>

<style>
  /* Shared grid so the utility-bar language switch lines up with the
     main header actions column (Book a demo right edge). */
  .site-header-bar {
    display: grid;
    align-items: center;
    column-gap: 1rem;
    width: 100%;
  }

  .site-header-bar--utility {
    height: 2rem;
    grid-template-columns: minmax(0, 1fr) auto;
  }

  @media (min-width: 1024px) {
    .site-header-bar--utility {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }

    .site-header-utility-message {
      grid-column: 2;
    }

    .site-header-bar--utility .site-header-actions {
      grid-column: 3;
    }
  }

  .site-header-bar--main {
    --header-control-height: 2.5rem;
    --header-logo-height: 3rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 4rem;
    min-width: 0;
    overflow: visible;
  }

  @media (min-width: 768px) {
    .site-header-bar--main {
      gap: 1rem;
      height: 5rem;
    }
  }

  .site-header-brand {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    flex-shrink: 0;
    height: var(--header-logo-height, 3rem);
  }

  .site-header-bar--main .site-header-logo {
    display: block;
    height: var(--header-logo-height);
    width: auto;
    object-fit: contain;
  }

  .site-header-menu {
    overflow: visible;
  }

  @media (min-width: 960px) {
    .site-header-menu {
      flex: 1 1 auto;
      min-width: 0;
    }
  }

  /* All dropdowns: left edge of panel aligns with left edge of nav item, opens to the right. */
  .nav-dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    right: auto;
    z-index: 60;
    padding-top: 0.75rem;
    max-width: calc(100vw - 2rem);
  }

  /* Industries mega menu: 2×2 grid on narrower desktops (e.g. half-screen). */
  @media (max-width: 1399px) {
    .nav-dropdown--industries {
      width: min(42rem, calc(100vw - 2rem));
    }

    .nav-dropdown--industries .nav-dropdown__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .site-header-menu > .group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    height: var(--header-control-height);
  }

  .site-header-menu > .nav-link {
    flex-shrink: 0;
  }

  .site-header-utility-message {
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    min-width: 0;
    font-size: 12px;
  }

  /* Utility-bar links (Helpcenter, Log in) — light on navy, with thin dividers. */
  .utility-link {
    align-items: center;
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    color: rgb(255 255 255 / 0.85);
    white-space: nowrap;
    transition: color 180ms ease;
  }

  .utility-link:hover {
    color: var(--color-coral-50);
  }

  .utility-divider {
    width: 1px;
    height: 0.875rem;
    margin-inline: 0.625rem;
    background-color: rgb(255 255 255 / 0.2);
  }

  .site-header-actions {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: flex-end;
    margin-left: auto;
    /* Pull toward the right edge, but never past the page gutter so the
       controls don't get clipped by `html { overflow-x: clip }` when the
       window is narrow. The full shift only applies once the centred
       container has empty side margins to absorb it (>= 1280px). */
    margin-right: -1.5rem;
    padding-left: 0.5rem;
  }

  @media (min-width: 1280px) {
    .site-header-actions {
      margin-right: -4rem;
    }
  }

  /* Tighter nav padding on narrower desktops; login matches nav label size. */
  @media (min-width: 960px) and (max-width: 1279px) {
    .site-header-bar--main .site-header-menu .nav-link,
    .site-header-bar--main .site-header-actions .nav-link {
      padding-inline: 0.5rem;
      font-size: 14px;
    }
  }

  /* da/de labels run longer — squeeze a bit more before the tail link yields. */
  @media (min-width: 960px) and (max-width: 1399px) {
    #site-header[data-lang="da"] .site-header-bar--main .site-header-menu .nav-link,
    #site-header[data-lang="da"] .site-header-bar--main .site-header-actions .nav-link,
    #site-header[data-lang="de"] .site-header-bar--main .site-header-menu .nav-link,
    #site-header[data-lang="de"] .site-header-bar--main .site-header-actions .nav-link {
      padding-inline: 0.375rem;
    }

    #site-header[data-lang="da"] :global(.site-header-demo-btn),
    #site-header[data-lang="de"] :global(.site-header-demo-btn) {
      padding-inline: 0.75rem;
      font-size: 13px;
    }
  }

  /* Nav links with a coral underline that slides in on hover and stays
     pinned under the active page. Warmer and more alive than a plain
     color swap. */
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    font-size: 15px;
    font-weight: 500;
    line-height: 1;
    color: var(--color-navy-500);
    border-radius: 0.375rem;
    background: transparent;
    transition: color 180ms ease;
    white-space: nowrap;
    cursor: pointer;
  }

  /* Main header: keep nav labels and Log in on one shared vertical center line. */
  .site-header-bar--main .nav-link {
    min-height: var(--header-control-height);
    box-sizing: border-box;
  }

  .site-header-actions > div {
    align-items: center;
    min-height: var(--header-control-height);
  }

  .site-header-actions .mx-2.h-5 {
    align-self: center;
    height: 1.25rem;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 2px;
    height: 2px;
    background-color: var(--color-coral-500);
    border-radius: 2px;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 220ms ease;
    pointer-events: none;
  }

  .nav-link:hover,
  .nav-link[data-active="true"] {
    color: var(--color-coral-500);
  }

  .nav-link:hover::after,
  .nav-link[data-active="true"]::after {
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link,
    .nav-link::after {
      transition: none;
    }
  }

  /* Mobile / narrow header: menu scrolls inside the space below the header bars. */
  @media (max-width: 959px) {
    .mobile-menu-panel:not(.hidden) {
      overflow-y: auto;
      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
    }
  }
</style>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("menu-icon-open");
  const iconClose = document.getElementById("menu-icon-close");

  /** Fit mobile menu in the viewport below the header bars so expanded sections scroll. */
  function updateMobileMenuHeight() {
    if (!menu || menu.classList.contains("hidden")) return;
    const top = menu.getBoundingClientRect().top;
    menu.style.maxHeight = `calc(100dvh - ${top}px)`;
  }

  function clearMobileMenuHeight() {
    if (menu) menu.style.maxHeight = "";
  }

  toggle?.addEventListener("click", () => {
    const isHidden = menu?.classList.contains("hidden");
    menu?.classList.toggle("hidden");
    iconOpen?.classList.toggle("hidden");
    iconClose?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", isHidden ? "true" : "false");
    if (isHidden) {
      requestAnimationFrame(updateMobileMenuHeight);
    } else {
      clearMobileMenuHeight();
    }
  });

  window.addEventListener("resize", updateMobileMenuHeight);

  menu?.querySelectorAll("details").forEach((details) => {
    details.addEventListener("toggle", () => {
      if (!menu.classList.contains("hidden")) {
        requestAnimationFrame(updateMobileMenuHeight);
      }
    });
  });

  /** Industries only: nudge left when the panel would clip on the right (half-screen). */
  const industriesGroup = document.querySelector("[data-nav-industries]");
  const industriesPanel = industriesGroup?.querySelector<HTMLElement>(
    ".nav-dropdown--industries",
  );

  function fitIndustriesDropdown() {
    if (!industriesPanel) return;
    industriesPanel.style.left = "0";
    requestAnimationFrame(() => {
      const rect = industriesPanel.getBoundingClientRect();
      const gap = 16;
      const vw = document.documentElement.clientWidth;
      if (rect.right > vw - gap) {
        industriesPanel.style.left = `${-(rect.right - (vw - gap))}px`;
      }
    });
  }

  function resetIndustriesDropdown() {
    if (industriesPanel) industriesPanel.style.left = "";
  }

  if (industriesGroup && industriesPanel) {
    industriesGroup.addEventListener("mouseenter", fitIndustriesDropdown);
    industriesGroup.addEventListener("mouseleave", resetIndustriesDropdown);
    industriesGroup.addEventListener("focusin", fitIndustriesDropdown);
    industriesGroup.addEventListener("focusout", (event) => {
      if (
        !industriesGroup.contains(
          (event as FocusEvent).relatedTarget as Node | null,
        )
      ) {
        resetIndustriesDropdown();
      }
    });
    window.addEventListener("resize", () => {
      if (industriesGroup.matches(":hover")) fitIndustriesDropdown();
    });
  }
</script>
