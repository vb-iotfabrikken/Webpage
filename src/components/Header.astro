---
import Button from "./Button.astro";
import ModuleIcon from "./ModuleIcon.astro";
import IndustryIcon from "./IndustryIcon.astro";
import { modules } from "../data/modules";
import {
  platformHub,
  sensorsHub,
  industriesHub,
} from "../data/site";
import { externalLinks } from "../data/externalLinks";

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);

// "Product" dropdown spans Platform, Modules and Sensors.
const productActive =
  isActive("/en/platform") ||
  isActive("/en/modules") ||
  isActive("/en/sensors") ||
  isActive("/en/integrations");

// "Industries" dropdown spans Industries and the decision-making tools
// (Compare, ROI, Pricing, Case studies, White papers).
const industriesActive =
  isActive("/en/industries") ||
  isActive("/en/compare") ||
  isActive("/en/roi") ||
  isActive("/en/case-studies") ||
  isActive("/en/whitepapers");

// Product dropdown — three columns, one per product surface. The
// Platform column now also surfaces Security, API and Integrations
// (previously a separate bottom bar) so everything Platform-adjacent
// lives in one place.
const platformCoreSlugs = [
  "how-it-works",
  "architecture",
  "dashboards",
  "reports",
  "maps-floorplans",
  "mobile-tv",
];
const platformCore = platformCoreSlugs
  .map((slug) => platformHub.leaves.find((l) => l.slug === slug))
  .filter((l): l is (typeof platformHub.leaves)[number] => Boolean(l))
  .map((l) => ({
    label: l.title.replace(/\.$/, ""),
    href: `/en/platform/${l.slug}/`,
  }));
const platformExtras = [
  { label: "Security", href: "/en/platform/security/" },
  { label: "API", href: "/en/platform/api/" },
  { label: "Integrations", href: "/en/integrations/" },
];

// A curated slice of the sensor catalogue for the header. The full list
// lives on the sensors hub page.
const sensorFeaturedSlugs = [
  "full",
  "mini",
  "full-plus-pir",
  "humidity",
  "water-detector",
  "gateway",
];
const sensorFeatured = sensorFeaturedSlugs
  .map((slug) => sensorsHub.leaves.find((l) => l.slug === slug))
  .filter((l): l is (typeof sensorsHub.leaves)[number] => Boolean(l))
  .map((l) => ({
    label: l.title.replace(/\.$/, ""),
    href: `/en/sensors/${l.slug}/`,
  }));

// Industries dropdown — split the full list across two columns so all
// sectors fit without scrolling. Each entry keeps its slug so the
// header can pair it with an IndustryIcon.
const industriesAll = industriesHub.leaves.map((l) => ({
  slug: l.slug,
  label: l.title.replace(/\.$/, ""),
  href: `/en/industries/${l.slug}/`,
}));
const industriesHalf = Math.ceil(industriesAll.length / 2);
const industriesColA = industriesAll.slice(0, industriesHalf);
const industriesColB = industriesAll.slice(industriesHalf);

// "Evaluate" is deliberately narrow: only things that help a prospect
// work out whether RoomAlyzer is the right fit. Product catalogue
// links (Sensors, Integrations) live in the Product dropdown instead.
const evaluateTools = [
  { label: "Compare sensors", href: "/en/compare/" },
  { label: "ROI calculator", href: "/en/roi/calculator/" },
  { label: "Pricing", href: "/en/pricing/" },
];
const evaluateProof = [
  { label: "Case studies", href: "/en/case-studies/" },
  { label: "White papers", href: "/en/whitepapers/" },
];
---

<header id="site-header" class="sticky top-0 z-50">
  <!-- Top utility bar — a warm, human-sounding status line. -->
  <div class="hidden md:block bg-navy-500 text-white">
    <div class="container-page flex items-center justify-center gap-3 h-8 text-[12px]">
      <span class="relative inline-flex w-2 h-2" aria-hidden="true">
        <span class="absolute inline-flex h-full w-full rounded-full bg-forest-50 opacity-75 animate-ping"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-forest-50"></span>
      </span>
      <span class="text-white/85">
        Built in Denmark — real humans at the other end.
      </span>
      <span class="text-white/25 select-none" aria-hidden="true">·</span>
      <a
        href="/en/contact/"
        class="font-semibold text-white hover:text-coral-50 transition-colors underline-offset-4 hover:underline decoration-coral-500 decoration-2"
      >
        Talk to us →
      </a>
    </div>
  </div>

  <!-- Main header bar -->
  <div class="bg-white/95 backdrop-blur border-b border-stone-100">
    <div class="container-page flex items-center justify-between h-16 md:h-20">
      <a href="/en/" class="flex items-center gap-3 group" aria-label="IoT Fabrikken home">
        <img
          src="/logo.png"
          alt="IoT Fabrikken"
          class="h-8 md:h-9 w-auto transition-transform duration-300 ease-out group-hover:-rotate-3 group-hover:scale-[1.03]"
        />
      </a>

      <nav class="relative hidden lg:flex items-center gap-1" aria-label="Primary navigation">
        <!-- Products dropdown: Platform · Modules · Sensors -->
        <div class="group">
          <button
            type="button"
            class="nav-link"
            data-active={productActive}
            aria-haspopup="true"
          >
            Products
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" class="ml-1 transition-transform duration-200 group-hover:rotate-180">
              <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <div class="invisible opacity-0 translate-y-1 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 absolute left-0 top-full pt-3 w-[min(820px,calc(100vw-2rem))]">
            <div class="bg-white rounded-xl shadow-xl border border-stone-100 p-4">
              <div class="grid grid-cols-3 gap-5">
                <!-- Platform -->
                <div>
                  <a
                    href="/en/platform/"
                    class="block text-xs font-semibold uppercase tracking-wider text-stone-300 mb-2 hover:text-coral-500 transition-colors"
                  >
                    Platform
                  </a>
                  <ul>
                    {platformCore.map((f) => (
                      <li>
                        <a
                          href={f.href}
                          class="block py-1 text-[13.5px] text-navy-500 hover:text-coral-500 transition-colors"
                        >
                          {f.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                  <div class="my-1.5 border-t border-stone-100"></div>
                  <ul>
                    {platformExtras.map((f) => (
                      <li>
                        <a
                          href={f.href}
                          class="block py-1 text-[13.5px] text-navy-500 hover:text-coral-500 transition-colors"
                        >
                          {f.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>

                <!-- Modules -->
                <div>
                  <a
                    href="/en/modules/"
                    class="block text-xs font-semibold uppercase tracking-wider text-stone-300 mb-2 hover:text-coral-500 transition-colors"
                  >
                    Modules
                  </a>
                  <ul>
                    {modules.map((m) => (
                      <li>
                        <a
                          href={m.href}
                          class="flex items-center gap-2 py-0.5 text-[13.5px] text-navy-500 hover:text-coral-500 transition-colors"
                        >
                          <span class="shrink-0 inline-flex items-center justify-center w-6 h-6 rounded bg-stone-50 text-navy-500">
                            <ModuleIcon slug={m.slug} class="w-4 h-4" />
                          </span>
                          {m.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>

                <!-- Sensors -->
                <div>
                  <a
                    href="/en/sensors/"
                    class="block text-xs font-semibold uppercase tracking-wider text-stone-300 mb-2 hover:text-coral-500 transition-colors"
                  >
                    Sensors
                  </a>
                  <ul>
                    {sensorFeatured.map((f) => (
                      <li>
                        <a
                          href={f.href}
                          class="block py-1 text-[13.5px] text-navy-500 hover:text-coral-500 transition-colors"
                        >
                          {f.label}
                        </a>
                      </li>
                    ))}
                    <li>
                      <a
                        href="/en/sensors/"
                        class="block py-1 text-[12.5px] font-medium text-coral-500 hover:text-coral-500/80 transition-colors"
                      >
                        All sensors →
                      </a>
                    </li>
                  </ul>
                </div>
              </div>

            </div>
          </div>
        </div>

        <!-- Industries dropdown: Industries list + Evaluate tools -->
        <div class="group">
          <button
            type="button"
            class="nav-link"
            data-active={industriesActive}
            aria-haspopup="true"
          >
            Industries
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" class="ml-1 transition-transform duration-200 group-hover:rotate-180">
              <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <div class="invisible opacity-0 translate-y-1 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 absolute left-0 top-full pt-3 w-[min(820px,calc(100vw-2rem))]">
            <div class="bg-white rounded-xl shadow-xl border border-stone-100 p-4">
              <div class="grid grid-cols-3 gap-5">
                <!-- Industries, column A -->
                <div>
                  <a
                    href="/en/industries/"
                    class="block text-xs font-semibold uppercase tracking-wider text-stone-300 mb-2 hover:text-coral-500 transition-colors"
                  >
                    Industries
                  </a>
                  <ul>
                    {industriesColA.map((f) => (
                      <li>
                        <a
                          href={f.href}
                          class="flex items-center gap-2 py-0.5 text-[13.5px] text-navy-500 hover:text-coral-500 transition-colors"
                        >
                          <span class="shrink-0 inline-flex items-center justify-center w-6 h-6 rounded bg-coral-50 text-coral-500">
                            <IndustryIcon slug={f.slug} class="w-4 h-4" />
                          </span>
                          {f.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>

                <!-- Industries, column B (no heading — visually a continuation) -->
                <div>
                  <span class="block text-xs font-semibold uppercase tracking-wider text-transparent select-none mb-2" aria-hidden="true">
                    &nbsp;
                  </span>
                  <ul>
                    {industriesColB.map((f) => (
                      <li>
                        <a
                          href={f.href}
                          class="flex items-center gap-2 py-0.5 text-[13.5px] text-navy-500 hover:text-coral-500 transition-colors"
                        >
                          <span class="shrink-0 inline-flex items-center justify-center w-6 h-6 rounded bg-coral-50 text-coral-500">
                            <IndustryIcon slug={f.slug} class="w-4 h-4" />
                          </span>
                          {f.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>

                <!-- Evaluate — grouped under two intent-specific sub-headings
                     so it no longer reads as a random pile of links. -->
                <div class="border-l border-stone-100 pl-5">
                  <span class="block text-xs font-semibold uppercase tracking-wider text-stone-300 mb-2">
                    Evaluate
                  </span>

                  <span class="block text-[11px] font-semibold uppercase tracking-wider text-coral-500 mb-0.5">
                    Tools
                  </span>
                  <ul class="mb-2">
                    {evaluateTools.map((f) => (
                      <li>
                        <a
                          href={f.href}
                          class="block py-1 text-[13.5px] text-navy-500 hover:text-coral-500 transition-colors"
                        >
                          {f.label}
                        </a>
                      </li>
                    ))}
                  </ul>

                  <span class="block text-[11px] font-semibold uppercase tracking-wider text-coral-500 mb-0.5">
                    Proof
                  </span>
                  <ul>
                    {evaluateProof.map((f) => (
                      <li>
                        <a
                          href={f.href}
                          class="block py-1 text-[13.5px] text-navy-500 hover:text-coral-500 transition-colors"
                        >
                          {f.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <a
                href="/en/library/"
                class="mt-3 flex items-center justify-between p-2.5 rounded-lg bg-stone-50 hover:bg-stone-100 transition-colors group/all"
              >
                <span class="text-[13.5px] font-semibold text-navy-500 group-hover/all:text-coral-500">
                  Browse the whole library of articles and use cases
                </span>
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="text-navy-500 group-hover/all:text-coral-500 group-hover/all:translate-x-0.5 transition-all">
                  <path d="M3 7h8M7.5 3.5L11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </div>
          </div>
        </div>

        <a href="/en/pricing/" class="nav-link" data-active={isActive("/en/pricing")}>Pricing</a>
        <a href="/en/library/" class="nav-link" data-active={isActive("/en/library")}>Library</a>
        <a href="/en/contact/" class="nav-link" data-active={isActive("/en/contact")}>Contact</a>
        <a
          href={externalLinks.support}
          target="_blank"
          rel="noopener noreferrer"
          class="nav-link"
        >
          Help
        </a>
      </nav>

      <div class="hidden lg:flex items-center gap-1">
        <a
          href={externalLinks.login}
          target="_blank"
          rel="noopener noreferrer"
          class="nav-link"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="mr-1.5"
            aria-hidden="true"
          >
            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
            <polyline points="10 17 15 12 10 7" />
            <line x1="15" y1="12" x2="3" y2="12" />
          </svg>
          Log in
        </a>
        <span class="mx-2 h-5 w-px bg-stone-100" aria-hidden="true"></span>
        <Button href="/en/contact/book-demo/" variant="primary" size="sm">
          Book a demo
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M3 7h8M7.5 3.5L11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </Button>
      </div>

      <button
        id="mobile-menu-toggle"
        type="button"
        class="lg:hidden inline-flex items-center justify-center w-10 h-10 text-navy-500"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="menu-icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none">
          <path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <svg id="menu-icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" class="hidden">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="lg:hidden hidden border-t border-stone-100 bg-white"
  >
    <div class="container-page py-4 flex flex-col gap-1">
      <!-- Products group -->
      <details class="group">
        <summary class="flex items-center justify-between px-2 py-3 text-base font-medium text-navy-500 cursor-pointer list-none">
          Products
          <svg width="14" height="14" viewBox="0 0 12 12" fill="none" class="transition-transform group-open:rotate-180">
            <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <div class="pl-4 pb-2 flex flex-col gap-3">
          <div>
            <a href="/en/platform/" class="block py-1.5 text-sm font-semibold uppercase tracking-wider text-stone-300 hover:text-coral-500">
              Platform
            </a>
            <div class="flex flex-col">
              {platformCore.map((f) => (
                <a href={f.href} class="py-1.5 text-[15px] text-navy-500 hover:text-coral-500">{f.label}</a>
              ))}
              {platformExtras.map((f) => (
                <a href={f.href} class="py-1.5 text-[15px] text-navy-500 hover:text-coral-500">{f.label}</a>
              ))}
            </div>
          </div>
          <div>
            <a href="/en/modules/" class="block py-1.5 text-sm font-semibold uppercase tracking-wider text-stone-300 hover:text-coral-500">
              Modules
            </a>
            <div class="flex flex-col">
              {modules.map((m) => (
                <a href={m.href} class="flex items-center gap-3 py-2 text-[15px] text-navy-500 hover:text-coral-500">
                  <span class="shrink-0 inline-flex items-center justify-center w-8 h-8 rounded-lg bg-stone-50 text-navy-500">
                    <ModuleIcon slug={m.slug} />
                  </span>
                  {m.name}
                </a>
              ))}
            </div>
          </div>
          <div>
            <a href="/en/sensors/" class="block py-1.5 text-sm font-semibold uppercase tracking-wider text-stone-300 hover:text-coral-500">
              Sensors
            </a>
            <div class="flex flex-col">
              {sensorFeatured.map((f) => (
                <a href={f.href} class="py-1.5 text-[15px] text-navy-500 hover:text-coral-500">{f.label}</a>
              ))}
              <a href="/en/sensors/" class="py-1.5 text-[14px] font-medium text-coral-500">All sensors →</a>
            </div>
          </div>
        </div>
      </details>

      <!-- Industries group (Industries + Evaluate) -->
      <details class="group">
        <summary class="flex items-center justify-between px-2 py-3 text-base font-medium text-navy-500 cursor-pointer list-none">
          Industries
          <svg width="14" height="14" viewBox="0 0 12 12" fill="none" class="transition-transform group-open:rotate-180">
            <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <div class="pl-4 pb-2 flex flex-col gap-3">
          <div>
            <a href="/en/industries/" class="block py-1.5 text-sm font-semibold uppercase tracking-wider text-stone-300 hover:text-coral-500">
              Industries
            </a>
            <div class="flex flex-col">
              {industriesAll.map((f) => (
                <a href={f.href} class="flex items-center gap-3 py-2 text-[15px] text-navy-500 hover:text-coral-500">
                  <span class="shrink-0 inline-flex items-center justify-center w-8 h-8 rounded-lg bg-coral-50 text-coral-500">
                    <IndustryIcon slug={f.slug} />
                  </span>
                  {f.label}
                </a>
              ))}
            </div>
          </div>
          <div>
            <span class="block py-1.5 text-sm font-semibold uppercase tracking-wider text-stone-300">
              Evaluate
            </span>
            <span class="block mt-1 text-[11px] font-semibold uppercase tracking-wider text-coral-500">Tools</span>
            <div class="flex flex-col">
              {evaluateTools.map((f) => (
                <a href={f.href} class="py-1.5 text-[15px] text-navy-500 hover:text-coral-500">{f.label}</a>
              ))}
            </div>
            <span class="block mt-2 text-[11px] font-semibold uppercase tracking-wider text-coral-500">Proof</span>
            <div class="flex flex-col">
              {evaluateProof.map((f) => (
                <a href={f.href} class="py-1.5 text-[15px] text-navy-500 hover:text-coral-500">{f.label}</a>
              ))}
            </div>
          </div>
        </div>
      </details>

      <a href="/en/pricing/" class="px-2 py-3 text-base font-medium text-navy-500 hover:text-coral-500">Pricing</a>
      <a href="/en/library/" class="px-2 py-3 text-base font-medium text-navy-500 hover:text-coral-500">Library</a>
      <a href="/en/contact/" class="px-2 py-3 text-base font-medium text-navy-500 hover:text-coral-500">Contact</a>
      <a
        href={externalLinks.support}
        target="_blank"
        rel="noopener noreferrer"
        class="px-2 py-3 text-base font-medium text-navy-500 hover:text-coral-500"
      >
        Help
      </a>
      <div class="h-px bg-stone-100 my-2"></div>
      <a
        href={externalLinks.login}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 px-2 py-3 text-base font-medium text-navy-500 hover:text-coral-500"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
          <polyline points="10 17 15 12 10 7" />
          <line x1="15" y1="12" x2="3" y2="12" />
        </svg>
        Log in
      </a>
      <Button href="/en/contact/book-demo/" variant="primary" size="md" class="mt-2 w-full">Book a demo</Button>
    </div>
  </div>
</header>

<style>
  /* Nav links with a coral underline that slides in on hover and stays
     pinned under the active page. Warmer and more alive than a plain
     color swap. */
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    font-size: 15px;
    font-weight: 500;
    line-height: 1;
    color: var(--color-navy-500);
    border-radius: 0.375rem;
    background: transparent;
    transition: color 180ms ease;
    white-space: nowrap;
    cursor: pointer;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 2px;
    height: 2px;
    background-color: var(--color-coral-500);
    border-radius: 2px;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 220ms ease;
    pointer-events: none;
  }

  .nav-link:hover,
  .nav-link[data-active="true"] {
    color: var(--color-coral-500);
  }

  .nav-link:hover::after,
  .nav-link[data-active="true"]::after {
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link,
    .nav-link::after {
      transition: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("menu-icon-open");
  const iconClose = document.getElementById("menu-icon-close");

  toggle?.addEventListener("click", () => {
    const isHidden = menu?.classList.contains("hidden");
    menu?.classList.toggle("hidden");
    iconOpen?.classList.toggle("hidden");
    iconClose?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", isHidden ? "true" : "false");
  });
</script>
