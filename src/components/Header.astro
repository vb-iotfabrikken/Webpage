---
import Button from "./Button.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ModuleIcon from "./ModuleIcon.astro";
import IndustryIcon from "./IndustryIcon.astro";
import NavDropdownLink from "./NavDropdownLink.astro";
import MegaMenuLink from "./MegaMenuLink.astro";
import { getModules } from "../data/modules";
import { getSensorsHub } from "../data/hubs/sensors";
import { getIndustriesHub } from "../data/hubs/industries";
import { industrySectors, industrySectorLabel, industryHubHref } from "../data/industrySectors";
import { externalLinks, getRoomAlyzerLoginUrl } from "../data/externalLinks";
import { langPath, pagePathname, resolveLang, stripLocaleRoute } from "../data/lang";
import { getUi } from "../data/i18n/ui";
import { isLivePath } from "../data/launch";

const pathname = pagePathname(Astro.url.pathname, Astro.originPathname);
const currentLang = resolveLang({
  pathname: Astro.url.pathname,
  paramLang: Astro.params.lang,
  currentLocale: Astro.currentLocale,
  originPathname: Astro.originPathname,
});
const loginUrl = getRoomAlyzerLoginUrl(currentLang);
const nav = getUi(currentLang).nav;
const modules = getModules(currentLang);
const liveModules = modules.filter((m) => isLivePath(m.href));
const moduleFeaturedSlugs = [
  "indoor-climate",
  "space-management",
  "water-detection",
  "preservation",
];
const moduleFeatured = moduleFeaturedSlugs
  .map((slug) => liveModules.find((m) => m.slug === slug))
  .filter((m): m is (typeof liveModules)[number] => Boolean(m))
  .map((m) => ({ label: m.name, href: m.href, slug: m.slug }));
const lp = (path: string) => langPath(path, currentLang);
const routeKey = stripLocaleRoute(pathname);
const isActive = (segment: string) => {
  const clean = segment.replace(/^\/+/, "").replace(/\/+$/, "");
  return routeKey === clean || routeKey.startsWith(`${clean}/`);
};

// "Product" dropdown spans Platform, Modules and Sensors.
const productActive =
  isActive("platform") ||
  isActive("modules") ||
  isActive("sensors");

// "Industries" dropdown — sector hubs; the label links to the industries overview.
const industriesActive = isActive("industries");

const pricingActive =
  isActive("pricing") || isActive("roi");

const resourcesActive =
  isActive("articles") ||
  isActive("case-studies") ||
  isActive("sensors/product-sheets") ||
  isActive("whitepapers");

const companyActive =
  isActive("about") || isActive("contact");

// A curated slice of the sensor catalogue for the header. The full list
// lives on the sensors hub page.
const sensorsHub = getSensorsHub(currentLang);
const sensorFeaturedSlugs = [
  "full-plus",
  "mini-plus",
  "humidity",
  "water-detector",
];
const sensorFeatured = sensorFeaturedSlugs
  .map((slug) => sensorsHub.leaves.find((l) => l.slug === slug))
  .filter((l): l is (typeof sensorsHub.leaves)[number] => Boolean(l))
  .map((l) => ({
    label: l.title.replace(/\.$/, ""),
    href: lp(`sensors/${l.slug}`),
  }))
  .filter((f) => isLivePath(f.href));

const showCompare = isLivePath(lp("compare"));

const industriesHub = getIndustriesHub(currentLang);

const industryBySlug = Object.fromEntries(
  industriesHub.leaves.map((l) => [
    l.slug,
    {
      slug: l.slug,
      label: l.title.replace(/\.$/, ""),
      href: lp(`industries/${l.slug}`),
    },
  ]),
);

// Industries dropdown — grouped by sector from industrySectors.ts. The full
// catalogue (15 industries) lives on the industries overview page.
const industryColumns = industrySectors.map((sector) => ({
  sectorId: sector.id,
  title: industrySectorLabel(sector.labelKey, nav),
  hubHref: industryHubHref(currentLang, sector.id),
  items: sector.slugs
    .map((slug) => industryBySlug[slug])
    .filter((f) => Boolean(f) && isLivePath(f.href)),
}));

const pricingLinks = [
  {
    label: nav.pricing.modelsLabel,
    href: lp("pricing"),
    description: nav.pricing.modelsDesc,
    icon: "pricing" as const,
  },
  {
    label: nav.pricing.roiLabel,
    href: lp("roi/calculator"),
    description: nav.pricing.roiDesc,
    icon: "roi" as const,
  },
].filter((l) => isLivePath(l.href));

const resourcesLinks = [
  {
    label: nav.resources.libraryLabel,
    href: lp("articles"),
    description: nav.resources.libraryDesc,
    icon: "library" as const,
  },
  {
    label: nav.resources.casesLabel,
    href: lp("case-studies"),
    description: nav.resources.casesDesc,
    icon: "case-studies" as const,
  },
  {
    label: nav.resources.whitepapersLabel,
    href: lp("whitepapers"),
    description: nav.resources.whitepapersDesc,
    icon: "whitepapers" as const,
  },
].filter((l) => isLivePath(l.href));

const companyLinks = [
  {
    label: nav.company.aboutLabel,
    href: lp("about"),
    description: nav.company.aboutDesc,
    icon: "about" as const,
  },
  {
    label: nav.company.careersLabel,
    href: lp("about/careers"),
    description: nav.company.careersDesc,
    icon: "careers" as const,
  },
  {
    label: nav.company.contactLabel,
    href: lp("contact"),
    description: nav.company.contactDesc,
    icon: "contact" as const,
  },
].filter((l) => isLivePath(l.href));

// Soft-launch: platform teaser links to the hub only (full catalogue on /platform/).
const showPlatform = isLivePath(lp("platform"));
const showProductsCtas = showPlatform || showCompare;
const showPricing = pricingLinks.length > 0;
const showResources = resourcesLinks.length > 0;
const showIndustries =
  industryColumns.some((col) => col.items.length > 0) && isLivePath(lp("industries"));
---

<header id="site-header" class="sticky top-0 z-50 overflow-visible" data-lang={currentLang}>
  <!-- Top utility bar — a warm, human-sounding status line plus utility links. -->
  <div class="bg-navy-500 text-white">
    <div class="container-page site-header-bar site-header-bar--utility">
      <div class="site-header-utility-message hidden md:flex">
        <span class="relative inline-flex w-2 h-2" aria-hidden="true">
          <span class="absolute inline-flex h-full w-full rounded-full bg-forest-50 opacity-75 animate-ping"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-forest-50"></span>
        </span>
        <span class="text-white/85">
          {nav.utility.builtInDenmark}
        </span>
      </div>

      <div class="site-header-actions">
        <a
          href={externalLinks.support}
          target="_blank"
          rel="noopener noreferrer"
          class="utility-link hidden md:inline-flex"
        >
          {nav.top.helpcenter}
        </a>
        <span class="utility-divider hidden md:inline-block" aria-hidden="true"></span>
        <LanguageSwitcher variant="compact" />
      </div>
    </div>
  </div>

  <!-- Main header bar -->
  <div class="bg-white/95 backdrop-blur border-b border-stone-100">
    <div class="container-page site-header-bar site-header-bar--main">
      <a href={lp("")} class="site-header-brand flex shrink-0 items-center gap-3 group" aria-label="IoT Fabrikken home">
        <img
          src="/logo.png"
          alt="IoT Fabrikken"
          class="site-header-logo w-auto transition-transform duration-300 ease-out group-hover:-rotate-3 group-hover:scale-[1.03]"
        />
      </a>

      <nav class="site-header-menu relative hidden min-[960px]:flex items-center gap-1 min-w-0" aria-label="Primary navigation">
        <!-- Products dropdown: Platform · Modules · Sensors -->
        <div class="group relative">
          <button
            type="button"
            class="nav-link"
            data-active={productActive}
            aria-haspopup="true"
          >
            {nav.top.products}
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" class="ml-1 transition-transform duration-200 group-hover:rotate-180">
              <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <div
            class="nav-dropdown invisible opacity-0 translate-y-1 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 w-[min(920px,calc(100vw-2rem))]"
          >
            <div class="bg-white rounded-xl shadow-xl border border-stone-100 p-6 w-fit">
              <div
                class:list={[
                  "grid gap-x-20 gap-y-0 items-stretch",
                  showProductsCtas
                    ? "grid-cols-[minmax(15rem,auto)_minmax(11rem,auto)_minmax(11rem,13.5rem)]"
                    : "grid-cols-[minmax(15rem,auto)_minmax(11rem,auto)]",
                ]}
              >
                <!-- Modules -->
                <div class="flex flex-col h-full min-w-0">
                  <a
                    href={lp("modules")}
                    class="block text-xs font-semibold uppercase tracking-wider text-stone-300 mb-3 hover:text-coral-500 transition-colors leading-snug"
                  >
                    {nav.columns.modules}
                  </a>
                  <ul class="space-y-0.5">
                    {moduleFeatured.map((m) => (
                      <li>
                        <MegaMenuLink href={m.href} label={m.label} iconTone="forest">
                          <ModuleIcon slot="icon" slug={m.slug} class="w-4 h-4" />
                        </MegaMenuLink>
                      </li>
                    ))}
                  </ul>
                  <a
                    href={lp("modules")}
                    class="mt-auto pt-3 px-2 -mx-2 text-[12.5px] font-medium text-stone-400 hover:text-coral-500 transition-colors"
                  >
                    {nav.cta.more} →
                  </a>
                </div>

                <!-- Sensors -->
                <div class="flex flex-col h-full min-w-0">
                  <a
                    href={lp("sensors")}
                    class="block text-xs font-semibold uppercase tracking-wider text-stone-300 mb-3 hover:text-coral-500 transition-colors leading-snug"
                  >
                    {nav.columns.sensors}
                  </a>
                  <ul class="space-y-0.5">
                    {sensorFeatured.map((f) => (
                      <li>
                        <MegaMenuLink href={f.href} label={f.label} />
                      </li>
                    ))}
                  </ul>
                  <a
                    href={lp("sensors")}
                    class="mt-auto pt-3 px-2 -mx-2 text-[12.5px] font-medium text-stone-400 hover:text-coral-500 transition-colors"
                  >
                    {nav.cta.more} →
                  </a>
                </div>

                {showProductsCtas && (
                  <div class="flex flex-col gap-3">
                    {showCompare && (
                      <a
                        href={lp("compare")}
                        class="flex items-center justify-between gap-2 p-2.5 rounded-lg bg-coral-50 hover:bg-coral-100 transition-colors group/products-compare"
                      >
                        <span class="text-[13.5px] font-semibold text-coral-600">
                          {nav.cta.compareSensors}
                        </span>
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="shrink-0 text-coral-500 group-hover/products-compare:translate-x-0.5 transition-transform" aria-hidden="true">
                          <path d="M3 7h8M7.5 3.5L11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </a>
                    )}
                    {showPlatform && (
                      <a
                        href={lp("platform")}
                        class="flex items-center justify-between gap-2 p-2.5 rounded-lg bg-stone-50 hover:bg-stone-100 transition-colors group/products-platform"
                      >
                        <span class="min-w-0">
                          <span class="block text-[13.5px] font-semibold text-navy-500 group-hover/products-platform:text-coral-500">
                            {nav.cta.explorePlatform}
                          </span>
                          <span class="mt-0.5 block text-[11.5px] text-stone-400 leading-snug">
                            {nav.cta.explorePlatformDesc}
                          </span>
                        </span>
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="shrink-0 text-navy-500 group-hover/products-platform:text-coral-500 group-hover/products-platform:translate-x-0.5 transition-all" aria-hidden="true">
                          <path d="M3 7h8M7.5 3.5L11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </a>
                    )}
                  </div>
                )}
              </div>
            </div>
          </div>
        </div>

        {showIndustries && (
        <div class="group relative" data-nav-industries>
          <a
            href={lp("industries")}
            class="nav-link"
            data-active={industriesActive}
            aria-haspopup="true"
          >
            {nav.top.industries}
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" class="ml-1 transition-transform duration-200 group-hover:rotate-180">
              <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <div
            class="nav-dropdown nav-dropdown--industries invisible opacity-0 translate-y-1 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 w-[min(1040px,calc(100vw-2rem))]"
          >
            <div class="bg-white rounded-xl shadow-xl border border-stone-100 p-6">
              <div class="nav-dropdown__grid grid grid-cols-4 gap-6">
                {industryColumns.map((col) => (
                  <div>
                    <a
                      href={col.hubHref}
                      class="block text-xs font-semibold uppercase tracking-wider text-stone-300 mb-3 hover:text-coral-500 transition-colors leading-snug"
                    >
                      {col.title}
                    </a>
                    <ul class="space-y-0.5">
                      {col.items.map((f) => (
                        <li>
                          <MegaMenuLink href={f.href} label={f.label} iconTone="coral">
                            <IndustryIcon slot="icon" slug={f.slug} class="w-4 h-4" />
                          </MegaMenuLink>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
              <a
                href={lp("industries")}
                class="mt-4 flex items-center justify-between p-2.5 rounded-lg bg-stone-50 hover:bg-stone-100 transition-colors group/library"
              >
                <span class="text-[13.5px] font-semibold text-navy-500 group-hover/library:text-coral-500">
                  {nav.cta.allIndustries}
                </span>
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="shrink-0 text-navy-500 group-hover/library:text-coral-500 group-hover/library:translate-x-0.5 transition-all" aria-hidden="true">
                  <path d="M3 7h8M7.5 3.5L11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </div>
          </div>
        </div>
        )}

        {showPricing && (
        <div class="group relative">
          <button
            type="button"
            class="nav-link"
            data-active={pricingActive}
            aria-haspopup="true"
          >
            {nav.top.pricing}
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" class="ml-1 transition-transform duration-200 group-hover:rotate-180">
              <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <div
            class="nav-dropdown invisible opacity-0 translate-y-1 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 w-72"
          >
            <div class="bg-white rounded-xl shadow-xl border border-stone-100 p-3">
              <ul class="space-y-0.5">
                {pricingLinks.map((f) => (
                  <li>
                    <NavDropdownLink
                      href={f.href}
                      label={f.label}
                      description={f.description}
                      icon={f.icon}
                    />
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
        )}

        {showResources && (
        <div class="group relative">
          <button
            type="button"
            class="nav-link"
            data-active={resourcesActive}
            aria-haspopup="true"
          >
            {nav.top.resources}
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" class="ml-1 transition-transform duration-200 group-hover:rotate-180">
              <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <div
            class="nav-dropdown invisible opacity-0 translate-y-1 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 w-72"
          >
            <div class="bg-white rounded-xl shadow-xl border border-stone-100 p-3">
              <ul class="space-y-0.5">
                {resourcesLinks.map((f) => (
                  <li>
                    <NavDropdownLink
                      href={f.href}
                      label={f.label}
                      description={f.description}
                      icon={f.icon}
                    />
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
        )}

        <!-- Company dropdown -->
        <div class="group relative">
          <a
            href={lp("about")}
            class="nav-link"
            data-active={companyActive}
            aria-haspopup="true"
          >
            {nav.top.company}
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" class="ml-1 transition-transform duration-200 group-hover:rotate-180">
              <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <div
            class="nav-dropdown invisible opacity-0 translate-y-1 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 w-72"
          >
            <div class="bg-white rounded-xl shadow-xl border border-stone-100 p-3">
              <ul class="space-y-0.5">
                {companyLinks.map((f) => (
                  <li>
                    <NavDropdownLink
                      href={f.href}
                      label={f.label}
                      description={f.description}
                      icon={f.icon}
                    />
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

      </nav>

      <div class="site-header-actions shrink-0">
        <div class="hidden min-[960px]:flex items-center gap-1">
          <a
            href={loginUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="nav-link shrink-0"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="mr-1.5"
              aria-hidden="true"
            >
              <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
              <polyline points="10 17 15 12 10 7" />
              <line x1="15" y1="12" x2="3" y2="12" />
            </svg>
            {nav.top.login}
          </a>
          <span class="mx-2 h-5 w-px bg-stone-100" aria-hidden="true"></span>
          <Button href={lp("contact/book-demo")} variant="primary" size="sm" class="site-header-demo-btn shrink-0">
          {nav.top.bookDemo}
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M3 7h8M7.5 3.5L11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          </Button>
        </div>

        <button
          id="mobile-menu-toggle"
          type="button"
        class="min-[960px]:hidden inline-flex items-center justify-center w-10 h-10 text-navy-500"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="menu-icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none">
          <path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <svg id="menu-icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" class="hidden">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu — scrollable panel when viewport height is limited -->
  <div
    id="mobile-menu"
    class="mobile-menu-panel min-[960px]:hidden hidden border-t border-stone-100 bg-white"
  >
    <div class="container-page py-4 pb-10 flex flex-col gap-1">
      <!-- Products group -->
      <details class="group">
        <summary class="flex items-center justify-between px-2 py-3 text-base font-medium text-navy-500 cursor-pointer list-none">
          {nav.top.products}
          <svg width="14" height="14" viewBox="0 0 12 12" fill="none" class="transition-transform group-open:rotate-180">
            <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <div class="pl-4 pb-2 flex flex-col gap-3">
          <div>
            <a href={lp("modules")} class="block py-1.5 text-sm font-semibold uppercase tracking-wider text-stone-300 hover:text-coral-500">
              {nav.columns.modules}
            </a>
            <div class="flex flex-col gap-0.5">
              {moduleFeatured.map((m) => (
                <MegaMenuLink href={m.href} label={m.label} iconTone="forest" variant="mobile">
                  <ModuleIcon slot="icon" slug={m.slug} />
                </MegaMenuLink>
              ))}
            </div>
            <a
              href={lp("modules")}
              class="mt-2 px-2 py-1 text-[14px] font-medium text-stone-400 hover:text-coral-500 transition-colors"
            >
              {nav.cta.more} →
            </a>
          </div>
          <div>
            <a href={lp("sensors")} class="block py-1.5 text-sm font-semibold uppercase tracking-wider text-stone-300 hover:text-coral-500">
              {nav.columns.sensors}
            </a>
            <div class="flex flex-col gap-0.5">
              {sensorFeatured.map((f) => (
                <MegaMenuLink href={f.href} label={f.label} variant="mobile" />
              ))}
            </div>
            <a
              href={lp("sensors")}
              class="mt-2 px-2 py-1 text-[14px] font-medium text-stone-400 hover:text-coral-500 transition-colors"
            >
              {nav.cta.more} →
            </a>
          </div>
          {showProductsCtas && (
            <div class="flex flex-col gap-2 pt-1">
              {showCompare && (
                <a
                  href={lp("compare")}
                  class="flex items-center justify-between gap-2 px-3 py-2.5 rounded-lg bg-coral-50 hover:bg-coral-100 transition-colors"
                >
                  <span class="text-[15px] font-semibold text-coral-600">{nav.cta.compareSensors}</span>
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="shrink-0 text-coral-500" aria-hidden="true">
                    <path d="M3 7h8M7.5 3.5L11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              )}
              {showPlatform && (
                <a
                  href={lp("platform")}
                  class="flex items-center justify-between gap-2 px-3 py-2.5 rounded-lg bg-stone-50 hover:bg-stone-100 transition-colors"
                >
                  <span class="min-w-0">
                    <span class="block text-[15px] font-semibold text-navy-500">
                      {nav.cta.explorePlatform}
                    </span>
                    <span class="mt-0.5 block text-[13px] text-stone-400 leading-snug">
                      {nav.cta.explorePlatformDesc}
                    </span>
                  </span>
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="shrink-0 text-navy-500" aria-hidden="true">
