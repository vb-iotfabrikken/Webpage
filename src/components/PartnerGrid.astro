---
import type { PartnerEntry } from "../data/partners";

interface Props {
  partners: PartnerEntry[];
}

const { partners } = Astro.props;
---

<ul class="partner-showcase" role="list">
  {partners.map((entry) => (
    <li class="partner-showcase__item">
      {entry.kind === "partner" ? (
        <a
          href={entry.url}
          target="_blank"
          rel="noopener noreferrer"
          class="partner-showcase__link"
          aria-label={`${entry.name} (opens in a new tab)`}
        >
          <span class="partner-showcase__logo" aria-hidden="true">
            <img src={entry.logo} alt="" width="360" height="360" loading="lazy" decoding="async" />
          </span>
          <span class="partner-showcase__name">{entry.name}</span>
        </a>
      ) : (
        <a href={entry.href} class="partner-showcase__link partner-showcase__link--placeholder">
          <span class="partner-showcase__logo partner-showcase__logo--empty" aria-hidden="true">
            <span class="partner-showcase__placeholder-icon" aria-hidden="true">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 5v14M5 12h14" />
              </svg>
            </span>
          </span>
          <span class="partner-showcase__placeholder-label">{entry.label}</span>
          {entry.hint && (
            <span class="partner-showcase__placeholder-hint">{entry.hint}</span>
          )}
        </a>
      )}
    </li>
  ))}
</ul>

<style>
  .partner-showcase {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 520px) {
    .partner-showcase {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  @media (min-width: 1280px) {
    .partner-showcase {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }
  }

  .partner-showcase__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    width: 100%;
    padding: 2rem 1.5rem 1.75rem;
    background: var(--color-white);
    border: 1px solid var(--color-stone-100);
    border-radius: 1rem;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  @media (min-width: 640px) {
    .partner-showcase__link {
      padding: 2.5rem 2rem 2rem;
      gap: 1.5rem;
    }
  }

  .partner-showcase__link:hover {
    border-color: color-mix(in srgb, var(--color-navy-500) 20%, white);
    box-shadow: 0 8px 32px color-mix(in srgb, var(--color-navy-500) 10%, transparent);
    transform: translateY(-2px);
  }

  .partner-showcase__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: min(100%, 17.5rem);
    aspect-ratio: 1;
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .partner-showcase__logo {
      width: min(100%, 20rem);
    }
  }

  @media (min-width: 1280px) {
    .partner-showcase__logo {
      width: min(100%, 22.5rem);
    }
  }

  .partner-showcase__logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .partner-showcase__name {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-stone-300);
    text-align: center;
    line-height: 1.3;
  }

  .partner-showcase__link:hover .partner-showcase__name {
    color: var(--color-coral-500);
  }

  /* Empty partner slot */
  .partner-showcase__link--placeholder {
    border-style: dashed;
    border-color: color-mix(in srgb, var(--color-stone-300) 55%, white);
    background: color-mix(in srgb, var(--color-stone-50) 80%, white);
  }

  .partner-showcase__link--placeholder:hover {
    border-color: var(--color-coral-500);
    background: color-mix(in srgb, var(--color-coral-50) 40%, white);
  }

  .partner-showcase__logo--empty {
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--color-stone-100) 50%, white);
    border: 1px dashed color-mix(in srgb, var(--color-stone-300) 45%, white);
  }

  .partner-showcase__link--placeholder:hover .partner-showcase__logo--empty {
    border-color: color-mix(in srgb, var(--color-coral-500) 50%, white);
    background: color-mix(in srgb, var(--color-coral-50) 60%, white);
  }

  .partner-showcase__placeholder-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-stone-300);
    transition: color 0.2s ease;
  }

  .partner-showcase__link--placeholder:hover .partner-showcase__placeholder-icon {
    color: var(--color-coral-500);
  }

  .partner-showcase__placeholder-label {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-navy-500);
    text-align: center;
    line-height: 1.3;
    transition: color 0.2s ease;
  }

  .partner-showcase__link--placeholder:hover .partner-showcase__placeholder-label {
    color: var(--color-coral-500);
  }

  .partner-showcase__placeholder-hint {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-stone-300);
    text-align: center;
    margin-top: -0.75rem;
    transition: color 0.2s ease;
  }

  .partner-showcase__link--placeholder:hover .partner-showcase__placeholder-hint {
    color: var(--color-coral-500);
  }
</style>
