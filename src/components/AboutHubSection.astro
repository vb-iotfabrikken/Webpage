---
import { getAboutHub } from "../data/hubs/about";
import { aboutHubCardImages } from "../data/aboutHubCards";
import { getPartners } from "../data/partners";
import { getAbout } from "../data/i18n/about";
import { defaultLang, langPath, type Lang } from "../data/lang";

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = getAbout(lang);
const aboutHub = getAboutHub(lang);
const leafBase = langPath("about", lang);

const partnerLogos = getPartners(lang).filter(
  (entry): entry is Extract<ReturnType<typeof getPartners>[number], { kind: "partner" }> =>
    entry.kind === "partner",
);

const cards = aboutHub.leaves.map((leaf) => {
  const media = aboutHubCardImages[leaf.slug];
  return {
    slug: leaf.slug,
    href: `${leafBase}${leaf.slug}/`,
    title: leaf.title.replace(/\.$/, ""),
    description: leaf.lead,
    image: media?.image,
    imageAlt: media?.imageAlt,
    placeholder: media?.placeholder,
    width: media?.width,
    height: media?.height,
    srcSet: media?.srcSet,
    objectPosition: media?.objectPosition,
    imageScale: media?.imageScale,
  };
});
---

<section class="py-14 md:py-20 bg-white">
  <div class="container-page">
    <div class="reveal max-w-2xl mb-10 md:mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-navy-500 tracking-tight">
        {t.hub.exploreTitle}
      </h2>
      <p class="mt-4 text-lg text-stone-900/70 leading-relaxed">
        {t.hub.exploreLead}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {cards.map((item) => (
        <a
          href={item.href}
          class="reveal group flex flex-col h-full bg-white border border-stone-100 rounded-xl overflow-hidden hover:border-navy-500 hover:-translate-y-0.5 hover:shadow-md transition-all duration-300"
        >
          <div class="aspect-[4/3] overflow-hidden bg-stone-50">
            {item.slug === "partners" ? (
              <div
                class="grid h-full grid-cols-4 grid-rows-2 gap-2 p-4 sm:p-5"
                aria-label="Partner logos"
              >
                {partnerLogos.map((partner) => (
                  <div class="flex items-center justify-center rounded-md bg-white border border-stone-100 p-2">
                    <img
                      src={partner.logo}
                      alt={partner.logoAlt}
                      width={120}
                      height={120}
                      class="max-h-full max-w-full object-contain"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                ))}
              </div>
            ) : item.placeholder ? (
              <div
                class="flex h-full flex-col items-center justify-center gap-3 p-6 text-center bg-gradient-to-br from-sky-50/80 to-white"
                aria-label={item.imageAlt}
              >
                <div class="w-14 h-14 rounded-xl bg-white border border-sky-100 text-sky-600 flex items-center justify-center shadow-sm">
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 15l-3.5 2.1.9-4-3-2.6 4.1-.3L12 6l1.5 4.2 4.1.3-3 2.6.9 4z" />
                    <path d="M8.21 13.89L7 23l5-3 5 3-1.21-9.12" />
                  </svg>
                </div>
                <p class="text-sm font-semibold text-navy-500">{item.title}</p>
                <p class="text-xs text-stone-900/50">{t.common.imageComingSoon}</p>
              </div>
            ) : (
              <img
                src={item.image}
                alt={item.imageAlt}
                width={item.width ?? 640}
                height={item.height ?? 480}
                srcset={item.srcSet?.map((entry) => `${entry.url} ${entry.width}w`).join(", ")}
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                class="w-full h-full object-cover"
                style={
                  item.objectPosition || item.imageScale
                    ? [
                        item.objectPosition ? `object-position: ${item.objectPosition}` : "",
                        item.imageScale
                          ? `transform: scale(${item.imageScale}); transform-origin: ${item.objectPosition ?? "50% 50%"}`
                          : "",
                      ]
                        .filter(Boolean)
                        .join("; ")
                    : undefined
                }
                loading="lazy"
                decoding="async"
              />
            )}
          </div>
          <div class="flex flex-col flex-1 p-5 sm:p-6">
            <h3 class="text-lg font-semibold text-navy-500 mb-2">{item.title}</h3>
            <p class="text-sm text-stone-900/70 leading-relaxed flex-1">{item.description}</p>
            <span class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-sky-600 group-hover:text-coral-500 transition-colors">
              {t.common.readMore}
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
                <path d="M4 10L10 4M10 4H5M10 4V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
