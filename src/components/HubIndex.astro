---
import Layout from "../layouts/Layout.astro";
import Hero from "./Hero.astro";
import Button from "./Button.astro";
import CtaBand from "./CtaBand.astro";
import type { Hub } from "../data/hubs/types";
import { getAbout } from "../data/i18n/about";
import { defaultLang, langPath, type Lang } from "../data/lang";

interface Breadcrumb {
  label: string;
  href?: string;
}

interface Props {
  hub: Hub;
  /** Absolute path to the hub, e.g. "/en/platform/". */
  basePath: string;
  breadcrumbs?: Breadcrumb[];
  /** Optional override of the page <title>. */
  title?: string;
  /** Optional override of the meta description. */
  description?: string;
  /** Locale for chrome strings (CTAs, headings). Defaults to English. */
  lang?: Lang;
}

const { hub, basePath, breadcrumbs = [], title, description, lang = defaultLang } = Astro.props;

const t = getAbout(lang);
const pageTitle = title ?? `${hub.title.replace(/\.$/, "")} | IoT Fabrikken`;
const metaDescription = description ?? hub.lead;
const leafBase = basePath.endsWith("/") ? basePath : `${basePath}/`;
const bookDemoHref = langPath("contact/book-demo", lang);
const contactSalesHref = langPath("contact/sales", lang);
---

<Layout title={pageTitle} description={metaDescription}>
  {breadcrumbs.length > 0 && (
    <nav class="container-page pt-6" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-1.5 text-sm text-stone-300">
        {breadcrumbs.map((b, i) => (
          <li class="flex items-center gap-1.5">
            {b.href ? (
              <a href={b.href} class="hover:text-coral-500 transition-colors">{b.label}</a>
            ) : (
              <span class="text-navy-500">{b.label}</span>
            )}
            {i < breadcrumbs.length - 1 && (
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M4.5 3L7.5 6L4.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )}

  <Hero
    title={hub.title}
    titleAccent={hub.titleAccent}
    lead={hub.lead}
    align="left"
    compactTop={breadcrumbs.length > 0}
  >
    <Button href={bookDemoHref} variant="primary" size="lg" slot="cta">{t.common.bookDemo}</Button>
    <Button href={contactSalesHref} variant="secondary" size="lg" slot="cta">{t.common.contactSales}</Button>
  </Hero>

  <section class="py-16 md:py-20">
    <div class="container-page">
      <div class="reveal max-w-2xl mb-10 md:mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-navy-500 tracking-tight">
          {t.common.explore} {hub.title.replace(/\.$/, "").toLowerCase()}.
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        <slot name="before-leaves" />

        {hub.leaves.map((leaf) => (
          <a
            href={`${leafBase}${leaf.slug}/`}
            class="reveal group relative flex flex-col h-full p-6 md:p-7 bg-white border border-stone-100 rounded-xl hover:border-navy-500 hover:-translate-y-1 hover:shadow-lg transition-all duration-300"
          >
            <div class="absolute top-0 left-0 right-0 h-1 rounded-t-xl bg-sky-500"></div>

            <h3 class="text-lg font-semibold text-navy-500 mb-2 leading-snug">
              {leaf.title}
              {leaf.titleAccent && (
                <span class="block text-sky-600 text-base font-medium mt-0.5">{leaf.titleAccent}</span>
              )}
            </h3>
            <p class="text-sm text-stone-900/70 leading-relaxed flex-1">{leaf.lead}</p>

            <div class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-navy-500 group-hover:text-sky-600 transition-colors">
              {t.common.readMore}
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="transition-transform group-hover:translate-x-1">
                <path d="M3 7h8M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
          </a>
        ))}

        <slot name="after-leaves" />
      </div>

      <div class="mt-12">
        <slot />
      </div>
    </div>
  </section>

  <CtaBand
    title={t.hub.ctaTitle}
    subtitle={t.hub.ctaSubtitle}
    primaryLabel={t.common.bookDemo}
    primaryHref={bookDemoHref}
    secondaryLabel={t.common.contactSales}
    secondaryHref={contactSalesHref}
  />
</Layout>
