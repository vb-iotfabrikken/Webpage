---
import Button from "./Button.astro";

interface Props {
  title: string;
  subtitle?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  variant?: "light" | "dark" | "coral";
}

const {
  title,
  subtitle,
  primaryLabel = "Book demo",
  primaryHref = "/en/contact/book-demo/",
  secondaryLabel = "Contact sales",
  secondaryHref = "/en/contact/sales/",
  variant = "light",
} = Astro.props;

const bg = {
  light: "bg-stone-50",
  dark: "bg-navy-500 text-white",
  coral: "bg-coral-500 text-white",
}[variant];

const titleCls = variant === "light" ? "text-navy-500" : "text-white";
const subCls = variant === "light" ? "text-stone-900/70" : "text-white/80";
---

<section class={`py-16 md:py-20 ${bg}`}>
  <div class="container-page">
    <div class="reveal flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
      <div class="max-w-2xl">
        <h2 class={`text-3xl md:text-4xl font-bold ${titleCls}`}>{title}</h2>
        {subtitle && <p class={`mt-3 text-lg ${subCls}`}>{subtitle}</p>}
      </div>
      <div class="flex flex-wrap gap-3">
        <Button href={primaryHref} variant={variant === "light" ? "primary" : "white"} size="lg">
          {primaryLabel}
        </Button>
        {secondaryLabel && (
          <Button href={secondaryHref} variant={variant === "light" ? "secondary" : "ghost"} size="lg" class={variant !== "light" ? "text-white hover:text-white/80 border border-white/40 hover:bg-white/10" : ""}>
            {secondaryLabel}
          </Button>
        )}
      </div>
    </div>
  </div>
</section>
