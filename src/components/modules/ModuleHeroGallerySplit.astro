---
import ModuleHeroEditorialGallery from "./ModuleHeroEditorialGallery.astro";
import ModuleScreenshotPlaceholder from "./ModuleScreenshotPlaceholder.astro";
import type { ModuleHeroGallery } from "../../data/i18n/modulePageTypes";

interface GalleryImage {
  src?: string;
  width: number;
  height: number;
  placeholderLabel?: string;
}

interface Props {
  gallery: ModuleHeroGallery;
  images: {
    archive: GalleryImage;
    manuscript: GalleryImage;
  };
  imageClass?: Partial<Record<"archive" | "manuscript", string>>;
  /** Wider intro column for locales with longer hero copy (e.g. German). */
  textColumnWide?: boolean;
}

const { gallery, images, imageClass = {}, textColumnWide = false } = Astro.props;

const archiveAlt = gallery.images[0]?.alt ?? "Archive monitoring";
const manuscriptAlt = gallery.images[1]?.alt ?? "Manuscript monitoring";

const manuscriptFit = imageClass.manuscript ?? "object-cover object-center";
const archiveFit = imageClass.archive ?? "object-cover object-[center_40%]";

/** Shared tile height — matches mockup proportions and keeps the band compact. */
const tileHeight = "h-40 sm:h-44 md:h-48";
---

<div
  class:list={[
    "reveal grid grid-cols-1 gap-4",
    textColumnWide ? "md:grid-cols-[minmax(0,7fr)_minmax(0,4fr)]" : "md:grid-cols-2",
  ]}
>
  <div class="flex min-w-0 flex-col justify-center md:pr-2">
    <ModuleHeroEditorialGallery gallery={gallery} part="all" surface="dark" compact />
  </div>

  <figure class:list={["overflow-hidden rounded-2xl", tileHeight]}>
    {
      images.manuscript.src ? (
        <img
          src={images.manuscript.src}
          alt={manuscriptAlt}
          width={images.manuscript.width}
          height={images.manuscript.height}
          class:list={["h-full w-full", manuscriptFit]}
          loading="eager"
          decoding="async"
        />
      ) : (
        <ModuleScreenshotPlaceholder label={images.manuscript.placeholderLabel ?? manuscriptAlt} />
      )
    }
  </figure>

  <figure class:list={["overflow-hidden rounded-2xl md:col-span-2", tileHeight]}>
    {
      images.archive.src ? (
        <img
          src={images.archive.src}
          alt={archiveAlt}
          width={images.archive.width}
          height={images.archive.height}
          class:list={["h-full w-full", archiveFit]}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <ModuleScreenshotPlaceholder label={images.archive.placeholderLabel ?? archiveAlt} />
      )
    }
  </figure>
</div>
