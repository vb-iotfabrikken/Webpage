---
import ModuleScreenshotPlaceholder from "./ModuleScreenshotPlaceholder.astro";

interface Props {
  label: string;
  alt: string;
  width: number;
  height: number;
  src?: string;
  placeholderLabel?: string;
  class?: string;
}

const { label, src, alt, width, height, placeholderLabel, class: className = "" } = Astro.props;
---

<div class:list={["bg-white border border-stone-100 rounded-xl shadow-xl overflow-hidden", className]}>
  <div class="flex items-center gap-2 px-4 py-3 border-b border-stone-100 bg-stone-50">
    <span class="w-3 h-3 rounded-full bg-stone-300/70"></span>
    <span class="w-3 h-3 rounded-full bg-stone-300/70"></span>
    <span class="w-3 h-3 rounded-full bg-stone-300/70"></span>
    <span class="ml-3 text-xs font-medium text-stone-300">{label}</span>
  </div>
  {src ? (
    <img src={src} alt={alt} width={width} height={height} class="w-full h-auto block" loading="eager" />
  ) : (
    <ModuleScreenshotPlaceholder label={placeholderLabel ?? alt} />
  )}
</div>
