---
// NOTE: These are placeholder customer logos. Swap the slug/URL for each real customer when provided.
// `slug` must match a brand on https://simpleicons.org (we fetch from cdn.simpleicons.org).
// For customers without a Simple Icons match, use `wordmark` to render a styled text logo instead.

type Logo =
  | { name: string; url: string; slug: string; wordmark?: never }
  | { name: string; url: string; slug?: never; wordmark: string };

const logos: Logo[] = [
  { name: "Ørsted", url: "https://orsted.com", slug: "orsted" },
  { name: "Novo Nordisk", url: "https://www.novonordisk.com", slug: "novonordisk" },
  { name: "Mærsk", url: "https://www.maersk.com", slug: "maersk" },
  { name: "IKEA", url: "https://www.ikea.com/dk/da/", slug: "ikea" },
  { name: "LEGO", url: "https://www.lego.com/da-dk", slug: "lego" },
  { name: "Coop", url: "https://coop.dk", wordmark: "Coop" },
  { name: "DSB", url: "https://www.dsb.dk", wordmark: "DSB" },
  { name: "ISS", url: "https://www.issworld.com", wordmark: "ISS" },
  { name: "Rambøll", url: "https://www.ramboll.com/da-dk", wordmark: "Rambøll" },
  { name: "Arla", url: "https://www.arla.dk", slug: "arla" },
];

const doubled = [...logos, ...logos];

// cdn.simpleicons.org serves SVG for a brand, colored via path; we tint to a muted stone tone.
const iconUrl = (slug: string) => `https://cdn.simpleicons.org/${slug}/9B9B9B`;
const iconUrlHover = (slug: string) => `https://cdn.simpleicons.org/${slug}/0D3D54`;
---

<section class="py-10 bg-white border-y border-stone-100 overflow-hidden">
  <div class="container-page">
    <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-stone-300 mb-6">
      Mere end 300 organisationer i 12 lande bruger vores løsninger
    </p>
  </div>
  <div class="overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)]">
    <div class="marquee items-center">
      {doubled.map((logo) => (
        <a
          href={logo.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Besøg ${logo.name}`}
          title={logo.name}
          class="group shrink-0 flex items-center justify-center h-10 min-w-[140px] px-2 opacity-70 hover:opacity-100 transition-opacity"
        >
          {logo.slug ? (
            <img
              src={iconUrl(logo.slug)}
              data-hover={iconUrlHover(logo.slug)}
              alt={logo.name}
              loading="lazy"
              class="h-7 w-auto max-w-[140px] object-contain brand-logo"
            />
          ) : (
            <span class="text-xl font-bold tracking-tight text-stone-300 group-hover:text-navy-500 transition-colors whitespace-nowrap">
              {logo.wordmark}
            </span>
          )}
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .brand-logo {
    transition: filter 200ms ease;
  }
  .group:hover .brand-logo {
    /* Recolor to navy-500 on hover by swapping the src */
  }
</style>

<script>
  document.querySelectorAll<HTMLImageElement>(".brand-logo").forEach((img) => {
    const hover = img.dataset.hover;
    const base = img.src;
    if (!hover) return;
    const parent = img.closest("a");
    parent?.addEventListener("mouseenter", () => (img.src = hover));
    parent?.addEventListener("mouseleave", () => (img.src = base));
  });
</script>
