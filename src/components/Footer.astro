---
import { modules } from "../data/modules";
const year = new Date().getFullYear();
---

<footer class="bg-navy-500 text-white mt-24">
  <div class="container-page py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      <div>
        <img src="/logo.png" alt="IoT Fabrikken" class="h-9 w-auto brightness-0 invert" />
        <p class="mt-4 text-sm text-white/70 leading-relaxed max-w-xs">
          100% dansk ejet SaaS- og IoT-virksomhed. Vi leverer trådløse sensorer og en
          platform, der gør data brugbar for facility og space management.
        </p>
      </div>

      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider text-white/60 mb-4">
          Produkter
        </h4>
        <ul class="space-y-2 text-sm">
          {modules.slice(0, 5).map((m) => (
            <li>
              <a href={m.href} class="text-white/80 hover:text-coral-500 transition-colors">
                {m.navn}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider text-white/60 mb-4">
          Virksomhed
        </h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/om-os" class="text-white/80 hover:text-coral-500 transition-colors">Om os</a></li>
          <li><a href="/kontakt" class="text-white/80 hover:text-coral-500 transition-colors">Kontakt</a></li>
          <li><a href="/book-demo" class="text-white/80 hover:text-coral-500 transition-colors">Book demo</a></li>
          <li><a href="https://roomalyzer.com" class="text-white/80 hover:text-coral-500 transition-colors">Log ind</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider text-white/60 mb-4">
          Kontakt
        </h4>
        <ul class="space-y-2 text-sm text-white/80">
          <li>IoT Fabrikken ApS</li>
          <li>Danmark</li>
          <li><a href="mailto:hello@iot-fabrikken.com" class="hover:text-coral-500 transition-colors">hello@iot-fabrikken.com</a></li>
        </ul>
        <div class="mt-5 flex gap-3">
          <a href="https://www.linkedin.com/" aria-label="LinkedIn" class="w-9 h-9 inline-flex items-center justify-center rounded-md bg-white/10 hover:bg-coral-500 transition-colors">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.22 8h4.56v14H.22V8zm7.4 0h4.37v1.92h.06c.61-1.15 2.1-2.36 4.32-2.36 4.62 0 5.47 3.04 5.47 7v7.44h-4.56V15.4c0-1.7-.03-3.88-2.37-3.88-2.37 0-2.73 1.85-2.73 3.76V22H7.62V8z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-white/60">
      <p>© {year} IoT Fabrikken. Alle rettigheder forbeholdes.</p>
      <div class="flex gap-6">
        <a href="#" class="hover:text-white transition-colors">Privatlivspolitik</a>
        <a href="#" class="hover:text-white transition-colors">Cookies</a>
      </div>
    </div>
  </div>
</footer>
