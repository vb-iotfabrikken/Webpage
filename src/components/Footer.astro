---
import { externalLinks } from "../data/externalLinks";

const year = new Date().getFullYear();

const productLinks = [
  { label: "Platform", href: "/en/platform/" },
  { label: "Modules", href: "/en/modules/" },
  { label: "Sensors", href: "/en/sensors/" },
  { label: "Integrations", href: "/en/integrations/" },
  { label: "Pricing", href: "/en/pricing/" },
  { label: "Shop", href: "/en/shop/" },
];

const solutionLinks = [
  { label: "Industries", href: "/en/industries/" },
  { label: "Case studies", href: "/en/case-studies/" },
  { label: "White papers", href: "/en/whitepapers/" },
  { label: "Compare", href: "/en/compare/" },
  { label: "ROI", href: "/en/roi/" },
  { label: "Library", href: "/en/library/" },
];

const companyLinks = [
  { label: "About", href: "/en/about/" },
  { label: "Careers", href: "/en/about/careers/" },
  { label: "Partners", href: "/en/about/partners/" },
  { label: "Press", href: "/en/about/press/" },
  { label: "Blog", href: "/en/blog/" },
  { label: "Contact", href: "/en/contact/" },
  { label: "Book demo", href: "/en/contact/book-demo/" },
];

const legalLinks = [
  { label: "Privacy policy", href: "/en/legal/privacy/" },
  { label: "Cookie policy", href: "/en/legal/cookies/" },
  { label: "Terms and DPA", href: "/en/legal/terms/" },
  { label: "Security", href: "/en/legal/security/" },
  { label: "Accessibility", href: "/en/legal/accessibility/" },
  { label: "SLA", href: "/en/legal/sla/" },
  { label: "Impressum", href: "/en/legal/impressum/" },
];
---

<footer class="bg-navy-500 text-white mt-24">
  <div class="container-page py-16">
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-10">
      <div class="col-span-2 lg:col-span-1">
        <img src="/logo.png" alt="IoT Fabrikken" class="h-9 w-auto brightness-0 invert" />
        <p class="mt-4 text-sm text-white/70 leading-relaxed max-w-xs">
          100% Danish-owned SaaS and IoT company. We deliver wireless sensors and a
          platform that turns data into something useful for facility and space management.
        </p>
        <ul class="mt-5 space-y-1.5 text-sm text-white/70">
          <li>IoT Fabrikken ApS</li>
          <li>Denmark</li>
          <li><a href="mailto:hello@iot-fabrikken.com" class="hover:text-coral-500 transition-colors">hello@iot-fabrikken.com</a></li>
        </ul>
        <div class="mt-5 flex gap-3">
          <a href={externalLinks.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="w-9 h-9 inline-flex items-center justify-center rounded-md bg-white/10 hover:bg-coral-500 transition-colors">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.22 8h4.56v14H.22V8zm7.4 0h4.37v1.92h.06c.61-1.15 2.1-2.36 4.32-2.36 4.62 0 5.47 3.04 5.47 7v7.44h-4.56V15.4c0-1.7-.03-3.88-2.37-3.88-2.37 0-2.73 1.85-2.73 3.76V22H7.62V8z"/>
            </svg>
          </a>
          <a href={externalLinks.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="w-9 h-9 inline-flex items-center justify-center rounded-md bg-white/10 hover:bg-coral-500 transition-colors">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.6 3.6 12 3.6 12 3.6s-7.6 0-9.4.5A3 3 0 0 0 .5 6.2 31.3 31.3 0 0 0 0 12a31.3 31.3 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.8.5 9.4.5 9.4.5s7.6 0 9.4-.5a3 3 0 0 0 2.1-2.1A31.3 31.3 0 0 0 24 12a31.3 31.3 0 0 0-.5-5.8zM9.6 15.5V8.5L15.8 12 9.6 15.5z"/>
            </svg>
          </a>
          <a href={externalLinks.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="w-9 h-9 inline-flex items-center justify-center rounded-md bg-white/10 hover:bg-coral-500 transition-colors">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.6-4-1.6-.5-1.4-1.3-1.8-1.3-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.3.5-2.3 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.7 1.7.3 2.9.1 3.2.8.9 1.2 1.9 1.2 3.2 0 4.6-2.8 5.7-5.5 6 .4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3z"/>
            </svg>
          </a>
        </div>
      </div>

      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider text-white/60 mb-4">
          Product
        </h4>
        <ul class="space-y-2 text-sm">
          {productLinks.map((l) => (
            <li>
              <a href={l.href} class="text-white/80 hover:text-coral-500 transition-colors">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider text-white/60 mb-4">
          Solutions
        </h4>
        <ul class="space-y-2 text-sm">
          {solutionLinks.map((l) => (
            <li>
              <a href={l.href} class="text-white/80 hover:text-coral-500 transition-colors">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider text-white/60 mb-4">
          Company
        </h4>
        <ul class="space-y-2 text-sm">
          {companyLinks.map((l) => (
            <li>
              <a href={l.href} class="text-white/80 hover:text-coral-500 transition-colors">
                {l.label}
              </a>
            </li>
          ))}
          <li>
            <a href={externalLinks.login} target="_blank" rel="noopener noreferrer" class="text-white/80 hover:text-coral-500 transition-colors">
              Log in ↗
            </a>
          </li>
          <li>
            <a href={externalLinks.support} target="_blank" rel="noopener noreferrer" class="text-white/80 hover:text-coral-500 transition-colors">
              Support ↗
            </a>
          </li>
          <li>
            <a href={externalLinks.status} target="_blank" rel="noopener noreferrer" class="text-white/80 hover:text-coral-500 transition-colors">
              Status ↗
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider text-white/60 mb-4">
          Legal
        </h4>
        <ul class="space-y-2 text-sm">
          {legalLinks.map((l) => (
            <li>
              <a href={l.href} class="text-white/80 hover:text-coral-500 transition-colors">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-white/60">
      <p>© {year} IoT Fabrikken. All rights reserved.</p>
      <div class="flex gap-6">
        <a href="/en/legal/privacy/" class="hover:text-white transition-colors">Privacy</a>
        <a href="/en/legal/cookies/" class="hover:text-white transition-colors">Cookies</a>
        <a href="/en/legal/terms/" class="hover:text-white transition-colors">Terms</a>
      </div>
    </div>
  </div>
</footer>
