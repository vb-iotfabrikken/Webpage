---
import { externalLinks } from "../data/externalLinks";
import { getLangFromPath, langPath } from "../data/lang";

const year = new Date().getFullYear();
const currentLang = getLangFromPath(Astro.url.pathname);

const productLinks = [
  { label: "Platform", href: "/en/platform/" },
  { label: "Modules", href: "/en/modules/" },
  { label: "Sensors", href: "/en/sensors/" },
  { label: "Integrations", href: "/en/integrations/" },
  { label: "Pricing", href: "/en/pricing/" },
];

const solutionLinks = [
  { label: "Industries", href: "/en/industries/" },
  { label: "Compare", href: "/en/compare/" },
  { label: "ROI", href: "/en/roi/" },
];

const resourceLinks = [
  { label: "Library", href: "/en/library/" },
  { label: "Cases", href: langPath("case-studies", currentLang) },
  { label: "White papers", href: "/en/whitepapers/" },
  { label: "Blog", href: "/en/blog/" },
];

const companyLinks = [
  { label: "About", href: "/en/about/" },
  { label: "Careers", href: "/en/about/careers/" },
  { label: "Partners", href: "/en/about/partners/" },
  { label: "Press", href: "/en/about/press/" },
  { label: "Contact", href: "/en/contact/" },
];

// Operational + legal combined into one column. External links open in
// a new tab and carry an arrow glyph in the label.
// Privacy, Cookies and Terms live only in the bottom bar — not duplicated here.
const supportLegalLinks = [
  { label: "Log in", href: externalLinks.login, external: true },
  { label: "Support", href: externalLinks.support, external: true },
  { label: "FAQ", href: "/en/faq/", external: false },
  { label: "Security & SLA", href: "/en/legal/security/", external: false },
  { label: "Impressum", href: "/en/legal/impressum/", external: false },
];
---

<footer class="bg-navy-500 text-white mt-24">
  <div class="container-page py-16">
    <!-- Top tier: brand · locations · contact & hours -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-12 pb-12 border-b border-white/10">
      <!-- Column 1 — Brand -->
      <div>
        <div class="bg-white inline-flex rounded-lg p-3">
          <img src="/logo.png" alt="IoT Fabrikken" class="h-8 w-auto" />
        </div>
        <p class="mt-5 text-sm text-white/70 leading-relaxed">
          100% Danish-owned SaaS and IoT company. We deliver wireless sensors and
          a platform that turns data into something useful for facility and
          space management.
        </p>
        <p class="footer-cvr">
          IoT Fabrikken ApS · CVR 39 11 03 93
        </p>
        <div class="mt-6">
          <span class="footer-eyebrow">Follow us</span>
          <div class="mt-2 flex gap-3">
            <a href={externalLinks.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="footer-social">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.22 8h4.56v14H.22V8zm7.4 0h4.37v1.92h.06c.61-1.15 2.1-2.36 4.32-2.36 4.62 0 5.47 3.04 5.47 7v7.44h-4.56V15.4c0-1.7-.03-3.88-2.37-3.88-2.37 0-2.73 1.85-2.73 3.76V22H7.62V8z"/>
              </svg>
            </a>
            <a href={externalLinks.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="footer-social">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.6 3.6 12 3.6 12 3.6s-7.6 0-9.4.5A3 3 0 0 0 .5 6.2 31.3 31.3 0 0 0 0 12a31.3 31.3 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.8.5 9.4.5 9.4.5s7.6 0 9.4-.5a3 3 0 0 0 2.1-2.1A31.3 31.3 0 0 0 24 12a31.3 31.3 0 0 0-.5-5.8zM9.6 15.5V8.5L15.8 12 9.6 15.5z"/>
              </svg>
            </a>
            <a href={externalLinks.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="footer-social">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.6-4-1.6-.5-1.4-1.3-1.8-1.3-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.3.5-2.3 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.7 1.7.3 2.9.1 3.2.8.9 1.2 1.9 1.2 3.2 0 4.6-2.8 5.7-5.5 6 .4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Column 2 — Locations -->
      <div class="text-sm text-white/80 leading-relaxed">
        <address class="not-italic">
          <span class="footer-eyebrow">Head office</span>
          Brønsager 1<br />
          4000 Roskilde<br />
          <span class="footer-block-last-line">Denmark</span>
        </address>
        <address class="not-italic">
          <span class="footer-eyebrow">Hub office</span>
          Nydamsvej 17<br />
          8362 Hørning<br />
          Denmark
        </address>
      </div>

      <!-- Column 3 — Contact & hours -->
      <div class="text-sm text-white/80 leading-relaxed">
        <div>
          <span class="footer-eyebrow">Opening hours</span>
          <ul class="mt-2 space-y-1">
            <li>Mon – Thu: 8:00 – 15:30</li>
            <li class="footer-block-last-line">Friday: Closed (Email support only)</li>
          </ul>
        </div>
        <div>
          <span class="footer-eyebrow">Contact</span>
          <ul class="mt-2 space-y-1">
            <li>
              <a href="tel:+4571718090" class="hover:text-coral-500 transition-colors">
                +45 71 71 80 90
              </a>
            </li>
            <li>
              <a href="mailto:info@iot-fabrikken.com" class="hover:text-coral-500 transition-colors">
                info@iot-fabrikken.com
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Bottom tier: link columns -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-10 pt-12">
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider text-white/60 mb-4">
          Product
        </h4>
        <ul class="text-sm">
          {productLinks.map((l) => (
            <li>
              <a href={l.href} class="footer-nav-link">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider text-white/60 mb-4">
          Solutions
        </h4>
        <ul class="text-sm">
          {solutionLinks.map((l) => (
            <li>
              <a href={l.href} class="footer-nav-link">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider text-white/60 mb-4">
          Resources
        </h4>
        <ul class="text-sm">
          {resourceLinks.map((l) => (
            <li>
              <a href={l.href} class="footer-nav-link">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider text-white/60 mb-4">
          Company
        </h4>
        <ul class="text-sm">
          {companyLinks.map((l) => (
            <li>
              <a href={l.href} class="footer-nav-link">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider text-white/60 mb-4">
          Support &amp; Legal
        </h4>
        <ul class="text-sm">
          {supportLegalLinks.map((l) => (
            <li>
              {l.external ? (
                <a
                  href={l.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="footer-nav-link"
                >
                  {l.label} ↗
                </a>
              ) : (
                <a href={l.href} class="footer-nav-link">
                  {l.label}
                </a>
              )}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-white/60">
      <p>© {year} IoT Fabrikken ApS. All rights reserved.</p>
      <div class="flex gap-6">
        <a href="/en/legal/privacy/" class="hover:text-white transition-colors">Privacy</a>
        <a href="/en/legal/cookies/" class="hover:text-white transition-colors">Cookies</a>
        <a href="/en/legal/terms/" class="hover:text-white transition-colors">Terms</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-eyebrow {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.5);
    margin-bottom: 0.375rem;
  }

  /* Extra space after the last line of a group before the next eyebrow */
  .footer-block-last-line {
    display: block;
    margin-bottom: 2rem;
  }

  /* Separate legal ID from marketing copy */
  .footer-cvr {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    font-size: 0.75rem;
    line-height: 1.5;
    color: rgb(255 255 255 / 0.6);
  }

  /* 44px minimum touch target (WCAG 2.5.5) for footer nav on mobile */
  .footer-nav-link {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    color: rgb(255 255 255 / 0.8);
    transition: color 150ms ease;
  }

  .footer-nav-link:hover {
    color: var(--color-coral-500);
  }

  .footer-social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.375rem;
    background-color: rgb(255 255 255 / 0.1);
    color: inherit;
    transition: background-color 150ms ease;
  }

  .footer-social:hover {
    background-color: var(--color-coral-500);
  }

  @media (min-width: 1024px) {
    .footer-nav-link {
      min-height: 2rem;
    }
  }
</style>
