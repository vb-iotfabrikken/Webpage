---
import { type Lang, defaultLang, langPath } from "../data/lang";
import { getHome, type FeaturedIndustrySlug } from "../data/i18n/home";
import { isLivePath } from "../data/launch";

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = getHome(lang).sensorFinder;

const featuredSlugs: readonly FeaturedIndustrySlug[] = [
  "offices",
  "churches",
  "museums-galleries",
  "municipalities",
];

const cardImages: Record<FeaturedIndustrySlug, { src: string; alt: string }> = {
  offices: {
    src: "/images/sensor-finder/offices.png",
    alt: "People collaborating in a bright modern open-plan office",
  },
  churches: {
    src: "/images/sensor-finder/property-management.png",
    alt: "Caretaker maintaining wooden pews inside a historic church building",
  },
  "museums-galleries": {
    src: "/images/sensor-finder/municipalities.png",
    alt: "Visitors viewing art in a museum gallery",
  },
  municipalities: {
    src: "/images/sensor-finder/schools.png",
    alt: "Students walking on a school campus in front of a brick school building",
  },
};

const useCases = featuredSlugs
  .map((slug) => {
    const card = t.cards[slug];
    const image = cardImages[slug];

    return {
      slug,
      title: card.title,
      description: card.description,
      href: langPath(`industries/${slug}`, lang),
      image: image.src,
      imageAlt: image.alt,
    };
  })
  // Soft-launch: industry pages are hidden, so drop cards that would 404.
  // The whole section disappears until those destinations go live.
  .filter((item) => isLivePath(item.href));
---

{useCases.length > 0 && (
<section class="pt-12 pb-16 md:pt-14 md:pb-20 bg-stone-50">
  <div class="container-page">
    <div class="reveal max-w-2xl mx-auto text-center mb-10 md:mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-navy-500 tracking-tight">
        {t.heading}
      </h2>
      <p class="mt-5 text-lg text-stone-900/70">
        {t.subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {useCases.map((item) => (
        <a
          href={item.href}
          class="reveal group flex flex-col h-full bg-white border border-stone-100 rounded-xl overflow-hidden hover:border-navy-500 hover:-translate-y-0.5 hover:shadow-md transition-all duration-300"
        >
          <div class="aspect-[4/3] overflow-hidden bg-stone-100">
            <img
              src={item.image}
              alt={item.imageAlt}
              width={640}
              height={480}
              class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.03]"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="flex flex-col flex-1 p-5 sm:p-6">
            <h3 class="text-lg font-semibold text-navy-500 mb-2">{item.title}</h3>
            <p class="text-sm text-stone-900/70 leading-relaxed flex-1">{item.description}</p>
            <span class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-sky-600 group-hover:text-coral-500 transition-colors">
              {t.ctaLabel}
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
                <path d="M4 10L10 4M10 4H5M10 4V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
)}
