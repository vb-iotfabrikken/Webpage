---
interface Props {
  title: string;
  titleAccent?: string;
  lead: string;
  align?: "center" | "left";
  /** Product line eyebrow shown above the H1 (enhanced product pages). */
  eyebrow?: string;
  /** Short spec chips rendered below the lead (enhanced product pages). */
  specs?: string[];
  /** Let the homepage hero visual extend past the hero width (fade, not clip). */
  allowVisualOverflow?: boolean;
  /** Tighter top padding so the text sits closer to the header. */
  compactTop?: boolean;
  /** Remove bottom padding so the next section's top edge sits flush against the hero. */
  compactBottom?: boolean;
  /** Keep titleAccent on the same line as the title (left-aligned heroes default to a block break). */
  inlineTitleAccent?: boolean;
  /** Render the visual slot on a white band below the grey title/CTA hero (standard split layout). */
  visualOnWhite?: boolean;
  /** Place title/lead/CTAs and the visual slot side-by-side in the grey band (article-style). */
  splitVisual?: boolean;
  /** Render the title band on a dark navy surface (like the footer) instead of grey. */
  dark?: boolean;
  /** Hide the decorative dot pattern in the title band. */
  noPattern?: boolean;
}

const {
  title,
  titleAccent,
  lead,
  align = "center",
  eyebrow,
  specs = [],
  allowVisualOverflow = false,
  compactTop = false,
  compactBottom = false,
  inlineTitleAccent = false,
  visualOnWhite = false,
  splitVisual = false,
  dark = false,
  noPattern = false,
} = Astro.props;

const hasVisual = Astro.slots.has("visual");
const hasBelowVisual = Astro.slots.has("belowVisual");
const visualInGreyBand = hasVisual && !visualOnWhite && !splitVisual;

const surfaceClass = dark
  ? "bg-navy-500 border-b border-navy-900"
  : "bg-stone-50 border-b border-stone-100";
const eyebrowClass = dark ? "text-coral-100" : "text-sky-600";
const titleClass = dark ? "text-white" : "text-navy-500";
const accentClass = dark ? "text-sky-100" : "text-sky-600";
const leadClass = dark ? "text-white/80" : "text-stone-900/70";
const chipClass = dark
  ? "border-white/20 bg-white/10 text-white"
  : "border-stone-200 bg-white text-navy-500";
const dotColor = dark ? "#FFFFFF" : "var(--color-navy-500)";
const dotOpacityClass = dark ? "opacity-[0.08]" : "opacity-[0.05]";

const containerPaddingClass = [
  compactTop ? "pt-6 md:pt-8" : "pt-16 md:pt-24",
  compactBottom && !visualOnWhite
    ? "pb-0"
    : visualOnWhite
      ? "pb-8 md:pb-10"
      : compactTop
        ? "pb-6 md:pb-8 xl:pb-10"
        : "pb-10 md:pb-14",
  align === "center" ? "text-center" : "text-left",
].join(" ");

const breadcrumbMarginClass = compactTop ? "mb-3 md:mb-4" : "mb-4 md:mb-6";
const leadMarginClass = compactTop ? "mt-4 md:mt-5 xl:mt-6" : "mt-6";
const ctaMarginClass = compactTop ? "mt-6 md:mt-7 xl:mt-8" : "mt-8";
const titleSizeClass = "text-4xl md:text-5xl xl:text-6xl";
const leadSizeClass = "text-base md:text-lg xl:text-xl";
---

<section
  data-page-hero
  data-compact-top={compactTop || undefined}
  data-compact-bottom={(compactBottom || visualOnWhite) || undefined}
  class:list={[
    "relative",
    surfaceClass,
    allowVisualOverflow ? "overflow-x-clip overflow-y-visible" : "overflow-hidden",
  ]}
>
  {!noPattern && (
    <div class:list={["absolute inset-0 pointer-events-none", dotOpacityClass]} aria-hidden="true">
      <div class="w-full h-full" style={`background-image: radial-gradient(${dotColor} 1px, transparent 1px); background-size: 28px 28px;`}></div>
    </div>
  )}

  <div class={`relative container-page ${containerPaddingClass}`}>
    {Astro.slots.has("breadcrumb") && (
      <nav class:list={["reveal", breadcrumbMarginClass]} aria-label="Breadcrumb">
        <slot name="breadcrumb" />
      </nav>
    )}

    {splitVisual && hasVisual ? (
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 lg:gap-10 items-center">
        <div class="lg:col-span-7 max-w-3xl">
          {eyebrow && (
            <p class:list={["reveal mb-3 text-sm font-semibold uppercase tracking-wider", eyebrowClass]}>
              {eyebrow}
            </p>
          )}
          <h1 class:list={["reveal font-bold leading-[1.05] tracking-tight", titleSizeClass, titleClass]}>
            {title}
            {titleAccent && (
              <span
                class:list={[
                  accentClass,
                  align === "left" && !inlineTitleAccent && "block mt-1 md:mt-2",
                ]}
              >
                {align === "center" || inlineTitleAccent ? ` ${titleAccent}` : titleAccent}
              </span>
            )}
          </h1>
          <p class:list={["reveal hero-lead leading-relaxed", leadMarginClass, leadSizeClass, leadClass]}>
            {lead}
          </p>
          {specs.length > 0 && (
            <ul class="reveal mt-5 flex flex-wrap gap-2" aria-label="Key specifications">
              {specs.map((chip) => (
                <li class:list={["rounded-md border px-3 py-1.5 text-sm font-medium", chipClass]}>
                  {chip}
                </li>
              ))}
            </ul>
          )}
          {Astro.slots.has("cta") && (
            <div class:list={["reveal hero-cta flex flex-wrap gap-3", ctaMarginClass]}>
              <slot name="cta" />
            </div>
          )}
          {Astro.slots.has("belowCta") && (
            <div class="reveal mt-4">
              <slot name="belowCta" />
            </div>
          )}
        </div>
        <div class="lg:col-span-5 reveal w-full max-lg:pt-2">
          <slot name="visual" />
        </div>
      </div>
    ) : (
      <div class={align === "center" ? "max-w-3xl mx-auto" : "max-w-3xl"}>
        {eyebrow && (
          <p class:list={["reveal mb-3 text-sm font-semibold uppercase tracking-wider", eyebrowClass]}>
            {eyebrow}
          </p>
        )}
        <h1 class:list={["reveal font-bold leading-[1.05] tracking-tight", titleSizeClass, titleClass]}>
          {title}
          {titleAccent && (
            <span
              class:list={[
                accentClass,
                align === "left" && !inlineTitleAccent && "block mt-1 md:mt-2",
              ]}
            >
              {align === "center" || inlineTitleAccent ? ` ${titleAccent}` : titleAccent}
            </span>
          )}
        </h1>
        <p class:list={["reveal hero-lead leading-relaxed", leadMarginClass, leadSizeClass, leadClass]}>
          {lead}
        </p>
        {specs.length > 0 && (
          <ul
            class={`reveal mt-5 flex flex-wrap gap-2 ${align === "center" ? "justify-center" : ""}`}
            aria-label="Key specifications"
          >
            {specs.map((chip) => (
              <li class:list={["rounded-md border px-3 py-1.5 text-sm font-medium", chipClass]}>
                {chip}
              </li>
            ))}
          </ul>
        )}
        {Astro.slots.has("cta") && (
          <div
            class:list={[
              "reveal hero-cta flex flex-wrap gap-3",
              ctaMarginClass,
              align === "center" && "justify-center",
            ]}
          >
            <slot name="cta" />
          </div>
        )}
        {Astro.slots.has("belowCta") && (
          <div class={`reveal mt-4 ${align === "center" ? "text-center" : ""}`}>
            <slot name="belowCta" />
          </div>
        )}
      </div>
    )}

    {visualInGreyBand && (
      <div class={compactTop ? "mt-4 md:mt-6" : "mt-12 md:mt-16"}>
        <slot name="visual" />
      </div>
    )}
  </div>
</section>

{
  (hasVisual || hasBelowVisual) && visualOnWhite && (
    <section class="bg-white border-b border-stone-100">
      <div
        class:list={[
          "container-page pt-8 md:pt-10",
          hasBelowVisual ? "pb-12 md:pb-16" : "pb-0",
        ]}
      >
        {hasVisual && <slot name="visual" />}
        {hasBelowVisual && (
          <div class:list={[hasVisual && "mt-8 md:mt-10"]}>
            <slot name="belowVisual" />
          </div>
        )}
      </div>
    </section>
  )
}
