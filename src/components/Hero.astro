---
interface Props {
  eyebrow?: string;
  title: string;
  titleAccent?: string;
  lead: string;
  align?: "center" | "left";
}

const { eyebrow, title, titleAccent, lead, align = "center" } = Astro.props;
---

<section class="relative overflow-hidden bg-stone-50 border-b border-stone-100">
  <div class="absolute inset-0 pointer-events-none opacity-[0.05]" aria-hidden="true">
    <div class="w-full h-full" style="background-image: radial-gradient(var(--color-navy-500) 1px, transparent 1px); background-size: 28px 28px;"></div>
  </div>

  <div class={`relative container-page pt-16 md:pt-24 pb-10 md:pb-14 ${align === "center" ? "text-center" : "text-left"}`}>
    <div class={align === "center" ? "max-w-3xl mx-auto" : "max-w-3xl"}>
      {eyebrow && (
        <p class="reveal inline-block px-3 py-1 rounded-md bg-stone-100 text-navy-500 text-xs font-semibold uppercase tracking-wider mb-6">
          {eyebrow}
        </p>
      )}
      <h1 class="reveal text-4xl md:text-6xl font-bold leading-[1.05] tracking-tight text-navy-500">
        {title}
        {titleAccent && (
          <span class="text-sky-600"> {titleAccent}</span>
        )}
      </h1>
      <p class="reveal mt-6 text-lg md:text-xl text-stone-900/70 leading-relaxed">
        {lead}
      </p>
      <div class={`reveal mt-8 flex flex-wrap gap-3 ${align === "center" ? "justify-center" : ""}`}>
        <slot name="cta" />
      </div>
    </div>

    <div class="mt-12 md:mt-16">
      <slot name="visual" />
    </div>
  </div>
</section>
