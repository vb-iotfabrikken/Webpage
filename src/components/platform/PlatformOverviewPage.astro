---
import Layout from "../../layouts/Layout.astro";
import Hero from "../Hero.astro";
import Button from "../Button.astro";
import CtaBand from "../CtaBand.astro";
import type { Hub } from "../../data/hubs/types";
import type { PlatformSection } from "../../data/content/types";
import { getAbout } from "../../data/i18n/about";
import { astroLang, langPath, type Lang } from "../../data/lang";

interface Breadcrumb {
  label: string;
  href?: string;
}

export interface PlatformTopic {
  slug: string;
  title: string;
  titleAccent?: string;
  lead: string;
  sections: PlatformSection[];
}

interface Props {
  hub: Hub;
  topics: PlatformTopic[];
  breadcrumbs?: Breadcrumb[];
  lang?: Lang;
}

const { hub, topics, breadcrumbs = [], lang: langProp } = Astro.props;

const lang = langProp ?? astroLang(Astro);
const t = getAbout(lang);
const pageTitle = `${hub.title.replace(/\.$/, "")} | IoT Fabrikken`;
const bookDemoHref = langPath("contact/book-demo", lang);
const contactSalesHref = langPath("contact/sales", lang);
---

<Layout title={pageTitle} description={hub.lead}>
  {breadcrumbs.length > 0 && (
    <nav class="container-page pt-6" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-1.5 text-sm text-stone-300">
        {breadcrumbs.map((b, i) => (
          <li class="flex items-center gap-1.5">
            {b.href ? (
              <a href={b.href} class="hover:text-coral-500 transition-colors">{b.label}</a>
            ) : (
              <span class="text-navy-500">{b.label}</span>
            )}
            {i < breadcrumbs.length - 1 && (
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M4.5 3L7.5 6L4.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )}

  <Hero
    title={hub.title}
    titleAccent={hub.titleAccent}
    lead={hub.lead}
    align="left"
    compactTop={breadcrumbs.length > 0}
  >
    <Button href={bookDemoHref} variant="primary" size="lg" slot="cta">{t.common.bookDemo}</Button>
    <Button href={contactSalesHref} variant="secondary" size="lg" slot="cta">{t.common.contactSales}</Button>

    {topics.length > 0 && (
      <div slot="visual" class="reveal">
        <div class="bg-white border border-stone-100 rounded-xl p-6 md:p-8 max-w-md">
          <p class="text-xs font-semibold uppercase tracking-wider text-stone-300">On this page</p>
          <ul class="mt-3 space-y-2 text-sm">
            {topics.map((topic) => (
              <li>
                <a
                  href={`#${topic.slug}`}
                  class="text-navy-500 hover:text-coral-500 underline-offset-4 hover:underline transition-colors"
                >
                  {topic.title.replace(/\.$/, "")}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    )}
  </Hero>

  <section class="py-14 md:py-16">
    <div class="container-page max-w-3xl">
      <div class="divide-y divide-stone-100 border-y border-stone-100">
        {topics.map((topic) => (
          <details
            id={topic.slug}
            class="group py-5 reveal scroll-mt-24"
            data-platform-topic={topic.slug}
          >
            <summary class="flex items-start justify-between cursor-pointer list-none gap-6">
              <span>
                <span class="block text-lg font-medium text-navy-500">{topic.title}</span>
                {topic.titleAccent && (
                  <span class="block text-sm font-medium text-sky-600 mt-1">{topic.titleAccent}</span>
                )}
              </span>
              <span class="shrink-0 w-8 h-8 inline-flex items-center justify-center rounded-md border border-stone-100 text-navy-500 transition-transform group-open:rotate-45 mt-0.5">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M7 2v10M2 7h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
              </span>
            </summary>
            <div class="mt-5 pr-0 md:pr-12 space-y-10 md:space-y-12">
              <p class="text-stone-900/80 leading-relaxed">{topic.lead}</p>
              {topic.sections.map((section) => (
                <div>
                  {section.heading && (
                    <h2 class="text-xl md:text-2xl font-bold text-navy-500 tracking-tight mb-4">
                      {section.heading}
                    </h2>
                  )}
                  {section.paragraphs?.map((paragraph) => (
                    <p class="text-stone-900/80 leading-relaxed mb-4 last:mb-0">{paragraph}</p>
                  ))}
                  {section.listIntro && (
                    <p class="text-stone-900/80 leading-relaxed mb-4">{section.listIntro}</p>
                  )}
                  {section.list && section.list.length > 0 && (
                    <ul class="mt-4 space-y-3">
                      {section.list.map((item) => (
                        <li class="flex items-start gap-3 text-navy-500">
                          <span class="mt-1.5 w-2 h-2 rounded-full bg-sky-500 shrink-0" aria-hidden="true"></span>
                          <span class="leading-relaxed">{item}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              ))}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    title={t.hub.ctaTitle}
    subtitle={t.hub.ctaSubtitle}
    primaryLabel={t.common.bookDemo}
    primaryHref={bookDemoHref}
    secondaryLabel={t.common.contactSales}
    secondaryHref={contactSalesHref}
  />
</Layout>

<script>
  function openPlatformTopicFromHash() {
    const hash = window.location.hash.replace(/^#/, "");
    if (!hash) return;

    const target = document.querySelector<HTMLDetailsElement>(
      `[data-platform-topic="${hash}"]`,
    );
    if (!target) return;

    target.open = true;
    target.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  openPlatformTopicFromHash();
  window.addEventListener("hashchange", openPlatformTopicFromHash);
</script>
