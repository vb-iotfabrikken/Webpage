---
interface Step {
  n: string;
  title: string;
  body: string;
}

interface Props {
  eyebrow: string;
  heading: string;
  steps: Step[];
}

const { eyebrow, heading, steps } = Astro.props;
---

<div>
  <div class="max-w-2xl mb-12">
    <p class="inline-block px-3 py-1 rounded-md bg-stone-100 text-navy-500 text-xs font-semibold uppercase tracking-wider mb-5">
      {eyebrow}
    </p>
    <h2 class="text-3xl md:text-4xl font-bold text-navy-500 tracking-tight">{heading}</h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {
      steps.map((step) => (
        <div class="relative rounded-xl border border-stone-100 bg-stone-50 p-6 md:p-8">
          <span class="text-5xl font-bold text-stone-200 block leading-none">{step.n}</span>
          <h3 class="mt-4 text-xl font-semibold text-navy-500">{step.title}</h3>
          <p class="mt-2 text-stone-900/70 leading-relaxed">{step.body}</p>
        </div>
      ))
    }
  </div>
</div>
