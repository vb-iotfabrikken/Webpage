---
import Layout from "../layouts/Layout.astro";
import Hero from "./Hero.astro";
import Button from "./Button.astro";
import CtaBand from "./CtaBand.astro";

interface Breadcrumb {
  label: string;
  href?: string;
}

interface Cta {
  label: string;
  href: string;
}

interface Props {
  title: string;
  description?: string;
  heroTitle: string;
  heroTitleAccent?: string;
  heroLead: string;
  breadcrumbs?: Breadcrumb[];
  primaryCta?: Cta;
  secondaryCta?: Cta;
  /** Hide the "Content on the way" notice (useful when a page already has real content). */
  hideNotice?: boolean;
  /** Hide hero and bottom-band Book demo / Contact sales buttons. */
  showCtas?: boolean;
  ctaBandTitle?: string;
  ctaBandSubtitle?: string;
}

const {
  title,
  description,
  heroTitle,
  heroTitleAccent,
  heroLead,
  breadcrumbs = [],
  primaryCta = { label: "Book a free demo", href: "/en/contact/book-demo/" },
  secondaryCta = { label: "Contact sales", href: "/en/contact/sales/" },
  hideNotice = false,
  showCtas = true,
  ctaBandTitle = "Want to know more already now?",
  ctaBandSubtitle = "Get in touch — we're always happy to have a no-strings chat.",
} = Astro.props;
---

<Layout title={title} description={description ?? heroLead}>
  {breadcrumbs.length > 0 && (
    <nav class="container-page pt-6" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-1.5 text-sm text-stone-300">
        {breadcrumbs.map((b, i) => (
          <li class="flex items-center gap-1.5">
            {b.href ? (
              <a href={b.href} class="hover:text-coral-500 transition-colors">{b.label}</a>
            ) : (
              <span class="text-navy-500">{b.label}</span>
            )}
            {i < breadcrumbs.length - 1 && (
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M4.5 3L7.5 6L4.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )}

  <Hero
    title={heroTitle}
    titleAccent={heroTitleAccent}
    lead={heroLead}
    align="left"
    compactTop={breadcrumbs.length > 0}
  >
    {showCtas && (
      <>
        <Button href={primaryCta.href} variant="primary" size="lg" slot="cta">{primaryCta.label}</Button>
        <Button href={secondaryCta.href} variant="secondary" size="lg" slot="cta">{secondaryCta.label}</Button>
      </>
    )}

    {!hideNotice && (
      <div slot="visual" class="reveal">
        <div class="bg-white border border-stone-100 rounded-xl p-10 md:p-14 text-center max-w-3xl">
          <div class="inline-flex w-14 h-14 rounded-md bg-sky-50 text-sky-600 items-center justify-center mb-4">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-navy-500">Content for this page is on its way</h3>
          <p class="mt-3 text-stone-900/70 max-w-md mx-auto">
            We're busy putting together content, cases and screenshots. Reach out already now if you'd like to hear more.
          </p>
        </div>
      </div>
    )}
  </Hero>

  <section class="py-16">
    <div class="container-page">
      <div class="max-w-3xl">
        <slot />
      </div>
    </div>
  </section>

  {showCtas && (
    <CtaBand
      title={ctaBandTitle}
      subtitle={ctaBandSubtitle}
      primaryLabel="Book a free demo"
      primaryHref={primaryCta.href}
      secondaryLabel="Contact sales"
      secondaryHref={secondaryCta.href}
    />
  )}
</Layout>
