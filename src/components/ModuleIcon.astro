---
/**
 * Tiny, consistent line icon per module slug — used in the header
 * dropdown under "Modules". Shares its visual language (20x20 viewBox,
 * 1.75 stroke, rounded line caps) with IndustryIcon so Modules and
 * Industries feel like one family inside the mega menu.
 */

interface Props {
  slug: string;
  class?: string;
}

const { slug, class: className = "" } = Astro.props;

const common = {
  width: 20,
  height: 20,
  viewBox: "0 0 24 24",
  fill: "none",
  stroke: "currentColor",
  "stroke-width": 1.75,
  "stroke-linecap": "round" as const,
  "stroke-linejoin": "round" as const,
};
---

{slug === "indoor-climate" && (
  <svg {...common} class={className} aria-hidden="true">
    <path d="M14 4a2 2 0 0 0-4 0v10.54a4 4 0 1 0 4 0z" />
    <line x1="12" y1="9" x2="12" y2="15" />
  </svg>
)}

{slug === "space-management" && (
  <svg {...common} class={className} aria-hidden="true">
    <rect x="3" y="3" width="7" height="9" rx="1" />
    <rect x="14" y="3" width="7" height="5" rx="1" />
    <rect x="14" y="12" width="7" height="9" rx="1" />
    <rect x="3" y="16" width="7" height="5" rx="1" />
  </svg>
)}

{slug === "water-detection" && (
  <svg {...common} class={className} aria-hidden="true">
    <path d="M12 2.5C13.5 5 17 8.5 17 12a5 5 0 1 1-10 0c0-3.5 3.5-7 5-9.5z" />
    <path d="M9.5 12a2.5 2.5 0 0 0 2.5 2.5" />
  </svg>
)}

{slug === "preservation" && (
  <svg {...common} class={className} aria-hidden="true">
    <path d="M12 3l8 3v5c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-3z" />
    <path d="M9 12l2 2 4-4" />
  </svg>
)}

{slug === "usage-cleaning" && (
  <svg {...common} class={className} aria-hidden="true">
    <path d="M12 3l1.6 3.4L17 8l-3.4 1.6L12 13l-1.6-3.4L7 8l3.4-1.6L12 3z" />
    <path d="M18 14l.9 1.9L21 17l-2.1.9L18 20l-.9-2.1L15 17l2.1-1 .9-2z" />
    <path d="M5 14l.7 1.5L7 16l-1.3.5L5 18l-.7-1.5L3 16l1.3-.5L5 14z" />
  </svg>
)}

{slug === "push-buttons" && (
  <svg {...common} class={className} aria-hidden="true">
    <circle cx="12" cy="12" r="8.5" />
    <circle cx="12" cy="12" r="3.5" />
    <path d="M12 1.5v2M12 20.5v2M1.5 12h2M20.5 12h2" />
  </svg>
)}

{slug === "lockers-doors" && (
  <svg {...common} class={className} aria-hidden="true">
    <rect x="5" y="3" width="14" height="18" rx="1" />
    <line x1="5" y1="12" x2="19" y2="12" />
    <circle cx="15.5" cy="8" r="0.6" fill="currentColor" stroke="none" />
    <circle cx="15.5" cy="16" r="0.6" fill="currentColor" stroke="none" />
  </svg>
)}

