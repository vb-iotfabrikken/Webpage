---
import { locales, getLangFromPath, switchLocalePath } from "../data/lang";

interface Props {
  /** Visual density — utility bar vs main header / mobile menu. */
  variant?: "compact" | "default";
}

const { variant = "default" } = Astro.props;
const currentLang = getLangFromPath(Astro.url.pathname);
const isCompact = variant === "compact";
---

<nav
  class:list={[
    "language-switcher",
    isCompact ? "language-switcher--compact" : "language-switcher--default",
  ]}
  aria-label="Language"
>
  <ul class="language-switcher__list" role="list">
    {
      locales.map((locale) => {
        const href = switchLocalePath(Astro.url.pathname, locale.code);
        const isActive = locale.code === currentLang;
        return (
          <li>
            {isActive ? (
              <span
                class="language-switcher__item language-switcher__item--active"
                aria-current="true"
                title={locale.name}
              >
                {locale.label}
              </span>
            ) : (
              <a
                href={href}
                class="language-switcher__item"
                hreflang={locale.code}
                lang={locale.code}
                title={locale.name}
              >
                {locale.label}
              </a>
            )}
          </li>
        );
      })
    }
  </ul>
</nav>

<style>
  .language-switcher__list {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
    border-radius: 0.375rem;
    border: 1px solid var(--color-stone-200);
    background: var(--color-stone-50);
    padding: 2px;
  }

  .language-switcher--compact .language-switcher__list {
    border-color: rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.08);
  }

  .language-switcher__item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2rem;
    padding: 0.125rem 0.5rem;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1.25rem;
    border-radius: 0.25rem;
    color: var(--color-stone-400);
    text-decoration: none;
    transition:
      color 160ms ease,
      background-color 160ms ease;
  }

  .language-switcher--compact .language-switcher__item {
    color: rgba(255, 255, 255, 0.65);
  }

  .language-switcher__item:hover {
    color: var(--color-navy-500);
    background: rgba(255, 255, 255, 0.9);
  }

  .language-switcher--compact .language-switcher__item:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.14);
  }

  .language-switcher__item--active,
  .language-switcher__item--active:hover {
    color: var(--color-navy-500);
    background: #fff;
    cursor: default;
  }

  .language-switcher--compact .language-switcher__item--active,
  .language-switcher--compact .language-switcher__item--active:hover {
    color: var(--color-navy-500);
    background: #fff;
  }
</style>
