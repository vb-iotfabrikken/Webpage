---
import UspIcon, { type UspIconName } from "./UspIcon.astro";
import { type Lang, defaultLang } from "../data/lang";
import { getHome } from "../data/i18n/home";

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = getHome(lang).usp;

const uspImage = {
  src: "/images/usp-assembly-team.png",
  alt: "IoT Fabrikken team members preparing and quality-checking sensors at the assembly bench",
};

// Icons are presentation, so they live here and zip onto the translated copy.
const icons: UspIconName[] = ["battery", "message", "check", "bell"];
const usps = t.items.map((item, i) => ({ ...item, icon: icons[i] ?? "check" }));

const uspCardClass =
  "reveal bg-white border border-stone-100 rounded-xl p-5 sm:p-6 select-none pointer-events-none";
---

<section class="pt-14 md:pt-20 pb-12 md:pb-14 bg-stone-50">
  <div class="container-page">
    <div class="reveal max-w-2xl mb-10 md:mb-12">
      <h2 class="text-3xl md:text-5xl font-bold text-navy-500 tracking-tight">
        {t.heading}
      </h2>

      <p class="mt-5 text-lg text-stone-900/70 leading-relaxed">
        {t.intro}
      </p>
    </div>

    <div class="relative max-w-5xl mx-auto">
      <div
        class="hidden sm:block absolute top-8 -left-3 w-[42%] max-w-[11rem] h-[calc(100%-2rem)] rounded-2xl bg-sky-100/80 -z-10"
        aria-hidden="true"
      ></div>

      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[minmax(9.5rem,12.5rem)_1fr_1fr] gap-4 lg:gap-5 items-stretch"
      >
        <figure class="reveal m-0 sm:row-span-2 flex flex-col max-w-[13rem] sm:max-w-none mx-auto sm:mx-0 w-full">
          <div class="flex-1 min-h-[11rem] sm:min-h-0 rounded-xl overflow-hidden border border-stone-100 bg-white shadow-sm">
            <img
              src={uspImage.src}
              alt={uspImage.alt}
              width={400}
              height={500}
              class="w-full h-full min-h-[11rem] sm:min-h-full object-cover object-[center_20%]"
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class="mt-2.5 text-[11px] sm:text-xs text-stone-900/60 leading-snug">
            {t.figcaption}
          </figcaption>
        </figure>

        <div class="contents">
          {usps.map((u) => (
            <article class={uspCardClass}>
              <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-md bg-sky-50 text-sky-600 inline-flex items-center justify-center mb-3 sm:mb-4" aria-hidden="true">
                <UspIcon name={u.icon} />
              </div>
              <h3 class="text-base sm:text-lg font-semibold text-navy-500 mb-1.5 sm:mb-2">{u.title}</h3>
              <p class="text-sm text-stone-900/70 leading-relaxed">{u.body}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
