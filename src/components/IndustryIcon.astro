---
/**
 * Tiny, consistent line icon per industry slug — used in the header
 * dropdown to break up the text-heavy Industries list. All icons share
 * the same 24x24 viewBox and 1.75 stroke so they read as a family.
 */

interface Props {
  slug: string;
  class?: string;
}

const { slug, class: className = "" } = Astro.props;

const common = {
  width: 20,
  height: 20,
  viewBox: "0 0 24 24",
  fill: "none",
  stroke: "currentColor",
  "stroke-width": 1.75,
  "stroke-linecap": "round" as const,
  "stroke-linejoin": "round" as const,
};
---

{slug === "offices" && (
  <svg {...common} class={className} aria-hidden="true">
    <rect x="3" y="3" width="18" height="18" rx="1.5" />
    <path d="M3 9h18M3 15h18M9 3v18M15 3v18" />
  </svg>
)}

{slug === "schools" && (
  <svg {...common} class={className} aria-hidden="true">
    <path d="M2 10l10-5 10 5-10 5L2 10z" />
    <path d="M6 12v4c0 1.5 3 3 6 3s6-1.5 6-3v-4" />
    <line x1="22" y1="10" x2="22" y2="16" />
  </svg>
)}

{slug === "hospitals" && (
  <svg {...common} class={className} aria-hidden="true">
    <rect x="4" y="4" width="16" height="17" rx="1.5" />
    <path d="M12 9v6M9 12h6" />
    <path d="M8 4v3M16 4v3" />
  </svg>
)}

{slug === "museums-galleries" && (
  <svg {...common} class={className} aria-hidden="true">
    <path d="M3 9l9-6 9 6" />
    <path d="M5 9v11M19 9v11M3 20h18" />
    <path d="M9 13v4M12 13v4M15 13v4" />
  </svg>
)}

{slug === "churches" && (
