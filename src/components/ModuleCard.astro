---
import type { Module } from "../data/modules";
interface Props {
  module: Module;
}
const { module: m } = Astro.props;

const accentBar = {
  coral: "bg-sky-500",
  sky: "bg-sky-500",
  navy: "bg-navy-500",
  forest: "bg-forest-500",
}[m.color];

const iconBg = {
  coral: "bg-sky-50 text-sky-600",
  sky: "bg-sky-50 text-sky-600",
  navy: "bg-stone-100 text-navy-500",
  forest: "bg-forest-50 text-forest-500",
}[m.color];
---

<a
  href={m.href}
  class="reveal group relative flex flex-col h-full p-6 md:p-7 bg-white border border-stone-100 rounded-xl hover:border-navy-500 hover:-translate-y-1 hover:shadow-lg transition-all duration-300"
>
  <div class={`absolute top-0 left-0 right-0 h-1 rounded-t-xl ${accentBar}`}></div>

  <div class={`w-10 h-10 rounded-md inline-flex items-center justify-center mb-5 ${iconBg}`}>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="3" width="18" height="18" rx="2" />
      <path d="M3 9h18M9 21V9" />
    </svg>
  </div>

  <h3 class="text-lg font-semibold text-navy-500 mb-2">{m.navn}</h3>
  <p class="text-sm text-stone-900/70 leading-relaxed flex-1">{m.kort}</p>

  <div class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-navy-500 group-hover:text-sky-600 transition-colors">
    Læs mere
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="transition-transform group-hover:translate-x-1">
      <path d="M3 7h8M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </div>
</a>
