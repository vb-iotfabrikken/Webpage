---
import Layout from "../layouts/Layout.astro";
import Hero from "./Hero.astro";
import Button from "./Button.astro";
import CtaBand from "./CtaBand.astro";
import CaseStudyGrid from "./CaseStudyGrid.astro";
import { getCaseStudiesContent } from "../data/hubs/caseStudies";
import { getCases } from "../data/i18n/cases";
import { langPath, type Lang } from "../data/lang";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { hub, cases, initialVisible } = getCaseStudiesContent(lang);
const basePath = langPath("case-studies", lang);
const t = getCases(lang);
---

<Layout title={t.metaTitle} description={t.metaDescription}>
  <nav class="container-page pt-6" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-1.5 text-sm text-stone-300">
      <li>
        <a href={langPath("", lang)} class="hover:text-coral-500 transition-colors">{t.breadcrumbHome}</a>
      </li>
      <li aria-hidden="true">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
          <path
            d="M4.5 3L7.5 6L4.5 9"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </li>
      <li><span class="text-navy-500">{t.breadcrumbCases}</span></li>
    </ol>
  </nav>

  <Hero title={hub.title} titleAccent={hub.titleAccent} lead={hub.lead} align="left" compactTop>
    <Button href={langPath("contact/book-demo", lang)} variant="primary" size="lg" slot="cta">
      {t.bookDemo}
    </Button>
  </Hero>

  <section class="py-14 md:py-20">
    <div class="container-page">
      <CaseStudyGrid
        cases={cases}
        basePath={basePath}
        lang={lang}
        initialVisible={initialVisible}
      />
    </div>
  </section>

  <CtaBand
    title={t.contactTitle}
    subtitle={t.contactSubtitle}
    primaryLabel={t.bookDemo}
    primaryHref={langPath("contact/book-demo", lang)}
    secondaryLabel={t.contactSales}
    secondaryHref={langPath("contact/sales", lang)}
  />
</Layout>
