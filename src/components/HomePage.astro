---
import Layout from "../layouts/Layout.astro";
import Hero from "./Hero.astro";
import HeroAnimation from "./HeroAnimation.astro";
import Button from "./Button.astro";
import LogoMarquee from "./LogoMarquee.astro";
import StatBlock from "./StatBlock.astro";
import CtaBand from "./CtaBand.astro";
import UspSection from "./UspSection.astro";
import SensorFinderSection from "./SensorFinderSection.astro";
import { type Lang, defaultLang, langPath } from "../data/lang";
import { getHome } from "../data/i18n/home";
import { heroBackdropImage } from "../data/heroImages";

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = getHome(lang);

const bookDemoHref = langPath("contact/book-demo", lang);
const salesHref = langPath("contact/sales", lang);

const stats = [
  { value: "55.000", prefix: "+", label: t.stats.labels[0] },
  { value: "15", prefix: "+", suffix: t.stats.millionSuffix, label: t.stats.labels[1] },
  { value: "16", prefix: "+", label: t.stats.labels[2] },
];
---

<Layout title={t.meta.title} description={t.meta.description}>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroBackdropImage.src}
    type="image/webp"
    fetchpriority="high"
  />
  <Hero
    title={t.hero.title}
    titleAccent={t.hero.titleAccent}
    lead={t.hero.lead}
    allowVisualOverflow
    compactTop
    compactBottom
  >
    <Button href={bookDemoHref} variant="primary" size="lg" slot="cta">{t.hero.ctaPrimary}</Button>
    <Button href={salesHref} variant="secondary" size="lg" slot="cta">{t.hero.ctaSecondary}</Button>

    <div slot="visual" class="overflow-visible">
      <HeroAnimation lang={lang} />
    </div>
  </Hero>

  <LogoMarquee caption={t.logoMarquee.caption} />

  <UspSection lang={lang} />

  <StatBlock title={t.stats.title} subtitle={t.stats.subtitle} stats={stats} />

  <SensorFinderSection lang={lang} />

  <CtaBand
    variant="featured"
    title={t.cta.title}
    subtitle={t.cta.subtitle}
    primaryLabel={t.cta.primary}
    primaryHref={bookDemoHref}
    secondaryLabel={t.cta.secondary}
    secondaryHref={salesHref}
  />
</Layout>
