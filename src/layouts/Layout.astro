---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { locales, getLangFromPath, switchLocalePath, isIndexedLocale } from "../data/lang";
import { DEFAULT_OG_IMAGE, SITE_NAME, organizationSchema, websiteSchema } from "../lib/seo/config";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article";
  /** Mark the page as noindex (still followable) — e.g. drafts, thin pages. */
  noindex?: boolean;
  /** Canonical override (site-relative or absolute). Defaults to the current URL. */
  canonicalPath?: string;
  /** One or more JSON-LD objects rendered into <head> for this page. */
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  /** Article timestamps for og:article meta. */
  publishedTime?: string;
  modifiedTime?: string;
  /** Remove the default gap above the site footer. */
  flushFooter?: boolean;
}

const {
  title = "IoT Fabrikken — Sensors and platform for facility and space management",
  description = "Wireless sensors and a Danish-built SaaS platform for indoor climate, space management and water-leak detection. Plug and play, long battery life and no installation.",
  ogImage = DEFAULT_OG_IMAGE,
  ogImageAlt = SITE_NAME,
  ogType = "website",
  noindex = false,
  canonicalPath,
  jsonLd,
  publishedTime,
  modifiedTime,
  flushFooter = false,
} = Astro.props;

const siteOrigin = Astro.site ?? "https://iot-fabrikken.com";
const canonical = new URL(canonicalPath ?? Astro.url.pathname, siteOrigin);
const ogImageUrl = new URL(ogImage, siteOrigin).toString();

const currentLang = getLangFromPath(Astro.url.pathname);

// English-first: keep untranslated locales (those still serving English via
// the i18n fallback) out of the index until their translations ship.
const robotsNoindex = noindex || !isIndexedLocale(currentLang);

// BCP-47 / Open Graph locale tags per supported language.
const ogLocaleByLang = {
  en: "en_US",
  da: "da_DK",
  de: "de_DE",
  sv: "sv_SE",
} as const;

// hreflang alternates — only locales that are genuinely translated, plus
// x-default → English. Advertising untranslated locales would point search
// engines at duplicate English content.
const alternates = locales
  .filter((l) => isIndexedLocale(l.code))
  .map((l) => ({
    hreflang: l.code,
    href: new URL(switchLocalePath(Astro.url.pathname, l.code), siteOrigin).toString(),
  }));
const xDefaultHref = new URL(switchLocalePath(Astro.url.pathname, "en"), siteOrigin).toString();

// Global structured data emitted on every page, plus any page-specific nodes.
const globalJsonLd = [organizationSchema(), websiteSchema()];
const pageJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang={currentLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <meta name="theme-color" content="#0a1f44" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.toString()} />
    {robotsNoindex && <meta name="robots" content="noindex,follow" />}

    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={ogLocaleByLang[currentLang]} />
    {alternates
      .filter((alt) => alt.hreflang !== currentLang)
      .map((alt) => (
        <meta property="og:locale:alternate" content={ogLocaleByLang[alt.hreflang as keyof typeof ogLocaleByLang]} />
      ))}
    {ogType === "article" && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === "article" && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {globalJsonLd.map((node) => (
      <script type="application/ld+json" set:html={JSON.stringify(node)} />
    ))}
    {pageJsonLd.map((node) => (
      <script type="application/ld+json" set:html={JSON.stringify(node)} />
    ))}

    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex flex-1 flex-col">
      <slot />
    </main>
    <Footer flushTop={flushFooter} />

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
      );
      document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
