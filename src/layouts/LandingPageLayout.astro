---
import Layout from "./Layout.astro";
import Button from "../components/Button.astro";
import CtaBand from "../components/CtaBand.astro";
import ModuleFaqSection from "../components/modules/ModuleFaqSection.astro";
import { moduleFaqContext } from "../data/moduleFaqImages";
import { getUi } from "../data/i18n/ui";
import ArticleCard from "../components/articles/ArticleCard.astro";
import ArticleImage from "../components/articles/ArticleImage.astro";
import type { ArticleCard as ArticleCardModel } from "../data/articles/query";
import type { ArticlePageData } from "../data/articles/articlePage";
import { landingCategories, categoryColorClasses } from "../data/landingCategories";
import { getIndustriesHub } from "../data/hubs/industries";
import { breadcrumbSchema, faqSchema, webPageSchema } from "../lib/seo/schema";
import {
  articlePath,
  articlesIndexPath,
  astroLang,
  langPath,
  localizeCta,
} from "../data/lang";

interface Props {
  article: ArticlePageData;
  relatedCards?: ArticleCardModel[];
}

const { article, relatedCards = [] } = Astro.props;
const d = article;
const lang = astroLang(Astro);
const ui = getUi(lang);

const category = landingCategories[d.category];
const cat = categoryColorClasses(category.color);

const primaryCta = localizeCta(
  d.primaryCta ?? { label: "Book a free demo", href: langPath("contact/book-demo", lang) },
  lang,
);
const secondaryCta = localizeCta(
  d.secondaryCta ?? { label: "Contact sales", href: langPath("contact/sales", lang) },
  lang,
);

const formattedUpdated = d.updatedAt
  ? new Intl.DateTimeFormat("en-GB", { year: "numeric", month: "long" }).format(d.updatedAt)
  : null;

const pageTitle = `${d.seoTitle ?? d.title} | IoT Fabrikken`;
const metaDescription = d.metaDescription ?? d.description;
const pagePath = articlePath(article.slug, lang);

// Dual breadcrumb paths: when an article carries exactly one `industry:` tag
// that maps to a sector hub, show the audience-first trail
// (Home → Industries → Sector → Article); otherwise the topic-first trail
// (Home → Articles → Category → Article).
const hubLabelBySlug = new Map(
  getIndustriesHub(lang).leaves.map((l) => [l.slug, l.title.replace(/\.$/, "")]),
);
const industrySlugs = (d.tags ?? [])
  .filter((t) => t.toLowerCase().startsWith("industry:"))
  .map((t) => t.slice("industry:".length).toLowerCase())
  .filter((slug) => hubLabelBySlug.has(slug));
const primaryIndustrySlug = industrySlugs.length === 1 ? industrySlugs[0] : null;
const tIndustries = ui.industries.breadcrumb;
const articlesLabel = ui.nav.resources.libraryLabel;

const breadcrumbTrail = primaryIndustrySlug
  ? [
      { name: tIndustries.home, href: langPath("", lang) },
      { name: tIndustries.industries, href: langPath("industries", lang) },
      {
        name: hubLabelBySlug.get(primaryIndustrySlug) as string,
        href: langPath(`industries/${primaryIndustrySlug}`, lang),
      },
      { name: d.title, href: pagePath },
    ]
  : [
      { name: tIndustries.home, href: langPath("", lang) },
      { name: articlesLabel, href: articlesIndexPath(lang) },
      {
        name: category.name,
        href: `${articlesIndexPath(lang)}?category=${category.slug}`,
      },
      { name: d.title, href: pagePath },
    ];

const landingJsonLd = [
  breadcrumbSchema(breadcrumbTrail),
  webPageSchema({ title: d.title, description: metaDescription, url: pagePath }),
  faqSchema(d.faq ?? []),
].filter(Boolean) as Array<Record<string, unknown>>;
---

<Layout
  title={pageTitle}
  description={metaDescription}
  ogImage={d.ogImage ?? d.heroImage}
  noindex={d.noindex}
  jsonLd={landingJsonLd}
>

  <section data-page-hero data-compact-top class="relative overflow-hidden bg-stone-50 border-b border-stone-100">
    <div class="absolute inset-0 pointer-events-none opacity-[0.05]" aria-hidden="true">
      <div
        class="w-full h-full"
        style="background-image: radial-gradient(var(--color-navy-500) 1px, transparent 1px); background-size: 28px 28px;"
      ></div>
    </div>

    <div class="relative container-page pt-6 md:pt-8 pb-6 md:pb-8 xl:pb-10">
      <nav aria-label="Breadcrumb" class="text-sm text-stone-300 mb-3 md:mb-4 flex flex-wrap items-center gap-1.5">
        {breadcrumbTrail.map((crumb, i) =>
          i === breadcrumbTrail.length - 1 ? (
            <span class="text-navy-500" aria-current="page">{crumb.name}</span>
          ) : (
            <Fragment>
              <a href={crumb.href} class="hover:text-navy-500">{crumb.name}</a>
              <span>/</span>
            </Fragment>
          ),
        )}
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <div class="lg:col-span-7">
          {d.eyebrow && (
            <p class="reveal inline-block px-3 py-1 rounded-md bg-white text-navy-500 border border-stone-100 text-xs font-semibold uppercase tracking-wider mb-4">
              {d.eyebrow}
            </p>
          )}
          <h1 class="reveal text-3xl md:text-4xl xl:text-5xl font-bold leading-[1.05] tracking-tight text-navy-500">
            {d.heroTitle}
            {d.heroTitleAccent && <span class={cat.accent}> {d.heroTitleAccent}</span>}
          </h1>
          <p class="reveal hero-lead mt-4 md:mt-5 xl:mt-6 text-base md:text-lg xl:text-xl text-stone-900/70 leading-relaxed">
            {d.heroLead}
          </p>
          <div class="reveal hero-cta mt-6 md:mt-7 xl:mt-8 flex flex-wrap gap-3">
            <Button href={primaryCta.href} variant="primary" size="lg">{primaryCta.label}</Button>
            <Button href={secondaryCta.href} variant="secondary" size="lg">{secondaryCta.label}</Button>
          </div>
        </div>

        <div class="lg:col-span-5 reveal">
          {d.heroImage ? (
            <div class="bg-white border border-stone-100 rounded-xl shadow-xl overflow-hidden">
              <img
                src={d.heroImage}
                alt={d.heroImageAlt ?? d.title}
                class="w-full h-auto block"
                loading="eager"
              />
            </div>
          ) : (
            <ArticleImage
              category={d.category}
              ratio="aspect-[4/3]"
              rounded="rounded-xl"
              class="border border-stone-100 shadow-xl"
              eager={true}
            />
          )}
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="container-page grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
      <article class="lg:col-span-8 landing-prose">
        <slot />
      </article>

      <aside class="lg:col-span-4 space-y-6 lg:sticky lg:top-24 self-start">
        {d.keyPoints && d.keyPoints.length > 0 && (
          <div class="reveal bg-white border border-stone-100 rounded-xl p-6">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-navy-500 mb-4">
              At a glance
            </h2>
            <ul class="space-y-4">
              {d.keyPoints.map((k) => (
                <li>
                  <div class="flex items-baseline gap-3">
                    <span class={`mt-1 w-1.5 h-1.5 rounded-full shrink-0 ${cat.dot}`}></span>
                    <div>
                      <div class="font-semibold text-navy-500">{k.title}</div>
                      {k.unit && (
                        <div class={`text-xs font-semibold mt-0.5 ${cat.accent}`}>{k.unit}</div>
                      )}
                      {k.body && (
                        <p class="mt-1 text-sm text-stone-900/70 leading-relaxed">{k.body}</p>
                      )}
                    </div>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="reveal bg-navy-500 text-white rounded-xl p-6">
          <h2 class="text-lg font-semibold">Get a no-strings overview.</h2>
          <p class="mt-2 text-sm text-white/80">
            We'll show the platform live, walk through your case and give a price estimate.
          </p>
          <div class="mt-4 flex flex-col gap-2">
            <Button href={langPath("contact/book-demo", lang)} variant="white" size="sm">Book a free demo</Button>
            <Button
              href={langPath("contact/sales", lang)}
              variant="ghost"
              size="sm"
              class="text-white hover:text-white/80 border border-white/40 hover:bg-white/10"
            >
              Contact sales
            </Button>
          </div>
        </div>

        {d.tags && d.tags.length > 0 && (
          <div class="reveal">
            <div class="text-xs font-semibold uppercase tracking-wider text-stone-300 mb-2">
              Tags
            </div>
            <div class="flex flex-wrap gap-2">
              {d.tags.map((t) => (
                <a
                  href={`${articlesIndexPath(lang)}?tag=${encodeURIComponent(t)}`}
                  class="px-2.5 py-1 rounded-md bg-stone-100 text-navy-500 hover:bg-sky-500 hover:text-white text-xs font-medium transition-colors"
                >
                  {t}
                </a>
              ))}
            </div>
          </div>
        )}

        {formattedUpdated && (
          <p class="text-xs text-stone-300">Last updated: {formattedUpdated}</p>
        )}
        {d.publishedAt && !formattedUpdated && (
          <p class="text-xs text-stone-300">
            Published: {new Intl.DateTimeFormat("en-GB", { year: "numeric", month: "long" }).format(d.publishedAt)}
          </p>
        )}
      </aside>
    </div>
  </section>

  {d.faq && d.faq.length > 0 && (
    <ModuleFaqSection
      title={ui.faqSection.title}
      items={d.faq}
      contextAlt={ui.faqSection.contextAlt}
      context={moduleFaqContext}
    />
  )}

  {relatedCards.length > 0 && (
    <section class="py-16 md:py-20 bg-stone-50">
      <div class="container-page">
        <div class="reveal max-w-2xl mb-10">
          <p class="inline-block px-3 py-1 rounded-md bg-white text-navy-500 border border-stone-100 text-xs font-semibold uppercase tracking-wider mb-4">
            Related
          </p>
          <h2 class="text-2xl md:text-3xl font-bold text-navy-500 tracking-tight">
            You might also like
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-6">
          {relatedCards.map((card) => (
            <ArticleCard card={card} lang={lang} />
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaBand
    title="Ready to see RoomAlyzer in your building?"
    subtitle="Book a demo. We'll walk through your case and give you a concrete price estimate."
    primaryLabel="Book a free demo"
    secondaryLabel="Contact sales"
  />
</Layout>

<style is:global>
  .landing-prose {
    color: var(--color-stone-900);
    line-height: 1.7;
    font-size: 1.0625rem;
  }
  .landing-prose > * + * {
    margin-top: 1.25em;
  }
  .landing-prose h2 {
    font-size: 1.75rem;
    line-height: 1.2;
    margin-top: 2.25em;
    margin-bottom: 0.5em;
    color: var(--color-navy-500);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .landing-prose h3 {
    font-size: 1.25rem;
    margin-top: 1.75em;
    margin-bottom: 0.5em;
    color: var(--color-navy-500);
    font-weight: 600;
  }
  .landing-prose p {
    color: color-mix(in srgb, var(--color-stone-900) 78%, white);
  }
  .landing-prose a {
    color: var(--color-sky-600);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .landing-prose a:hover {
    color: var(--color-coral-500);
  }
  .landing-prose strong {
    color: var(--color-navy-500);
    font-weight: 600;
  }
  .landing-prose ul,
  .landing-prose ol {
    padding-left: 1.25rem;
  }
  .landing-prose ul {
    list-style: disc;
  }
  .landing-prose ol {
    list-style: decimal;
  }
  .landing-prose li + li {
    margin-top: 0.4em;
  }
  .landing-prose blockquote {
    border-left: 3px solid var(--color-sky-500);
    padding: 0.5em 1em;
    background: var(--color-stone-50);
    border-radius: 0.25rem;
    font-style: italic;
    color: var(--color-navy-500);
  }
  .landing-prose code {
    background: var(--color-stone-100);
    padding: 0.125em 0.35em;
    border-radius: 0.25rem;
    font-size: 0.9em;
  }
  .landing-prose img {
    border-radius: 0.75rem;
    border: 1px solid var(--color-stone-100);
  }
  .landing-prose hr {
    border: 0;
    border-top: 1px solid var(--color-stone-100);
    margin: 2.5em 0;
  }
</style>
