---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Button from "../components/Button.astro";
import CtaBand from "../components/CtaBand.astro";
import FAQ from "../components/FAQ.astro";

const steps = [
  {
    n: "01",
    title: "Pak ud",
    body: "Sensoren leveres klar til brug – ingen konfiguration, ingen opsætning.",
  },
  {
    n: "02",
    title: "Monter",
    body: "Hæng op med en skrue eller dobbeltklæb. Tager under 2 minutter pr. sensor.",
  },
  {
    n: "03",
    title: "Se data",
    body: "Sensoren melder ind til RoomAlyzer automatisk. Indsigten er i gang samme dag.",
  },
];

const features = [
  {
    title: "CO2",
    body: "Præcise målinger der viser hvornår der skal luftes ud – før hovedpinen melder sig.",
    unit: "400–5000 ppm",
  },
  {
    title: "Temperatur",
    body: "Kontinuerlig overvågning så både komfort og compliance er på plads.",
    unit: "-10 til +50°C",
  },
  {
    title: "Luftfugtighed",
    body: "Hold øje med fugtniveauer – centralt for trivsel og bygningens sundhed.",
    unit: "0–100 % RH",
  },
  {
    title: "VOC",
    body: "Totalindhold af flygtige organiske forbindelser fra materialer og rengøring.",
    unit: "0–5000 ppb",
  },
  {
    title: "Skimmel & fugt",
    body: "Prædiktiv analyse der alarmerer inden skimmel får fat i konstruktionen.",
    unit: "Prædiktiv model",
  },
  {
    title: "Trykforhold",
    body: "Relativt tryk mellem rum – relevant for laboratorier og rene rum.",
    unit: "± 500 Pa",
  },
];

const faqItems = [
  {
    q: "Hvor lang er batterilevetiden?",
    a: "Vores indeklimasensorer kører typisk 7-10 år på samme batteri, afhængigt af rapporteringsfrekvens. Platformen varsler i god tid når batteriet skal skiftes.",
  },
  {
    q: "Skal vi have WiFi i hele bygningen?",
    a: "Nej. Sensorerne bruger LoRaWAN eller tilsvarende langtrækkende radioprotokoller. Én gateway kan typisk dække en hel etage eller mere.",
  },
  {
    q: "Kan data integreres med vores BMS eller Building Management System?",
    a: "Ja. RoomAlyzer tilbyder åbne API'er samt understøtter typiske BMS-protokoller. Vi hjælper gerne med opsætning.",
  },
  {
    q: "Er løsningen GDPR-compliant?",
    a: "Ja. Vi måler fysiske forhold i rummene – ikke personer. Data behandles i EU og lever op til gældende standarder.",
  },
  {
    q: "Hvad koster det?",
    a: "Prisen afhænger af antal sensorer og bygningens størrelse. Book en demo, så giver vi et konkret estimat baseret på din case.",
  },
];
---

<Layout
  title="Indeklima — sensorer og data | IoT Fabrikken"
  description="Mål CO2, temperatur, luftfugtighed og VOC med trådløse sensorer. Reager på data i stedet for følelser – og vær på forkant med skimmel og fugt."
>

  <Hero
    eyebrow="Indeklima"
    title="Håndter klager med data."
    titleAccent="Ikke følelser."
    lead="Trådløse sensorer måler CO2, temperatur, luftfugtighed og VOC i realtid. Få varslinger om skimmel og fugt, før det koster bygningen – og få dokumentation der står mål med arbejdsmiljøkrav."
    align="left"
  >
    <Button href="/book-demo" variant="primary" size="lg" slot="cta">Book demo</Button>
    <Button href="#download" variant="secondary" size="lg" slot="cta">Download produktark</Button>

    <div slot="visual" class="reveal">
      <div class="relative max-w-5xl">
        <div class="bg-white border border-stone-100 rounded-xl shadow-xl overflow-hidden">
          <div class="flex items-center gap-2 px-4 py-3 border-b border-stone-100 bg-stone-50">
            <span class="w-3 h-3 rounded-full bg-stone-300/70"></span>
            <span class="w-3 h-3 rounded-full bg-stone-300/70"></span>
            <span class="w-3 h-3 rounded-full bg-stone-300/70"></span>
            <span class="ml-3 text-xs font-medium text-stone-300">RoomAlyzer — Indeklima</span>
          </div>
          <img
            src="/roomalyzer-dashboard-clean.png"
            alt="RoomAlyzer dashboard viser indeklimadata fra flere rum"
            width="1024"
            height="595"
            class="w-full h-auto block"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </Hero>

  <section class="py-20 md:py-24">
    <div class="container-page">
      <div class="reveal max-w-2xl mb-12">
        <p class="inline-block px-3 py-1 rounded-md bg-stone-100 text-navy-500 text-xs font-semibold uppercase tracking-wider mb-5">
          Sådan virker det
        </p>
        <h2 class="text-3xl md:text-4xl font-bold text-navy-500 tracking-tight">
          Fra kasse til data på under 10 minutter.
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {steps.map((s) => (
          <div class="reveal relative bg-white border border-stone-100 rounded-xl p-6 md:p-8">
            <span class="text-5xl font-bold text-stone-100 block leading-none">{s.n}</span>
            <h3 class="mt-4 text-xl font-semibold text-navy-500">{s.title}</h3>
            <p class="mt-2 text-stone-900/70 leading-relaxed">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 md:py-24 bg-stone-50">
    <div class="container-page">
      <div class="reveal max-w-2xl mb-12 md:mb-16">
        <p class="inline-block px-3 py-1 rounded-md bg-white text-navy-500 border border-stone-100 text-xs font-semibold uppercase tracking-wider mb-5">
          Parametre vi måler
        </p>
        <h2 class="text-3xl md:text-4xl font-bold text-navy-500 tracking-tight">
          Alt det data du har brug for – og intet du ikke har.
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {features.map((f) => (
          <div class="reveal bg-white rounded-xl border border-stone-100 p-6 hover:border-navy-500 transition-colors">
            <div class="inline-flex px-2.5 py-1 rounded-md bg-sky-50 text-sky-600 text-xs font-semibold">
              {f.unit}
            </div>
            <h3 class="mt-4 text-xl font-semibold text-navy-500">{f.title}</h3>
            <p class="mt-2 text-stone-900/70 leading-relaxed">{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 md:py-24">
    <div class="container-page">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-stretch">
        <div class="reveal bg-stone-50 border border-stone-100 rounded-xl p-8 md:p-10">
          <div class="w-11 h-11 rounded-md bg-sky-500 text-white inline-flex items-center justify-center mb-5">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 21V9l9-6 9 6v12M9 21v-6h6v6" />
            </svg>
          </div>
          <h3 class="text-2xl font-semibold text-navy-500">For Facility Managers</h3>
          <ul class="mt-6 space-y-3 text-navy-500">
            {[
              "Se alarmer sorteret efter kritikalitet",
              "Dokumentér performance på ventilationsanlæg",
              "Reducér klagesager med objektiv data",
              "Styr drift ud fra reel brug – ikke skema",
            ].map((t) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 w-5 h-5 inline-flex items-center justify-center rounded-md bg-sky-500 text-white shrink-0">
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2.5 6L5 8.5L9.5 3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </span>
                <span>{t}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="reveal bg-navy-500 text-white rounded-xl p-8 md:p-10">
          <div class="w-11 h-11 rounded-md bg-white/10 text-white inline-flex items-center justify-center mb-5">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><path d="M22 4L12 14.01l-3-3" />
            </svg>
          </div>
          <h3 class="text-2xl font-semibold">For Compliance & ESG</h3>
          <ul class="mt-6 space-y-3 text-white/90">
            {[
              "Eksport af rapporter til CSRD og ESG-arbejde",
              "Historik på indeklima til AT-tilsyn og audit",
              "Dokumenteret indsats på medarbejdertrivsel",
              "Lavere energiforbrug via datadreven styring",
            ].map((t) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 w-5 h-5 inline-flex items-center justify-center rounded-md bg-white/10 shrink-0">
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2.5 6L5 8.5L9.5 3.5" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </span>
                <span>{t}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <FAQ items={faqItems} />

  <CtaBand
    title="Vil du se det med dine egne øjne?"
    subtitle="Book en 30 minutters demo. Vi viser platformen, gennemgår din case og giver et prisestimat."
    primaryLabel="Book demo"
    secondaryLabel="Download produktark"
    secondaryHref="#download"
    variant="dark"
  />
</Layout>
