---
// Root redirect to the English site. Astro's `redirects` config also emits
// a build-time redirect, but we ship the HTML fallback so the site works
// on any host without native redirect support.
const target = "/en/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>IoT Fabrikken</title>
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <p>Redirecting to <a href={target}>{target}</a>…</p>
    <script>
      window.location.replace("/en/");
    </script>
  </body>
</html>
