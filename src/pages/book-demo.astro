---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import ContactForm from "../components/ContactForm.astro";
---

<Layout
  title="Book en demo | IoT Fabrikken"
  description="Book en gratis, uforpligtende demo af RoomAlyzer-platformen og vores sensorer."
>
  <Hero
    eyebrow="Book demo"
    title="Se platformen."
    titleAccent="Stil spørgsmålene."
    lead="30 minutter. Ingen forpligtelser. Vi gennemgår platformen, taler om din case og giver et konkret estimat på en opsætning."
    align="left"
  />

  <ContactForm
    title="Book et møde"
    subtitle="Udfyld formularen, så kontakter vi dig for at finde en tid, der passer dig."
  />
</Layout>
