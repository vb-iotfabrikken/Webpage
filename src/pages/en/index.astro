---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import HeroAnimation from "../../components/HeroAnimation.astro";
import Button from "../../components/Button.astro";
import LogoMarquee from "../../components/LogoMarquee.astro";
import ModuleCard from "../../components/ModuleCard.astro";
import StatBlock from "../../components/StatBlock.astro";
import CtaBand from "../../components/CtaBand.astro";
import ContactForm from "../../components/ContactForm.astro";
import { modules } from "../../data/modules";

const stats = [
  { value: "15,000", prefix: "+", label: "sensors in operation at our customers" },
  { value: "2", prefix: "+", suffix: " million", label: "readings sent to the platform every day" },
  { value: "12", prefix: "+", label: "countries where our solutions are in use" },
];

const usps = [
  {
    title: "Plug and play",
    body: "Turn the sensor on and it's online. No configuration, no specialists.",
    icon: "plug",
  },
  {
    title: "Long battery life",
    body: "Up to 10 years on a single battery. Set them up once and forget about them.",
    icon: "battery",
  },
  {
    title: "No installation",
    body: "No cables, no WiFi, no installer. You save both time and money.",
    icon: "tools",
  },
  {
    title: "Sharp price",
    body: "A fair total cost of ownership with no hidden per-sensor license fees.",
    icon: "price",
  },
];
---

<Layout
  title="IoT Fabrikken — Sensors and platform for facility and space management"
  description="Market-leading Danish platform for indoor climate, space management and water-leak detection. Plug and play sensors, long battery life and no installation."
>

  <Hero
    eyebrow="Danish-built SaaS and IoT"
    title="Data-driven decisions for facility and"
    titleAccent="space management."
    lead="Wireless sensors and a single platform that turns data about indoor climate, space utilisation and water leaks into something you can actually use — no cables, no hassle."
  >
    <Button href="/en/contact/book-demo/" variant="primary" size="lg" slot="cta">Book a free demo</Button>
    <Button href="/en/contact/sales/" variant="secondary" size="lg" slot="cta">Contact sales</Button>

    <div slot="visual">
      <HeroAnimation />
    </div>
  </Hero>

  <LogoMarquee />

  <section class="py-20 md:py-28">
    <div class="container-page">
      <div class="reveal max-w-2xl mb-12 md:mb-16">
        <p class="inline-block px-3 py-1 rounded-md bg-stone-100 text-navy-500 text-xs font-semibold uppercase tracking-wider mb-5">
          Modules
        </p>
        <h2 class="text-3xl md:text-5xl font-bold text-navy-500 tracking-tight">
          Easy-to-install sensors — and data that gives unique insight.
        </h2>
        <p class="mt-5 text-lg text-stone-900/70">
          However you combine your sensor setup, the data is collected in one place in the RoomAlyzer platform.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {modules.map((m) => <ModuleCard module={m} />)}
      </div>

    </div>
  </section>

  <!-- At scale section -->
  <section class="py-16 md:py-20 bg-stone-50">
    <div class="container-page">
      <div class="reveal grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">
        <div class="rounded-lg overflow-hidden border border-stone-100 shadow-sm">
          <img
            src="/sensors-lineup.png"
            alt="IoT Fabrikken sensors ready to be rolled out"
            width="900"
            height="1100"
            class="w-full h-72 object-cover object-top"
            loading="lazy"
          />
        </div>
        <div>
          <p class="inline-block px-3 py-1 rounded-md bg-stone-100 text-navy-500 text-xs font-semibold uppercase tracking-wider mb-5">
            Scalable roll-out
          </p>
          <h2 class="text-3xl md:text-4xl font-bold text-navy-500 tracking-tight">
            From one room to your whole building portfolio.
          </h2>
          <p class="mt-5 text-lg text-stone-900/70">
            Whether you're starting with ten sensors or rolling out a thousand across multiple sites, the process is the same: turn them on, and they're online.
          </p>
          <ul class="mt-6 space-y-2">
            {["No technician needed", "Full overview from day one", "Scale at your own pace"].map((t) => (
              <li class="flex items-center gap-2 text-stone-900/80 text-sm">
                <span class="w-4 h-4 rounded-sm bg-sky-100 text-sky-600 inline-flex items-center justify-center shrink-0">
                  <svg width="10" height="10" viewBox="0 0 12 12" fill="none"><path d="M2.5 6L5 8.5L9.5 3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </span>
                {t}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <StatBlock
    title="Numbers that matter."
    subtitle="More than a million readings per day from sensors that run without hassle at our customers."
    stats={stats}
  />

  <section class="py-20 md:py-28 bg-stone-50">
    <div class="container-page">
      <div class="reveal max-w-2xl mx-auto text-center mb-14">
        <h2 class="text-3xl md:text-5xl font-bold text-navy-500 tracking-tight">
          Why IoT Fabrikken?
        </h2>
        <p class="mt-5 text-lg text-stone-900/70">
          We've removed everything that normally makes IoT projects heavy. What's left is sensors that just work — and data you can use.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
        {usps.map((u) => (
          <div class="reveal bg-white border border-stone-100 rounded-xl p-6 hover:border-navy-500 transition-colors">
            <div class="w-11 h-11 rounded-md bg-sky-50 text-sky-600 inline-flex items-center justify-center mb-4">
              {u.icon === "plug" && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 2v6M15 2v6M7 8h10v4a5 5 0 0 1-10 0V8zM12 17v5" />
                </svg>
              )}
              {u.icon === "battery" && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="7" width="18" height="10" rx="2" /><path d="M22 11v2" /><path d="M6 10v4M10 10v4M14 10v4" />
                </svg>
              )}
              {u.icon === "tools" && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14.7 6.3a4 4 0 0 0-5.4 5.4l-6 6a2 2 0 1 0 3 3l6-6a4 4 0 0 0 5.4-5.4l-2.5 2.5-2-2 2.5-2.5z" />
                </svg>
              )}
              {u.icon === "price" && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 12V7a2 2 0 0 0-2-2h-5L3 15l6 6 10-10z" /><circle cx="9" cy="9" r="1.5" />
                </svg>
              )}
            </div>
            <h3 class="text-lg font-semibold text-navy-500 mb-2">{u.title}</h3>
            <p class="text-sm text-stone-900/70 leading-relaxed">{u.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28">
    <div class="container-page">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div class="reveal">
          <p class="inline-block px-3 py-1 rounded-md bg-stone-100 text-navy-500 text-xs font-semibold uppercase tracking-wider mb-5">
            The workplace in numbers
          </p>
          <h2 class="text-3xl md:text-5xl font-bold text-navy-500 tracking-tight">
            The world has changed.<br />
            <span class="text-sky-600">Has your office?</span>
          </h2>
          <p class="mt-5 text-lg text-stone-900/70">
            On average, our customers can significantly optimise how they use their floor space — because they know exactly which rooms are used, and when.
          </p>
          <ul class="mt-8 space-y-4">
            {[
              { year: "2016", pct: "83%", note: "of the time spent at the office" },
              { year: "2023", pct: "46%", note: "of the time spent at the office" },
            ].map((r) => (
              <li class="flex items-center gap-4 border-b border-stone-100 pb-4 last:border-0">
                <span class="text-sm font-semibold text-stone-300 w-14">{r.year}</span>
                <span class="text-3xl font-bold text-navy-500 w-20">{r.pct}</span>
                <span class="text-stone-900/70">{r.note}</span>
              </li>
            ))}
          </ul>
          <p class="mt-6 text-sm text-stone-300 italic">Source: UK Workspace Survey 2023.</p>
        </div>

        <div class="reveal relative">
          <div class="aspect-square md:aspect-[4/5] bg-stone-50 rounded-xl border border-stone-100 p-8 flex flex-col justify-between">
            <div>
              <span class="text-xs font-semibold uppercase tracking-wider text-sky-600">Space utilisation</span>
              <h3 class="mt-3 text-2xl font-bold text-navy-500">A 37 percentage-point drop in just seven years.</h3>
            </div>
            <div class="grid grid-cols-7 gap-2">
              {Array.from({ length: 49 }).map((_, i) => {
                const active = i % 7 < 3;
                return (
                  <div class={`aspect-square rounded ${active ? "bg-navy-500" : "bg-white border border-stone-100"}`}></div>
                );
              })}
            </div>
            <p class="text-sm text-stone-900/70">
              Each dark square is a desk that stands empty today, where it was occupied in 2016.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 md:py-24 bg-navy-500 text-white overflow-hidden">
    <div class="container-page grid grid-cols-1 lg:grid-cols-5 gap-12 items-center">
      <div class="lg:col-span-3 reveal">
        <p class="inline-block px-3 py-1 rounded-md bg-white/10 text-white text-xs font-semibold uppercase tracking-wider mb-5">
          RoomAlyzer platform
        </p>
        <h2 class="text-3xl md:text-5xl font-bold tracking-tight">
          Wireless sensors. One overview.
        </h2>
        <p class="mt-5 text-lg text-white/80 max-w-xl">
          Every sensor reports into RoomAlyzer. Whether you combine indoor climate, pushbutton, water leak or space management, your data lives in one place.
        </p>
        <ul class="mt-8 space-y-3">
          {[
            "No WiFi, no wiring",
            "Easy-to-read data — no data designer needed",
            "Alarms and reports routed to the right people",
            "Open APIs so your data talks to your other systems",
          ].map((t) => (
            <li class="flex items-start gap-3">
              <span class="mt-0.5 w-5 h-5 inline-flex items-center justify-center rounded-md bg-white/10 shrink-0">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2.5 6L5 8.5L9.5 3.5" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </span>
              <span class="text-white/90">{t}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="lg:col-span-2 reveal">
        <div class="bg-white/5 border border-white/10 rounded-xl p-6 backdrop-blur">
          <div class="text-xs font-semibold uppercase tracking-wider text-white/60 mb-4">Live status</div>
          <div class="space-y-3">
            {[
              { label: "Meeting room 2.01", v: "CO2 612 ppm", ok: true },
              { label: "North office", v: "Humidity 41%", ok: true },
              { label: "Basement, pipe 3", v: "No water", ok: true },
              { label: "Meeting room 3.04", v: "CO2 1240 ppm", ok: false },
            ].map((r) => (
              <div class="flex items-center justify-between bg-white/5 rounded-md px-4 py-3 border border-white/5">
                <span class="text-sm text-white/90">{r.label}</span>
                <span class={`text-xs font-semibold px-2.5 py-1 rounded-md ${r.ok ? "bg-white/10 text-white" : "bg-coral-500 text-white"}`}>
                  {r.v}
                </span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <ContactForm />

  <CtaBand
    title="Ready to try it yourself?"
    subtitle="Book a demo and see how data from our sensors can optimise your operations."
    primaryLabel="Book demo"
    secondaryLabel="Contact sales"
  />
</Layout>
