---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import HeroAnimation from "../../components/HeroAnimation.astro";
import Button from "../../components/Button.astro";
import LogoMarquee from "../../components/LogoMarquee.astro";
import StatBlock from "../../components/StatBlock.astro";
import CtaBand from "../../components/CtaBand.astro";
import UspSection from "../../components/UspSection.astro";
import ProblemSection from "../../components/ProblemSection.astro";
import SensorFinderSection from "../../components/SensorFinderSection.astro";

const stats = [
  { value: "15,000", prefix: "+", label: "sensors in operation at our customers" },
  { value: "2", prefix: "+", suffix: " million", label: "readings sent to the platform every day" },
  { value: "12", prefix: "+", label: "countries where our solutions are in use" },
];
---

<Layout
  title="IoT Fabrikken — Sensors and platform for facility and space management"
  description="Market-leading Danish platform for indoor climate, space management and water-leak detection. Plug and play sensors, long battery life and no installation."
>
  <Hero
    title="Data-driven decisions for facility and"
    titleAccent="space management."
    lead="Wireless sensors and a single platform that turns data about indoor climate, space utilisation and water leaks into something you can actually use — no cables, no hassle."
    allowVisualOverflow
    compactTop
    compactBottom
  >
    <Button href="/en/contact/book-demo/" variant="primary" size="lg" slot="cta">Book a free demo</Button>
    <Button href="/en/contact/sales/" variant="secondary" size="lg" slot="cta">Contact sales</Button>

    <div slot="visual" class="overflow-visible">
      <HeroAnimation />
    </div>
  </Hero>

  <LogoMarquee />

  <UspSection />

  <ProblemSection />

  <SensorFinderSection />

  <StatBlock
    title="Numbers that matter."
    subtitle="More than a million readings per day from sensors that run without hassle at our customers."
    stats={stats}
  />

  <CtaBand
    variant="featured"
    title="Ready to try it?"
    subtitle="Book a demo and see how data from our sensors can optimise your operations."
    primaryLabel="Book a free demo"
    secondaryLabel="Contact sales"
  />
</Layout>
