---
import CaseStudyDetailPage from "../../../components/CaseStudyDetailPage.astro";
import { getCaseStudiesHub } from "../../../data/hubs/caseStudies";
import { langPath } from "../../../data/lang";

export function getStaticPaths() {
  const hub = getCaseStudiesHub("en");
  return hub.leaves.map((leaf) => ({
    params: { slug: leaf.slug },
    props: { leaf },
  }));
}

const { leaf } = Astro.props;
const casesHref = langPath("case-studies", "en");
---

<CaseStudyDetailPage
  lang="en"
  leaf={leaf}
  breadcrumbs={[
    { label: "Home", href: langPath("", "en") },
    { label: "Cases", href: casesHref },
    { label: leaf.title.replace(/\.$/, "") },
  ]}
/>
