---
import Layout from "../../../layouts/Layout.astro";
import Hero from "../../../components/Hero.astro";
import Button from "../../../components/Button.astro";
import CtaBand from "../../../components/CtaBand.astro";
import {
  careersContact,
  careersIntro,
  growthSection,
  openPositions,
} from "../../../data/careers";
---

<Layout
  title="Careers | About | IoT Fabrikken"
  description={careersIntro.lead}
>
  <nav class="container-page pt-6" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-1.5 text-sm text-stone-300">
      <li><a href="/en/" class="hover:text-coral-500 transition-colors">Home</a></li>
      <li aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4.5 3L7.5 6L4.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></li>
      <li><a href="/en/about/" class="hover:text-coral-500 transition-colors">About</a></li>
      <li aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4.5 3L7.5 6L4.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></li>
      <li><span class="text-navy-500">Careers</span></li>
    </ol>
  </nav>

  <Hero
    title={careersIntro.title}
    titleAccent={careersIntro.titleAccent}
    lead={careersIntro.lead}
    align="left"
    compactTop
  >
    <Button href="#open-roles" variant="primary" size="lg" slot="cta">See open roles</Button>
    <Button href={`mailto:${careersContact.email}`} variant="secondary" size="lg" slot="cta">Apply by email</Button>
  </Hero>

  <section id="open-roles" class="py-14">
    <div class="container-page max-w-4xl">
      <h2 class="text-2xl md:text-3xl font-bold text-navy-500 tracking-tight pb-3 border-b border-stone-100">
        Open positions
      </h2>

      {openPositions.length > 0 ? (
        <ul class="mt-8 space-y-4">
          {openPositions.map((job) => (
            <li>
              <article class="bg-white border border-stone-100 rounded-xl p-6 md:p-8 hover:border-navy-500 transition-colors">
                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
                  <div>
                    <h3 class="text-lg md:text-xl font-semibold text-navy-500">{job.title}</h3>
                    <p class="mt-1 text-sm text-coral-500 font-medium">{job.location}</p>
                    <p class="mt-3 text-stone-900/80 leading-relaxed">{job.summary}</p>
                  </div>
                  <Button
                    href={`/en/about/careers/${job.slug}/`}
                    variant="primary"
                    size="md"
                    class="shrink-0 self-start"
                  >
                    Read more
                  </Button>
                </div>
              </article>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-6 text-stone-900/80 leading-relaxed">
          We have no listed openings right now — but unsolicited applications are always welcome.
        </p>
      )}
    </div>
  </section>

  <section class="pb-14">
    <div class="container-page max-w-4xl">
      <h2 class="text-2xl md:text-3xl font-bold text-navy-500 tracking-tight">
        {growthSection.title}
      </h2>
      {growthSection.body.map((paragraph) => (
        <p class="mt-4 text-stone-900/80 leading-relaxed">{paragraph}</p>
      ))}
      <p class="mt-4 text-stone-900/80 leading-relaxed">
        Industry knowledge in{" "}
        <a href="/en/modules/space-management/" class="text-navy-500 font-medium hover:text-coral-500 underline underline-offset-4">
          space management
        </a>{" "}
        and/or{" "}
        <a href="/en/modules/indoor-climate/" class="text-navy-500 font-medium hover:text-coral-500 underline underline-offset-4">
          indoor climate
        </a>{" "}
        and energy optimisation is especially valuable.
      </p>
    </div>
  </section>

  <section class="pb-16 md:pb-20">
    <div class="container-page max-w-4xl">
      <div class="bg-navy-500 text-white rounded-xl p-8 md:p-10">
        <h2 class="text-xl md:text-2xl font-bold tracking-tight">Can you convince us?</h2>
        <p class="mt-3 text-white/80 leading-relaxed">
          You are always welcome to apply speculatively — even when no role is listed.
          Tell us who you are, what you want to do and why IoT Fabrikken is the right fit.
        </p>
        <div class="mt-6 space-y-2 text-sm">
          <a
            href={`mailto:${careersContact.email}`}
            class="block font-semibold text-white hover:text-coral-500 underline underline-offset-4"
          >
            {careersContact.email}
          </a>
          <a
            href={`tel:${careersContact.phone.replace(/\s+/g, "")}`}
            class="block font-semibold text-white hover:text-coral-500 underline underline-offset-4"
          >
            {careersContact.phone}
          </a>
        </div>
        <div class="mt-6">
          <Button href={`mailto:${careersContact.email}?subject=Unsolicited%20application`} variant="secondary" size="md">
            Send your application
          </Button>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    title="Want to join us?"
    subtitle="Open roles in sales and development — or send an unsolicited application anytime."
    primaryLabel="See open roles"
    primaryHref="#open-roles"
    secondaryLabel="Meet the team"
    secondaryHref="/en/about/team/"
  />
</Layout>
