---
import Layout from "../../../layouts/Layout.astro";
import Hero from "../../../components/Hero.astro";
import Button from "../../../components/Button.astro";
import PartnerGrid from "../../../components/PartnerGrid.astro";
import { partners, partnersIntro } from "../../../data/partners";
---

<Layout
  title="Partners | About | IoT Fabrikken"
  description={partnersIntro.lead}
>
  <nav class="container-page pt-6" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-1.5 text-sm text-stone-300">
      <li><a href="/en/" class="hover:text-coral-500 transition-colors">Home</a></li>
      <li aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4.5 3L7.5 6L4.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></li>
      <li><a href="/en/about/" class="hover:text-coral-500 transition-colors">About</a></li>
      <li aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4.5 3L7.5 6L4.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></li>
      <li><span class="text-navy-500">Partners</span></li>
    </ol>
  </nav>

  <Hero
    title="Partners."
    titleAccent={partnersIntro.title}
    lead={partnersIntro.lead}
    align="left"
    compactTop
  >
    <Button href="/en/contact/become-partner/" variant="primary" size="lg" slot="cta">Become a partner</Button>
    <Button href="/en/contact/sales/" variant="secondary" size="lg" slot="cta">Talk to sales</Button>
  </Hero>

  <section class="py-14 md:py-20">
    <div class="container-page">
      <PartnerGrid partners={partners} />
    </div>
  </section>

  <section class="pb-16 md:pb-20">
    <div class="container-page max-w-3xl">
      <div class="bg-stone-50 border border-stone-100 rounded-xl p-8 md:p-10">
        <h2 class="text-xl md:text-2xl font-bold text-navy-500 tracking-tight">
          Interested in partnering?
        </h2>
        <p class="mt-3 text-stone-900/80 leading-relaxed">
          We work with resellers, integrators, technology vendors and FM specialists who
          bring RoomAlyzer to new buildings and markets. If you have complementary products
          or services — or want to sell and support our sensors and platform — we would like
          to hear from you.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <Button href="/en/contact/become-partner/" variant="primary" size="md">
            Become a partner
          </Button>
          <Button href="/en/integrations/" variant="secondary" size="md">
            View integrations
          </Button>
        </div>
      </div>
    </div>
  </section>
</Layout>
