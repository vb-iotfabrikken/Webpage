---
import PlaceholderPage from "../../../components/PlaceholderPage.astro";
import { aboutHub } from "../../../data/site";

export function getStaticPaths() {
  // These slugs are served by hand-authored static pages in the same
  // folder, so we exclude them here to avoid a duplicate-route build
  // error. Keep this set inside getStaticPaths — Astro evaluates the
  // function in isolation and outer-scope constants aren't visible.
  const handAuthored = new Set(["team", "partners", "press"]);
  return aboutHub.leaves
    .filter((leaf) => !handAuthored.has(leaf.slug))
    .map((leaf) => ({
      params: { slug: leaf.slug },
      props: { leaf },
    }));
}

const { leaf } = Astro.props;
---

<PlaceholderPage
  title={`${leaf.title.replace(/\.$/, "")} | IoT Fabrikken`}
  description={leaf.lead}
  eyebrow={leaf.eyebrow}
  heroTitle={leaf.title}
  heroTitleAccent={leaf.titleAccent}
  heroLead={leaf.lead}
  breadcrumbs={[
    { label: "Home", href: "/en/" },
    { label: "About", href: "/en/about/" },
    { label: leaf.title.replace(/\.$/, "") },
  ]}
  primaryCta={leaf.primaryCta}
  secondaryCta={leaf.secondaryCta}
/>
