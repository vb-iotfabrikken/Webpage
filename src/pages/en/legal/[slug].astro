---
import PlaceholderPage from "../../../components/PlaceholderPage.astro";
import { legalHub } from "../../../data/site";

export function getStaticPaths() {
  // privacy.astro and impressum.astro are dedicated pages with full content
  return legalHub.leaves
    .filter((leaf) => leaf.slug !== "privacy" && leaf.slug !== "impressum")
    .map((leaf) => ({
      params: { slug: leaf.slug },
      props: { leaf },
    }));
}

const { leaf } = Astro.props;
---

<PlaceholderPage
  title={`${leaf.title.replace(/\.$/, "")} | IoT Fabrikken`}
  description={leaf.lead}
  heroTitle={leaf.title}
  heroTitleAccent={leaf.titleAccent}
  heroLead={leaf.lead}
  breadcrumbs={[
    { label: "Home", href: "/en/" },
    { label: "Legal", href: "/en/legal/" },
    { label: leaf.title.replace(/\.$/, "") },
  ]}
  primaryCta={leaf.primaryCta}
  secondaryCta={leaf.secondaryCta}
/>
