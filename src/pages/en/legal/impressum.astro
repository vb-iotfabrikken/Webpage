---
import PlaceholderPage from "../../../components/PlaceholderPage.astro";
import LegalProse from "../../../components/legal/LegalProse.astro";
import { legalHub } from "../../../data/site";

const leaf = legalHub.leaves.find((l) => l.slug === "impressum")!;
---

<PlaceholderPage
  title="Impressum | IoT Fabrikken"
  description={leaf.lead}
  heroTitle={leaf.title}
  heroTitleAccent={leaf.titleAccent}
  heroLead={leaf.lead}
  breadcrumbs={[
    { label: "Home", href: "/en/" },
    { label: "Legal", href: "/en/legal/" },
    { label: "Impressum" },
  ]}
  hideNotice={true}
  showCtas={false}
>
  <LegalProse>
    <h3>Company details</h3>
    <p>
      <strong>IoT Fabrikken ApS</strong><br />
      Brønsager 1<br />
      4000 Roskilde<br />
      Denmark
    </p>

    <h3>Represented by</h3>
    <p>
      Jon Wichmann (CEO / Partner)<br />
      Mikkel Fischer (Partner)
    </p>

    <h3>Contact</h3>
    <ul>
      <li>
        <strong>Phone:</strong>
        <a href="tel:+4571718090">+45 71 71 80 90</a>
      </li>
      <li>
        <strong>Email:</strong>
        <a href="mailto:info@iot-fabrikken.com">info@iot-fabrikken.com</a>
      </li>
      <li>
        <strong>Website:</strong>
        <a href="https://www.iot-fabrikken.com/">www.iot-fabrikken.com</a>
      </li>
    </ul>

    <h3>Register entry</h3>
    <p>
      Registered in the Danish Business Authority
      (<em>Det Centrale Virksomhedsregister</em>).
    </p>
    <p>
      <strong>CVR number:</strong> 39110393
    </p>
  </LegalProse>
</PlaceholderPage>
