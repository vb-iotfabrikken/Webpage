---
import Layout from "../../../layouts/Layout.astro";
import Hero from "../../../components/Hero.astro";
import Button from "../../../components/Button.astro";
import ContactForm from "../../../components/ContactForm.astro";
import { contactHub } from "../../../data/site";
---

<Layout
  title="Contact | IoT Fabrikken"
  description="Get in touch — we're always happy to have a no-strings chat about your options."
>
  <nav class="container-page pt-6" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-1.5 text-sm text-stone-300">
      <li><a href="/en/" class="hover:text-coral-500 transition-colors">Home</a></li>
      <li aria-hidden="true">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4.5 3L7.5 6L4.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </li>
      <li><span class="text-navy-500">Contact</span></li>
    </ol>
  </nav>

  <Hero
    eyebrow="Contact"
    title="Let's have"
    titleAccent="a chat."
    lead="Got questions, or just curious about our solution? We're always happy to have an expert, no-strings chat — online or in person."
    align="left"
  >
    <Button href="/en/contact/book-demo/" variant="primary" size="lg" slot="cta">Book demo</Button>
    <Button href="/en/contact/sales/" variant="secondary" size="lg" slot="cta">Talk to sales</Button>
  </Hero>

  <section class="py-16">
    <div class="container-page">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {contactHub.leaves.map((leaf) => (
          <a
            href={`/en/contact/${leaf.slug}/`}
            class="reveal group flex flex-col p-6 md:p-7 bg-white border border-stone-100 rounded-xl hover:border-navy-500 hover:-translate-y-1 hover:shadow-lg transition-all duration-300"
          >
            <p class="inline-block px-2.5 py-1 rounded-md bg-stone-50 text-navy-500 text-[11px] font-semibold uppercase tracking-wider mb-4 self-start">
              {leaf.eyebrow}
            </p>
            <h3 class="text-lg font-semibold text-navy-500 mb-2 leading-snug">
              {leaf.title}
              {leaf.titleAccent && (
                <span class="block text-sky-600 text-base font-medium mt-0.5">{leaf.titleAccent}</span>
              )}
            </h3>
            <p class="text-sm text-stone-900/70 leading-relaxed">{leaf.lead}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <ContactForm
    title="Write to us"
    subtitle="Fill out the form and we'll get back to you within one business day."
  />
</Layout>
