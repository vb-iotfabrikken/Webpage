---
import Layout from "../../../layouts/Layout.astro";
import Hero from "../../../components/Hero.astro";
import ContactForm from "../../../components/ContactForm.astro";
---

<Layout
  title="Book a demo | IoT Fabrikken"
  description="Book a free, no-strings demo of the RoomAlyzer platform and our sensors."
>
  <nav class="container-page pt-6" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-1.5 text-sm text-stone-300">
      <li><a href="/en/" class="hover:text-coral-500 transition-colors">Home</a></li>
      <li aria-hidden="true">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4.5 3L7.5 6L4.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </li>
      <li><a href="/en/contact/" class="hover:text-coral-500 transition-colors">Contact</a></li>
      <li aria-hidden="true">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4.5 3L7.5 6L4.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </li>
      <li><span class="text-navy-500">Book demo</span></li>
    </ol>
  </nav>

  <Hero
    eyebrow="Book demo"
    title="See the platform."
    titleAccent="Ask the questions."
    lead="30 minutes. No commitments. We'll walk through the platform, talk about your case and give a concrete estimate for a setup."
    align="left"
  />

  <ContactForm
    title="Book a meeting"
    subtitle="Fill out the form and we'll reach out to find a time that works for you."
  />
</Layout>
