---
import { getCollection, render } from "astro:content";
import LandingPageLayout from "../../../layouts/LandingPageLayout.astro";
import PlaceholderPage from "../../../components/PlaceholderPage.astro";
import { articles as catalog } from "../../../data/library/catalog";
import { landingCategories } from "../../../data/landingCategories";

export async function getStaticPaths() {
  const entries = await getCollection("landingpages", ({ data }) => !data.draft);
  const mdxSlugs = new Set(entries.map((e) => e.id));

  const mdxPaths = entries.map((entry) => {
    const related = (entry.data.related ?? [])
      .map((slug) => entries.find((e) => e.id === slug))
      .filter((e): e is (typeof entries)[number] => Boolean(e));

    let fallback: typeof entries = [];
    if (related.length === 0) {
      fallback = entries
        .filter((e) => e.id !== entry.id && e.data.category === entry.data.category)
        .slice(0, 3);
    }

    return {
      params: { slug: entry.id },
      props: {
        kind: "mdx" as const,
        entry,
        relatedEntries: related.length > 0 ? related : fallback,
      },
    };
  });

  const catalogPaths = catalog
    .filter((a) => !mdxSlugs.has(a.slug))
    .map((a) => ({
      params: { slug: a.slug },
      props: { kind: "stub" as const, stub: a },
    }));

  return [...mdxPaths, ...catalogPaths];
}

const props = Astro.props as
  | {
      kind: "mdx";
      entry: Awaited<ReturnType<typeof getCollection<"landingpages">>>[number];
      relatedEntries: Awaited<ReturnType<typeof getCollection<"landingpages">>>;
    }
  | { kind: "stub"; stub: (typeof catalog)[number] };

let rendered: Awaited<ReturnType<typeof render>> | null = null;
if (props.kind === "mdx") {
  rendered = await render(props.entry);
}

let stubMeta = null as
  | null
  | {
      title: string;
      lead: string;
      categoryName: string;
      categorySlug: string;
      tags: string[];
    };
if (props.kind === "stub") {
  const cat = landingCategories[props.stub.category];
  stubMeta = {
    title: props.stub.title,
    lead: props.stub.lead,
    categoryName: cat.name,
    categorySlug: cat.slug,
    tags: props.stub.tags,
  };
}
---

{props.kind === "mdx" && rendered && (
  <LandingPageLayout entry={props.entry} relatedEntries={props.relatedEntries}>
    <rendered.Content />
  </LandingPageLayout>
)}

{props.kind === "stub" && stubMeta && (
  <PlaceholderPage
    title={`${stubMeta.title} | Library | IoT Fabrikken`}
    description={stubMeta.lead}
    eyebrow={`Library — ${stubMeta.categoryName}`}
    heroTitle={stubMeta.title}
    heroLead={stubMeta.lead}
    breadcrumbs={[
      { label: "Home", href: "/en/" },
      { label: "Library", href: "/en/library/" },
      { label: stubMeta.categoryName, href: `/en/library/#${stubMeta.categorySlug}` },
      { label: stubMeta.title },
    ]}
    primaryCta={{ label: "Book demo", href: "/en/contact/book-demo/" }}
    secondaryCta={{ label: `More ${stubMeta.categoryName.toLowerCase()} articles`, href: `/en/library/#${stubMeta.categorySlug}` }}
    hideNotice={true}
  >
    <h2 class="text-2xl font-bold text-navy-500 tracking-tight">Article coming soon</h2>
    <p class="mt-3 text-stone-900/80 leading-relaxed">
      This topic is part of the IoT Fabrikken library roadmap. The full
      article — with real-world examples, data excerpts and a practical
      checklist — is being written. In the meantime, the page is indexed so
      you can link to it and so we can plan the knowledge base transparently.
    </p>

    {stubMeta.tags.length > 0 && (
      <div class="mt-8">
        <p class="text-xs font-semibold uppercase tracking-wider text-stone-300">Tags</p>
        <div class="mt-2 flex flex-wrap gap-1.5">
          {stubMeta.tags.map((t) => {
            const parts = t.split(":");
            const dim = parts[0];
            const value = parts.slice(1).join(":");
            if (!value) {
              return (
                <span class="inline-block px-2 py-0.5 rounded bg-stone-50 text-[11px] font-medium text-stone-900/70 border border-stone-100">
                  {t}
                </span>
              );
            }
            return (
              <a
                href={`/en/library/tags/${dim}/${value}/`}
                class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-stone-50 hover:bg-sky-50 text-[11px] font-medium text-navy-500 border border-stone-100 hover:border-sky-500 transition-colors"
              >
                <span class="text-stone-300">{dim}</span>
                <span>{value}</span>
              </a>
            );
          })}
        </div>
      </div>
    )}

    <div class="mt-8 flex flex-wrap gap-3 text-sm">
      <a href="/en/contact/" class="text-navy-500 underline underline-offset-4 hover:text-coral-500">
        Want to co-author this article?
      </a>
      <span class="text-stone-300">·</span>
      <a href="/en/library/" class="text-navy-500 underline underline-offset-4 hover:text-coral-500">
        Browse the full library
      </a>
    </div>
  </PlaceholderPage>
)}
