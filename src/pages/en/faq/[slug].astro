---
import FaqPage from "../../../components/FaqPage.astro";
import PlaceholderPage from "../../../components/PlaceholderPage.astro";
import { faqHub } from "../../../data/site";
import { faqContent } from "../../../data/faqContent";

export function getStaticPaths() {
  return faqHub.leaves.map((leaf) => ({
    params: { slug: leaf.slug },
    props: { leaf },
  }));
}

const { leaf } = Astro.props;
const qa = faqContent[leaf.slug];
const hasContent = Array.isArray(qa) && qa.length > 0;
---

{hasContent ? (
  <FaqPage
    title={`${leaf.title.replace(/\.$/, "")} | FAQ | IoT Fabrikken`}
    description={leaf.lead}
    eyebrow={leaf.eyebrow}
    heroTitle={leaf.title}
    heroTitleAccent={leaf.titleAccent}
    heroLead={leaf.lead}
    breadcrumbs={[
      { label: "Home", href: "/en/" },
      { label: "FAQ", href: "/en/faq/" },
      { label: leaf.title.replace(/\.$/, "") },
    ]}
    qa={qa}
  />
) : (
  <PlaceholderPage
    title={`${leaf.title.replace(/\.$/, "")} | IoT Fabrikken`}
    description={leaf.lead}
    eyebrow={leaf.eyebrow}
    heroTitle={leaf.title}
    heroTitleAccent={leaf.titleAccent}
    heroLead={leaf.lead}
    breadcrumbs={[
      { label: "Home", href: "/en/" },
      { label: "FAQ", href: "/en/faq/" },
      { label: leaf.title.replace(/\.$/, "") },
    ]}
    primaryCta={leaf.primaryCta}
    secondaryCta={leaf.secondaryCta}
  />
)}
