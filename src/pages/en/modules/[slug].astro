---
import PlaceholderPage from "../../../components/PlaceholderPage.astro";
import { modulesHub } from "../../../data/site";

export function getStaticPaths() {
  return modulesHub.leaves
    // indoor-climate and space-management have dedicated rich pages; skip them here.
    .filter((leaf) => leaf.slug !== "indoor-climate" && leaf.slug !== "space-management")
    .map((leaf) => ({
      params: { slug: leaf.slug },
      props: { leaf },
    }));
}

const { leaf } = Astro.props;
---

<PlaceholderPage
  title={`${leaf.title.replace(/\.$/, "")} | IoT Fabrikken`}
  description={leaf.lead}
  heroTitle={leaf.title}
  heroTitleAccent={leaf.titleAccent}
  heroLead={leaf.lead}
  breadcrumbs={[
    { label: "Home", href: "/en/" },
    { label: "Modules", href: "/en/modules/" },
    { label: leaf.title.replace(/\.$/, "") },
  ]}
  primaryCta={leaf.primaryCta}
  secondaryCta={leaf.secondaryCta}
/>
