---
import Layout from "../../../layouts/Layout.astro";
import Hero from "../../../components/Hero.astro";
import Button from "../../../components/Button.astro";
import CtaBand from "../../../components/CtaBand.astro";
import WorkplaceInNumbers from "../../../components/WorkplaceInNumbers.astro";
---

<Layout
  title="Space management — sensors and data | IoT Fabrikken"
  description="Occupancy, booking-versus-actual-use and utilisation patterns for meeting rooms, desks and common areas."
>

  <nav class="container-page pt-6" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-1.5 text-sm text-stone-300">
      <li><a href="/en/" class="hover:text-coral-500 transition-colors">Home</a></li>
      <li aria-hidden="true">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4.5 3L7.5 6L4.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </li>
      <li><a href="/en/modules/" class="hover:text-coral-500 transition-colors">Modules</a></li>
      <li aria-hidden="true">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4.5 3L7.5 6L4.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </li>
      <li><span class="text-navy-500">Space management</span></li>
    </ol>
  </nav>

  <Hero
    title="Space management."
    titleAccent="How your rooms really get used."
    lead="Occupancy, booking-versus-actual-use and utilisation patterns for meeting rooms, desks and common areas."
    align="left"
    compactTop
  >
    <Button href="/en/contact/book-demo/" variant="primary" size="lg" slot="cta">Book a free demo</Button>
    <Button href="/en/contact/sales/" variant="secondary" size="lg" slot="cta">Contact sales</Button>
  </Hero>

  <WorkplaceInNumbers />

  <CtaBand
    title="Want to know more already now?"
    subtitle="Get in touch — we're always happy to have a no-strings chat."
    primaryLabel="Book a free demo"
    primaryHref="/en/contact/book-demo/"
    secondaryLabel="Contact sales"
    secondaryHref="/en/contact/sales/"
  />
</Layout>
