---
import PlaceholderPage from "../../../../components/PlaceholderPage.astro";
import { sensorsHub } from "../../../../data/site";

export function getStaticPaths() {
  return sensorsHub.leaves
    // The compare tool is not a purchasable product.
    .filter((leaf) => leaf.slug !== "compare")
    .map((leaf) => ({
      params: { slug: leaf.slug },
      props: { leaf },
    }));
}

const { leaf } = Astro.props;
---

<PlaceholderPage
  title={`${leaf.title.replace(/\.$/, "")} — product | IoT Fabrikken shop`}
  description={leaf.lead}
  eyebrow={`Product — ${leaf.eyebrow}`}
  heroTitle={leaf.title}
  heroTitleAccent={leaf.titleAccent}
  heroLead={leaf.lead}
  breadcrumbs={[
    { label: "Home", href: "/en/" },
    { label: "Shop", href: "/en/shop/" },
    { label: "Products", href: "/en/shop/products/" },
    { label: leaf.title.replace(/\.$/, "") },
  ]}
  primaryCta={{ label: "Add to cart", href: "/en/shop/cart/" }}
  secondaryCta={{ label: "See technical spec", href: `/en/sensors/${leaf.slug}/` }}
/>
