---
import Layout from "../../../../layouts/Layout.astro";
import Hero from "../../../../components/Hero.astro";
import Button from "../../../../components/Button.astro";
import CtaBand from "../../../../components/CtaBand.astro";
import { sensorsHub } from "../../../../data/site";
---

<Layout
  title="Products | Shop | IoT Fabrikken"
  description="Browse every RoomAlyzer sensor and gateway available to order online."
>
  <nav class="container-page pt-6" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-1.5 text-sm text-stone-300">
      <li><a href="/en/" class="hover:text-coral-500 transition-colors">Home</a></li>
      <li aria-hidden="true">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4.5 3L7.5 6L4.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </li>
      <li><a href="/en/shop/" class="hover:text-coral-500 transition-colors">Shop</a></li>
      <li aria-hidden="true">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4.5 3L7.5 6L4.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </li>
      <li><span class="text-navy-500">Products</span></li>
    </ol>
  </nav>

  <Hero
    eyebrow="Shop"
    title="All products."
    titleAccent="Pick what fits your rooms."
    lead="Every sensor in the RoomAlyzer catalogue is available to order online. Click through to see the specs and add to your cart."
    align="left"
  >
    <Button href="/en/shop/cart/" variant="primary" size="lg" slot="cta">Go to cart</Button>
    <Button href="/en/sensors/compare/" variant="secondary" size="lg" slot="cta">Compare sensors</Button>
  </Hero>

  <section class="py-16 md:py-20">
    <div class="container-page">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {sensorsHub.leaves
          // The compare tool is not a purchasable product.
          .filter((l) => l.slug !== "compare")
          .map((leaf) => (
            <a
              href={`/en/shop/products/${leaf.slug}/`}
              class="reveal group flex flex-col p-6 md:p-7 bg-white border border-stone-100 rounded-xl hover:border-navy-500 hover:-translate-y-1 hover:shadow-lg transition-all duration-300"
            >
              <div class="absolute top-0 left-0 right-0 h-1 rounded-t-xl bg-sky-500"></div>
              <p class="inline-block px-2.5 py-1 rounded-md bg-stone-50 text-navy-500 text-[11px] font-semibold uppercase tracking-wider mb-4 self-start">
                {leaf.eyebrow}
              </p>
              <h3 class="text-lg font-semibold text-navy-500 mb-2 leading-snug">
                {leaf.title}
                {leaf.titleAccent && (
                  <span class="block text-sky-600 text-base font-medium mt-0.5">{leaf.titleAccent}</span>
                )}
              </h3>
              <p class="text-sm text-stone-900/70 leading-relaxed flex-1">{leaf.lead}</p>
              <div class="mt-5 inline-flex items-center gap-1 text-sm font-medium text-navy-500 group-hover:text-sky-600 transition-colors">
                View product
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="transition-transform group-hover:translate-x-1">
                  <path d="M3 7h8M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>
            </a>
          ))}
      </div>
    </div>
  </section>

  <CtaBand
    title="Not sure which sensor fits your rooms?"
    subtitle="We'll help you put together a configuration that matches your building."
    primaryLabel="Book demo"
    secondaryLabel="Contact sales"
  />
</Layout>
