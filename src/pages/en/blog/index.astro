---
import Layout from "../../../layouts/Layout.astro";
import Hero from "../../../components/Hero.astro";
import Button from "../../../components/Button.astro";
import CtaBand from "../../../components/CtaBand.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const formatDate = (d: Date) =>
  d.toLocaleDateString("en-GB", { year: "numeric", month: "long", day: "numeric" });
---

<Layout
  title="Blog | IoT Fabrikken"
  description="News, opinion and longer reads on smart buildings, preservation, PropTech and the IoT Fabrikken product."
>
  <nav class="container-page pt-6" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-1.5 text-sm text-stone-300">
      <li><a href="/en/" class="hover:text-coral-500 transition-colors">Home</a></li>
      <li aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4.5 3L7.5 6L4.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></li>
      <li><span class="text-navy-500">Blog</span></li>
    </ol>
  </nav>

  <Hero
    title="News and trends."
    titleAccent="From the world of smart buildings."
    lead="Longer reads on smart buildings, PropTech, indoor climate and the evolution of our own product."
    align="left"
    compactTop
  >
    <Button href="/en/library/" variant="primary" size="lg" slot="cta">Browse library</Button>
    <Button href="/rss.xml" variant="secondary" size="lg" slot="cta">RSS feed</Button>
  </Hero>

  <section class="py-14">
    <div class="container-page max-w-3xl">
      {posts.length === 0 ? (
        <div class="bg-white border border-stone-100 rounded-xl p-10 text-center">
          <h2 class="text-2xl font-semibold text-navy-500">No posts yet</h2>
          <p class="mt-3 text-stone-900/70">
            Our first posts are on their way. In the meantime, head over to the
            <a href="/en/library/" class="underline text-sky-600 hover:text-coral-500"> library</a>.
          </p>
        </div>
      ) : (
        <ol class="space-y-6">
          {posts.map((p) => (
            <li class="bg-white border border-stone-100 rounded-xl p-6 hover:border-navy-500 transition-colors">
              <a href={`/en/blog/${p.id}/`} class="block group">
                <div class="flex items-center gap-3 text-xs font-semibold uppercase tracking-wider text-stone-300">
                  <time datetime={p.data.pubDate.toISOString()}>{formatDate(p.data.pubDate)}</time>
                  <span aria-hidden="true">·</span>
                  <span>{p.data.author}</span>
                </div>
                <h2 class="mt-2 text-xl md:text-2xl font-bold text-navy-500 group-hover:text-coral-500 transition-colors leading-snug">
                  {p.data.title}
                </h2>
                <p class="mt-2 text-stone-900/70 leading-relaxed">{p.data.description}</p>
                {p.data.tags && p.data.tags.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-1.5">
                    {p.data.tags.map((t) => (
                      <span class="inline-block px-2 py-0.5 rounded bg-stone-50 text-[11px] font-medium text-stone-900/70 border border-stone-100">
                        {t}
                      </span>
                    ))}
                  </div>
                )}
              </a>
            </li>
          ))}
        </ol>
      )}
    </div>
  </section>

  <CtaBand
    title="Want to contribute a guest post?"
    subtitle="Customers, partners and industry experts — we'd love to feature your work."
    primaryLabel="Pitch a post"
    primaryHref="/en/contact/"
    secondaryLabel="Browse library"
    secondaryHref="/en/library/"
  />
</Layout>
