---
import Layout from "../../../layouts/Layout.astro";
import Hero from "../../../components/Hero.astro";
import Button from "../../../components/Button.astro";
import { careersContact, getCareersIntro, getOpenPositions } from "../../../data/careers";
import { getAbout } from "../../../data/i18n/about";
import { locales, langPath, type Lang } from "../../../data/lang";

export function getStaticPaths() {
  return locales.map((l) => ({ params: { lang: l.code } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = getAbout(lang);
const careersIntro = getCareersIntro(lang);
const openPositions = getOpenPositions(lang);
const roleCountLabel = `${openPositions.length} ${openPositions.length === 1 ? t.careers.roleSingular : t.careers.rolePlural}`;
const unsolicitedSubject = encodeURIComponent(t.careers.unsolicitedSubject);
---

<Layout title={t.careers.metaTitle} description={careersIntro.lead} flushFooter>
  <nav class="container-page pt-6" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-1.5 text-sm text-stone-300">
      <li><a href={langPath("", lang)} class="hover:text-coral-500 transition-colors">{t.common.home}</a></li>
      <li aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4.5 3L7.5 6L4.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></li>
      <li><a href={langPath("about", lang)} class="hover:text-coral-500 transition-colors">{t.common.about}</a></li>
      <li aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4.5 3L7.5 6L4.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></li>
      <li><span class="text-navy-500">{t.careers.crumb}</span></li>
    </ol>
  </nav>

  <Hero
    title={t.careers.heroTitle}
    titleAccent={t.careers.heroTitleAccent}
    lead={careersIntro.lead}
    align="left"
    compactTop
  >
    <Button href={langPath("about/team", lang)} variant="primary" size="lg" slot="cta">{t.careers.heroPrimary}</Button>
    <Button href={langPath("contact", lang)} variant="secondary" size="lg" slot="cta">{t.careers.heroSecondary}</Button>
  </Hero>

  <section id="open-roles" class="py-14 md:py-20 bg-white">
    <div class="container-page max-w-4xl">
      <div class="flex items-center gap-3">
        <span class="h-px w-10 bg-coral-500" aria-hidden="true"></span>
        <span class="text-xs font-semibold uppercase tracking-[0.18em] text-coral-500">
          {roleCountLabel}
        </span>
      </div>
      <h2 class="mt-3 text-3xl md:text-4xl font-bold text-navy-500 tracking-tight">
        {t.careers.openPositions}
      </h2>
      <p class="mt-3 text-stone-900/70 leading-relaxed max-w-2xl">
        {t.careers.openPositionsIntro}
      </p>

      {openPositions.length > 0 ? (
        <ul class="mt-10 space-y-5">
          {openPositions.map((job) => (
            <li>
              <article class="group relative bg-white border border-stone-100 rounded-xl p-6 md:p-8 shadow-sm hover:shadow-md hover:border-navy-500 transition-all">
                <span class="absolute left-0 top-6 bottom-6 w-1 rounded-r bg-coral-500 opacity-0 group-hover:opacity-100 transition-opacity" aria-hidden="true"></span>
                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
                  <div>
                    <h3 class="text-lg md:text-xl font-semibold text-navy-500">{job.title}</h3>
                    <p class="mt-1 text-sm text-coral-500 font-medium">{job.location}</p>
                    <p class="mt-3 text-stone-900/80 leading-relaxed">{job.summary}</p>
                  </div>
                  <Button
                    href={langPath(`about/careers/${job.slug}`, lang)}
                    variant="primary"
                    size="md"
                    class="shrink-0 self-start"
                  >
                    {t.careers.readMore}
                  </Button>
                </div>
              </article>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-8 text-stone-900/80 leading-relaxed">
          {t.careers.noOpenings}
        </p>
      )}
    </div>
  </section>

  <section id="unsolicited" class="flex-1 pb-14 md:pb-16 bg-stone-50 border-t border-stone-100">
    <div class="container-page max-w-4xl pt-10 md:pt-12">
      <h2 class="text-lg font-semibold text-navy-500">{t.careers.unsolicitedHeading}</h2>
      <p class="mt-2 text-sm text-stone-900/70 leading-relaxed max-w-2xl">
        {t.careers.unsolicitedText}
      </p>
      <div class="mt-5 flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-4">
        <Button
          href={`mailto:${careersContact.email}?subject=${unsolicitedSubject}`}
          variant="secondary"
          size="sm"
        >
          {t.careers.sendApplication}
        </Button>
        <div class="flex flex-wrap gap-x-5 gap-y-1 text-sm text-stone-900/70">
          <a
            href={`mailto:${careersContact.email}`}
            class="font-medium text-navy-500 hover:text-coral-500 underline underline-offset-4"
          >
            {careersContact.email}
          </a>
          <a
            href={`tel:${careersContact.phone.replace(/\s+/g, "")}`}
            class="font-medium text-navy-500 hover:text-coral-500 underline underline-offset-4"
          >
            {careersContact.phone}
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
