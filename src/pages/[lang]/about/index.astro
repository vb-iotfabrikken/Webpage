---
import Layout from "../../../layouts/Layout.astro";
import Hero from "../../../components/Hero.astro";
import Button from "../../../components/Button.astro";
import CtaBand from "../../../components/CtaBand.astro";
import AboutHubSection from "../../../components/AboutHubSection.astro";
import { getAboutHub } from "../../../data/hubs/about";
import { getAbout } from "../../../data/i18n/about";
import { locales, langPath, type Lang } from "../../../data/lang";

export function getStaticPaths() {
  return locales.map((l) => ({ params: { lang: l.code } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = getAbout(lang);
const aboutHub = getAboutHub(lang);
const bookDemoHref = langPath("contact/book-demo", lang);
const contactSalesHref = langPath("contact/sales", lang);
---

<Layout title={t.hub.metaTitle} description={aboutHub.lead}>
  <nav class="container-page pt-6" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-1.5 text-sm text-stone-300">
      <li><a href={langPath("", lang)} class="hover:text-coral-500 transition-colors">{t.common.home}</a></li>
      <li aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4.5 3L7.5 6L4.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></li>
      <li><span class="text-navy-500">{t.common.about}</span></li>
    </ol>
  </nav>

  <Hero
    title={aboutHub.title}
    titleAccent={aboutHub.titleAccent}
    lead={aboutHub.lead}
    align="left"
    compactTop
  >
    <Button href={bookDemoHref} variant="primary" size="lg" slot="cta">{t.common.bookDemo}</Button>
    <Button href={contactSalesHref} variant="secondary" size="lg" slot="cta">{t.common.contactSales}</Button>
  </Hero>

  <AboutHubSection lang={lang} />

  <CtaBand
    title={t.hub.ctaTitle}
    subtitle={t.hub.ctaSubtitle}
    primaryLabel={t.common.bookDemo}
    primaryHref={bookDemoHref}
    secondaryLabel={t.common.contactSales}
    secondaryHref={contactSalesHref}
  />
</Layout>
