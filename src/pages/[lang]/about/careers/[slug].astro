---
import Layout from "../../../../layouts/Layout.astro";
import Hero from "../../../../components/Hero.astro";
import Button from "../../../../components/Button.astro";
import { careersContact, getOpenPositions, type JobOpening } from "../../../../data/careers";
import { getAbout } from "../../../../data/i18n/about";
import { locales, langPath, type Lang } from "../../../../data/lang";

export function getStaticPaths() {
  return locales.flatMap((l) =>
    getOpenPositions(l.code).map((job) => ({
      params: { lang: l.code, slug: job.slug },
      props: { job },
    })),
  );
}

const { lang } = Astro.params as { lang: Lang; slug: string };
const { job } = Astro.props as { job: JobOpening };
const t = getAbout(lang);
const mailSubject = encodeURIComponent(`${t.careers.applicationSubjectPrefix} ${job.title}`);
const mailtoApply = `mailto:${careersContact.email}?subject=${mailSubject}`;
---

<Layout title={`${job.title} | IoT Fabrikken`} description={job.summary}>
  <nav class="container-page pt-6" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-1.5 text-sm text-stone-300">
      <li><a href={langPath("", lang)} class="hover:text-coral-500 transition-colors">{t.common.home}</a></li>
      <li aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4.5 3L7.5 6L4.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></li>
      <li><a href={langPath("about", lang)} class="hover:text-coral-500 transition-colors">{t.common.about}</a></li>
      <li aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4.5 3L7.5 6L4.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></li>
      <li><a href={langPath("about/careers", lang)} class="hover:text-coral-500 transition-colors">{t.careers.crumb}</a></li>
      <li aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4.5 3L7.5 6L4.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></li>
      <li><span class="text-navy-500">{job.title}</span></li>
    </ol>
  </nav>

  <Hero
    title={job.title}
    titleAccent={job.tagline}
    lead={job.intro}
    align="left"
    compactTop
  >
    <Button href={mailtoApply} variant="primary" size="lg" slot="cta">{t.careers.applyByEmail}</Button>
    {job.externalApplyUrl && (
      <Button href={job.externalApplyUrl} variant="secondary" size="lg" slot="cta">
        {t.careers.applyOnJobindex}
      </Button>
    )}
  </Hero>

  <section class="py-14">
    <div class="container-page max-w-3xl space-y-12">
      <div>
        <h2 class="text-xl font-bold text-navy-500 tracking-tight pb-3 border-b border-stone-100">
          {job.roleTitle}
        </h2>
        <ul class="mt-6 space-y-3">
          {job.responsibilities.map((item) => (
            <li class="flex gap-3 text-stone-900/80 leading-relaxed">
              <span class="shrink-0 mt-1.5 w-1.5 h-1.5 rounded-full bg-coral-500" aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="text-xl font-bold text-navy-500 tracking-tight pb-3 border-b border-stone-100">
          {t.careers.aboutYou}
        </h2>
        <p class="mt-4 text-stone-900/80 leading-relaxed">{job.aboutYouIntro}</p>
        <ul class="mt-6 space-y-3">
          {job.aboutYou.map((item) => (
            <li class="flex gap-3 text-stone-900/80 leading-relaxed">
              <span class="shrink-0 mt-1.5 w-1.5 h-1.5 rounded-full bg-coral-500" aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="text-xl font-bold text-navy-500 tracking-tight pb-3 border-b border-stone-100">
          {t.careers.whatWeOffer}
        </h2>
        <ul class="mt-6 space-y-3">
          {job.weOffer.map((item) => (
            <li class="flex gap-3 text-stone-900/80 leading-relaxed">
              <span class="shrink-0 mt-1.5 w-1.5 h-1.5 rounded-full bg-coral-500" aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="text-xl font-bold text-navy-500 tracking-tight pb-3 border-b border-stone-100">
          {t.careers.aboutCompany}
        </h2>
        {job.aboutCompany.map((paragraph) => (
          <p class="mt-4 text-stone-900/80 leading-relaxed">{paragraph}</p>
        ))}
      </div>

      <div class="bg-stone-50 border border-stone-100 rounded-xl p-6 md:p-8">
        <h2 class="text-xl font-bold text-navy-500 tracking-tight">{t.careers.practicalDetails}</h2>
        <dl class="mt-4 space-y-3">
          {job.practical.map((row) => (
            <div class="flex flex-col sm:flex-row sm:justify-between gap-1 pb-3 border-b border-stone-100 last:border-0 last:pb-0">
              <dt class="text-sm text-stone-300">{row.label}</dt>
              <dd class="text-sm font-medium text-navy-500 sm:text-right">
                {row.value === careersContact.email ? (
                  <a href={mailtoApply} class="hover:text-coral-500 underline underline-offset-4">
                    {row.value}
                  </a>
                ) : (
                  row.value
                )}
              </dd>
            </div>
          ))}
        </dl>

        {job.hiringContact && (
          <p class="mt-6 text-sm text-stone-900/80 leading-relaxed">
            {t.careers.contactInvitePrefix}{" "}
            <span class="font-semibold text-navy-500">{job.hiringContact.name}</span>,{" "}
            {job.hiringContact.role},{" "}
            <a
              href={`tel:${job.hiringContact.phone.replace(/\s+/g, "")}`}
              class="text-navy-500 font-medium hover:text-coral-500 underline underline-offset-4"
            >
              {job.hiringContact.phone}
            </a>
            .
          </p>
        )}

        <div class="mt-6 flex flex-wrap gap-3">
          <Button href={mailtoApply} variant="primary" size="md">{t.careers.applyByEmail}</Button>
          <Button href={langPath("about/careers", lang)} variant="secondary" size="md">{t.careers.allOpenRoles}</Button>
        </div>
      </div>
    </div>
  </section>
</Layout>
