---
import Layout from "../../../layouts/Layout.astro";
import Hero from "../../../components/Hero.astro";
import Button from "../../../components/Button.astro";
import CtaBand from "../../../components/CtaBand.astro";
import { getTeam, getDepartments, teamGroupPhoto } from "../../../data/team";
import { getAbout } from "../../../data/i18n/about";
import { locales, langPath, type Lang } from "../../../data/lang";

export function getStaticPaths() {
  return locales.map((l) => ({ params: { lang: l.code } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = getAbout(lang);
const team = getTeam(lang);
const departments = getDepartments(lang);

const grouped = new Map<(typeof team)[number]["department"], typeof team>();
for (const m of team) {
  const list = grouped.get(m.department) ?? [];
  list.push(m);
  grouped.set(m.department, list);
}

const departmentOrder: (keyof typeof departments)[] = [
  "leadership",
  "sales",
  "engineering",
  "customer-success",
  "operations",
  "communications",
];
---

<Layout title={t.team.metaTitle} description={t.team.metaDescription}>
  <nav class="container-page pt-6" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-1.5 text-sm text-stone-300">
      <li><a href={langPath("", lang)} class="hover:text-coral-500 transition-colors">{t.common.home}</a></li>
      <li aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4.5 3L7.5 6L4.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></li>
      <li><a href={langPath("about", lang)} class="hover:text-coral-500 transition-colors">{t.common.about}</a></li>
      <li aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4.5 3L7.5 6L4.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></li>
      <li><span class="text-navy-500">{t.team.crumb}</span></li>
    </ol>
  </nav>

  <Hero
    title={t.team.heroTitle}
    titleAccent={t.team.heroTitleAccent}
    lead={t.team.heroLead}
    align="left"
    compactTop
  >
    <Button href={langPath("about/careers", lang)} variant="primary" size="lg" slot="cta">{t.team.heroPrimary}</Button>
    <Button href={langPath("contact", lang)} variant="secondary" size="lg" slot="cta">{t.team.heroSecondary}</Button>
  </Hero>

  <section class="pb-8 md:pb-12" data-hero-gap-keep>
    <div class="container-page">
      <figure class="reveal overflow-hidden rounded-2xl border border-stone-100 bg-stone-100 shadow-sm">
        <img
          src={teamGroupPhoto.src}
          alt={teamGroupPhoto.alt}
          width={1600}
          height={1052}
          loading="eager"
          decoding="async"
          class="w-full h-auto"
        />
      </figure>
    </div>
  </section>

  <section class="py-14 md:py-16">
    <div class="container-page">
      {departmentOrder.map((dept) => {
        const members = grouped.get(dept) ?? [];
        if (members.length === 0) return null;
        const meta = departments[dept];
        return (
          <div class="mb-14 md:mb-16 last:mb-0">
            <div class="mb-8 pb-4 border-b border-stone-100">
              <h2 class="text-2xl md:text-3xl font-bold text-navy-500 tracking-tight">{meta.label}</h2>
              <p class="mt-1 text-stone-900/70 max-w-2xl">{meta.blurb}</p>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 md:gap-4 justify-items-center items-stretch">
              {members.map((m) => {
                if (m.placeholder && m.href) {
                  return (
                    <a
                      href={m.href}
                      class="group flex flex-col w-[148px] sm:w-[168px] h-full bg-stone-50 border border-dashed border-stone-200 rounded-lg overflow-hidden hover:border-sky-400 hover:bg-sky-50/40 transition-all duration-300"
                    >
                      <div class="w-full aspect-[3/4] flex flex-col items-center justify-center gap-2 bg-stone-100/80 text-stone-400 group-hover:text-sky-600 transition-colors">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                          <circle cx="9" cy="7" r="4" />
                          <line x1="19" y1="8" x2="19" y2="14" />
                          <line x1="22" y1="11" x2="16" y2="11" />
                        </svg>
                      </div>
                      <div class="flex flex-col flex-1 p-3 min-h-[7.25rem] text-center">
                        <h3 class="text-base font-semibold text-navy-500 leading-snug group-hover:text-sky-600 transition-colors">
                          {m.name}
                        </h3>
                        <p class="mt-0.5 text-xs font-medium text-sky-600">{m.role}</p>
                        <span class="mt-3 inline-flex items-center justify-center gap-1 text-xs font-medium text-navy-500 group-hover:text-sky-600">
                          {t.team.viewOpenRoles}
                          <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">
                            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                          </svg>
                        </span>
                      </div>
                    </a>
                  );
                }

                return (
                  <article class="group flex flex-col w-[148px] sm:w-[168px] h-full bg-white border border-stone-100 rounded-lg overflow-hidden hover:border-navy-500/40 hover:shadow-md transition-all duration-300">
                    {m.photo ? (
                      <div class="relative w-full aspect-[3/4] shrink-0 overflow-hidden bg-stone-100">
                        <img
                          src={m.photo}
                          alt={`Portrait of ${m.name}`}
                          width={768}
                          height={1024}
                          loading="lazy"
                          decoding="async"
                          class="absolute inset-0 h-full w-full object-cover object-center"
                        />
                      </div>
                    ) : (
                      <div
                        class="w-full aspect-[3/4] bg-stone-100 flex items-center justify-center text-2xl font-semibold text-navy-500/30"
                        aria-hidden="true"
                      >
                        {m.name.split(" ").map((p) => p[0]).slice(0, 2).join("")}
                      </div>
                    )}
                    <div class="flex flex-col flex-1 p-3 min-h-[7.25rem]">
                      <h3 class="text-base font-semibold text-navy-500 leading-snug">{m.name}</h3>
                      <p class="mt-0.5 text-xs font-medium text-sky-600 leading-snug">{m.role}</p>
                      {(m.email || m.phone) && (
                        <ul class="mt-auto pt-3 border-t border-stone-100 space-y-1 text-xs">
                          {m.email && (
                            <li>
                              <a
                                href={`mailto:${m.email}`}
                                class="text-navy-500 hover:text-sky-600 transition-colors break-all"
                              >
                                {m.email}
                              </a>
                            </li>
                          )}
                          {m.phone && (
                            <li>
                              <a
                                href={`tel:${m.phone.replace(/\s/g, "")}`}
                                class="text-stone-900/60 hover:text-sky-600 transition-colors"
                              >
                                {m.phone}
                              </a>
                            </li>
                          )}
                        </ul>
                      )}
                    </div>
                  </article>
                );
              })}
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <CtaBand
    title={t.team.ctaTitle}
    subtitle={t.team.ctaSubtitle}
    primaryLabel={t.team.ctaPrimary}
    primaryHref={langPath("about/careers", lang)}
    secondaryLabel={t.team.ctaSecondary}
    secondaryHref={langPath("contact", lang)}
  />
</Layout>
