---
import Layout from "../../../layouts/Layout.astro";
import Hero from "../../../components/Hero.astro";
import Button from "../../../components/Button.astro";
import PartnerGrid from "../../../components/PartnerGrid.astro";
import { getPartners, getPartnersIntro } from "../../../data/partners";
import { getAbout } from "../../../data/i18n/about";
import { locales, langPath, type Lang } from "../../../data/lang";

export function getStaticPaths() {
  return locales.map((l) => ({ params: { lang: l.code } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = getAbout(lang);
const partners = getPartners(lang);
const partnersIntro = getPartnersIntro(lang);
---

<Layout title={t.partners.metaTitle} description={partnersIntro.lead}>
  <nav class="container-page pt-6" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-1.5 text-sm text-stone-300">
      <li><a href={langPath("", lang)} class="hover:text-coral-500 transition-colors">{t.common.home}</a></li>
      <li aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4.5 3L7.5 6L4.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></li>
      <li><a href={langPath("about", lang)} class="hover:text-coral-500 transition-colors">{t.common.about}</a></li>
      <li aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4.5 3L7.5 6L4.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></li>
      <li><span class="text-navy-500">{t.partners.crumb}</span></li>
    </ol>
  </nav>

  <Hero
    title={t.partners.heroTitle}
    titleAccent={partnersIntro.title}
    lead={partnersIntro.lead}
    align="left"
    compactTop
  >
    <Button href={langPath("contact/become-partner", lang)} variant="primary" size="lg" slot="cta">{t.partners.heroPrimary}</Button>
    <Button href={langPath("contact/sales", lang)} variant="secondary" size="lg" slot="cta">{t.partners.heroSecondary}</Button>
  </Hero>

  <section class="py-14 md:py-20">
    <div class="container-page">
      <PartnerGrid partners={partners} />
    </div>
  </section>

  <section class="pb-16 md:pb-20">
    <div class="container-page max-w-3xl">
      <div class="bg-stone-50 border border-stone-100 rounded-xl p-8 md:p-10">
        <h2 class="text-xl md:text-2xl font-bold text-navy-500 tracking-tight">
          {t.partners.interestedHeading}
        </h2>
        <p class="mt-3 text-stone-900/80 leading-relaxed">
          {t.partners.interestedBody}
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <Button href={langPath("contact/become-partner", lang)} variant="primary" size="md">
            {t.partners.becomePartner}
          </Button>
          <Button href={langPath("integrations", lang)} variant="secondary" size="md">
            {t.partners.viewIntegrations}
          </Button>
        </div>
      </div>
    </div>
  </section>
</Layout>
