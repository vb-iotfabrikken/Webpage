---
import Layout from "../../../layouts/Layout.astro";
import Hero from "../../../components/Hero.astro";
import Button from "../../../components/Button.astro";
import CtaBand from "../../../components/CtaBand.astro";
import { getGlossary, getGlossaryByAnchor } from "../../../data/glossary";
import { getGlossaryChrome } from "../../../data/i18n/glossary";
import { getLegal } from "../../../data/i18n/legal";
import { articlesIndexPath, langPath, locales, type Lang } from "../../../data/lang";

export function getStaticPaths() {
  return locales.map((l) => ({ params: { lang: l.code } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = getLegal(lang).common;
const chrome = getGlossaryChrome(lang);
const glossary = getGlossary(lang);
const glossaryByAnchor = getGlossaryByAnchor(lang);
const homeHref = langPath("", lang);
const articlesHref = articlesIndexPath(lang);
const contactHref = langPath("contact", lang);
const salesHref = langPath("contact/sales", lang);
const bookDemoHref = langPath("contact/book-demo", lang);
const glossaryBase = `https://iot-fabrikken.com${langPath("glossary", lang).replace(/\/$/, "")}`;

const sorted = [...glossary].sort((a, b) =>
  a.term.localeCompare(b.term, "en", { sensitivity: "base" }),
);
const groups = new Map<string, typeof sorted>();
for (const g of sorted) {
  const first = g.term[0].toUpperCase();
  const letter = /[A-Z]/.test(first) ? first : "#";
  const list = groups.get(letter) ?? [];
  list.push(g);
  groups.set(letter, list);
}
const letters = Array.from(groups.keys()).sort();

const termCountLabel = (n: number) =>
  n === 1 ? chrome.termCount.one : chrome.termCount.other;

// Build DefinedTerm JSON-LD for every entry.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  name: chrome.jsonLdName,
  hasDefinedTerm: sorted.map((g) => ({
    "@type": "DefinedTerm",
    "@id": `${glossaryBase}#${g.anchor}`,
    name: g.term,
    alternateName: g.aka,
    description: g.detail ? `${g.short} ${g.detail}` : g.short,
    inDefinedTermSet: `${glossaryBase}/`,
  })),
};
---

<Layout title={chrome.meta.title} description={chrome.meta.description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <nav class="container-page pt-6" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-1.5 text-sm text-stone-300">
      <li><a href={homeHref} class="hover:text-coral-500 transition-colors">{t.home}</a></li>
      <li aria-hidden="true">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4.5 3L7.5 6L4.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </li>
      <li><span class="text-navy-500">{chrome.breadcrumb}</span></li>
    </ol>
  </nav>

  <Hero
    title={chrome.hero.title}
    titleAccent={chrome.hero.titleAccent}
    lead={chrome.hero.lead}
    align="left"
    compactTop
  >
    <Button href={articlesHref} variant="primary" size="lg" slot="cta">{chrome.hero.browseArticles}</Button>
    <Button href={contactHref} variant="secondary" size="lg" slot="cta">{chrome.hero.suggestTerm}</Button>

    <div slot="visual" class="reveal">
      <div class="bg-white border border-stone-100 rounded-xl p-5 md:p-6">
        <p class="text-xs font-semibold uppercase tracking-wider text-stone-300">{chrome.hero.jumpToLetter}</p>
        <div class="mt-3 flex flex-wrap gap-1">
          {letters.map((l) => (
            <a
              href={`#letter-${l}`}
              class="inline-flex w-9 h-9 items-center justify-center rounded-md bg-stone-50 text-navy-500 hover:bg-sky-500 hover:text-white border border-stone-100 hover:border-sky-500 font-semibold transition-colors"
            >
              {l}
            </a>
          ))}
        </div>
      </div>
    </div>
  </Hero>

  <section class="py-14">
    <div class="container-page max-w-3xl">
      {letters.map((l) => {
        const entries = groups.get(l)!;
        return (
          <section id={`letter-${l}`} class="reveal scroll-mt-24 mb-12">
            <div class="flex items-baseline gap-3 mb-5 pb-2 border-b border-stone-100">
              <h2 class="text-3xl md:text-4xl font-bold text-navy-500 tracking-tight">{l}</h2>
              <span class="text-xs font-semibold uppercase tracking-wider text-stone-300">
                {entries.length} {termCountLabel(entries.length)}
              </span>
            </div>

            <dl class="bg-white border border-stone-100 rounded-xl divide-y divide-stone-100">
              {entries.map((g) => (
                <div id={g.anchor} class="p-5 scroll-mt-24">
                  <dt class="flex flex-wrap items-baseline gap-3">
                    <span class="text-lg font-semibold text-navy-500">{g.term}</span>
                    {g.aka && g.aka.length > 0 && (
                      <span class="text-sm text-stone-300 italic">
                        {g.aka.join(" · ")}
                      </span>
                    )}
                    <a
                      href={`#${g.anchor}`}
                      aria-label={chrome.permalinkAria(g.term)}
                      class="ml-auto text-xs text-stone-300 hover:text-coral-500 transition-colors"
                    >
                      #
                    </a>
                  </dt>
                  <dd class="mt-2 text-stone-900/80 leading-relaxed">
                    {g.short}
                  </dd>
                  {g.detail && (
                    <dd class="mt-2 text-sm text-stone-900/70 leading-relaxed">
                      {g.detail}
                    </dd>
                  )}
                  {g.seeAlso && g.seeAlso.length > 0 && (
                    <dd class="mt-3 flex flex-wrap gap-1.5">
                      <span class="text-[11px] font-semibold uppercase tracking-wider text-stone-300">{chrome.seeAlso}</span>
                      {g.seeAlso.map((a) => {
                        const target = glossaryByAnchor[a];
                        if (!target) return null;
                        return (
                          <a
                            href={`#${target.anchor}`}
                            class="inline-block px-2 py-0.5 rounded bg-stone-50 hover:bg-sky-50 text-[11px] font-medium text-navy-500 border border-stone-100 hover:border-sky-500 transition-colors"
                          >
                            {target.term}
                          </a>
                        );
                      })}
                    </dd>
                  )}
                </div>
              ))}
            </dl>
          </section>
        );
      })}
    </div>
  </section>

  <CtaBand
    title={chrome.cta.title}
    subtitle={chrome.cta.subtitle}
    primaryLabel={chrome.cta.primary}
    primaryHref={salesHref}
    secondaryLabel={chrome.cta.secondary}
    secondaryHref={bookDemoHref}
  />
</Layout>
