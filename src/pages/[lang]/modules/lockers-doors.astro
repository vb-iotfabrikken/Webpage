---
import ModuleLandingPage from "../../../components/modules/ModuleLandingPage.astro";
import { getLockersDoors } from "../../../data/i18n/lockersDoors";
import { lockersDoorsDashboard, lockersDoorsFeatureImages, lockersDoorsCapabilitiesContext } from "../../../data/lockersDoorsImages";
import { locales, langPath, type Lang } from "../../../data/lang";

export function getStaticPaths() {
  return locales.map((l) => ({ params: { lang: l.code } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = getLockersDoors(lang);
---

<ModuleLandingPage
  lang={lang}
  moduleSlug="lockers-doors"
  t={t}
  dashboard={lockersDoorsDashboard}
  featureImages={lockersDoorsFeatureImages}
  relatedModuleHref={langPath("/modules/space-management/", lang)}
  featureTabId="lockers-doors-features"
  challengeIconSet="access"
  heroInlineTitleAccent
  secondaryAudienceIcon="workspace"
  capabilitiesContext={lockersDoorsCapabilitiesContext}
/>
