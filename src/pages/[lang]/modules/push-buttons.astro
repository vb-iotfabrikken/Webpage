---
import ModuleLandingPage from "../../../components/modules/ModuleLandingPage.astro";
import { getPushButtons } from "../../../data/i18n/pushButtons";
import { pushButtonsDashboard, pushButtonsFeatureImages, pushButtonsCapabilitiesContext } from "../../../data/pushButtonsImages";
import { locales, langPath, type Lang } from "../../../data/lang";

export function getStaticPaths() {
  return locales.map((l) => ({ params: { lang: l.code } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = getPushButtons(lang);
---

<ModuleLandingPage
  lang={lang}
  moduleSlug="push-buttons"
  t={t}
  dashboard={pushButtonsDashboard}
  featureImages={pushButtonsFeatureImages}
  relatedModuleHref={langPath("/modules/usage-cleaning/", lang)}
  featureTabId="push-buttons-features"
  challengeIconSet="service"
  secondaryAudienceIcon="service"
  capabilitiesContext={pushButtonsCapabilitiesContext}
/>
