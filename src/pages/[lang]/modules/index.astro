---
import Layout from "../../../layouts/Layout.astro";
import Hero from "../../../components/Hero.astro";
import Button from "../../../components/Button.astro";
import CtaBand from "../../../components/CtaBand.astro";
import ModulesSection from "../../../components/ModulesSection.astro";
import { getModulesHub } from "../../../data/hubs/modules";
import { getUi } from "../../../data/i18n/ui";
import { locales, langPath, type Lang } from "../../../data/lang";

export function getStaticPaths() {
  return locales.map((l) => ({ params: { lang: l.code } }));
}

const { lang } = Astro.params as { lang: Lang };
const hub = getModulesHub(lang);
const t = getUi(lang).modules;
---

<Layout
  title={`${hub.title.replace(/[.,]\s*$/, "")} | IoT Fabrikken`}
  description={hub.lead}
>
  <nav class="container-page pt-6" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-1.5 text-sm text-stone-300">
      <li class="flex items-center gap-1.5">
        <a href={langPath("/", lang)} class="hover:text-coral-500 transition-colors">{t.breadcrumb.home}</a>
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M4.5 3L7.5 6L4.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </li>
      <li><span class="text-navy-500">{t.breadcrumb.modules}</span></li>
    </ol>
  </nav>

  <Hero
    title={hub.title}
    titleAccent={hub.titleAccent}
    lead={hub.lead}
    align="left"
    compactTop
  >
    <Button href={langPath("/contact/book-demo/", lang)} variant="primary" size="lg" slot="cta">{t.common.bookDemo}</Button>
    <Button href={langPath("/contact/sales/", lang)} variant="secondary" size="lg" slot="cta">{t.common.contactSales}</Button>
  </Hero>

  <ModulesSection lang={lang} />

  <CtaBand
    title={t.index.ctaTitle}
    subtitle={t.index.ctaSubtitle}
    primaryLabel={t.common.bookDemo}
    primaryHref={langPath("/contact/book-demo/", lang)}
    secondaryLabel={t.common.contactSales}
    secondaryHref={langPath("/contact/sales/", lang)}
  />
</Layout>
