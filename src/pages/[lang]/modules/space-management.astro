---
import Layout from "../../../layouts/Layout.astro";
import Hero from "../../../components/Hero.astro";
import Button from "../../../components/Button.astro";
import CtaBand from "../../../components/CtaBand.astro";
import ModuleFaqSection from "../../../components/modules/ModuleFaqSection.astro";
import { moduleFaqContext } from "../../../data/moduleFaqImages";
import SectionIntro from "../../../components/SectionIntro.astro";
import ModuleChallengeCards from "../../../components/modules/ModuleChallengeCards.astro";
import ModuleFeatureTabs from "../../../components/modules/ModuleFeatureTabs.astro";
import ModuleCrossLink from "../../../components/modules/ModuleCrossLink.astro";
import ModuleDashboardFrame from "../../../components/modules/ModuleDashboardFrame.astro";
import { getSpaceManagement } from "../../../data/i18n/spaceManagement";
import ModuleCapabilitiesIntro from "../../../components/modules/ModuleCapabilitiesIntro.astro";
import { spaceManagementFeatureImages, spaceManagementDashboardSrc, spaceManagementCapabilitiesContext } from "../../../data/spaceManagementImages";
import { breadcrumbSchema, faqSchema } from "../../../lib/seo/schema";
import { locales, langPath, type Lang } from "../../../data/lang";

export function getStaticPaths() {
  return locales.map((l) => ({ params: { lang: l.code } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = getSpaceManagement(lang);

const spaceMgmtImageClass = {
  savings: "object-contain object-center p-6 bg-stone-50",
};

const pageJsonLd = [
  breadcrumbSchema([
    { name: t.breadcrumbHome, href: langPath("/", lang) },
    { name: t.breadcrumbModules, href: langPath("/modules/", lang) },
    { name: t.breadcrumbCurrent, href: langPath("/modules/space-management/", lang) },
  ]),
  faqSchema(t.faqItems),
].filter(Boolean) as Array<Record<string, unknown>>;
---

<Layout title={t.metaTitle} description={t.metaDescription} jsonLd={pageJsonLd}>
  <Hero
    title={t.heroTitle}
    titleAccent={t.heroTitleAccent}
    lead={t.heroLead}
    align="left"
    inlineTitleAccent
    visualOnWhite
    compactTop
  >
    <ol slot="breadcrumb" class="flex flex-wrap items-center gap-1.5 text-sm text-stone-300">
      <li><a href={langPath("/", lang)} class="hover:text-coral-500 transition-colors">{t.breadcrumbHome}</a></li>
      <li aria-hidden="true">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4.5 3L7.5 6L4.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </li>
      <li><a href={langPath("/modules/", lang)} class="hover:text-coral-500 transition-colors">{t.breadcrumbModules}</a></li>
      <li aria-hidden="true">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4.5 3L7.5 6L4.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </li>
      <li><span class="text-navy-500">{t.breadcrumbCurrent}</span></li>
    </ol>

    <Button href={langPath("/contact/book-demo/", lang)} variant="primary" size="lg" slot="cta">{t.heroPrimaryCta}</Button>
    <Button href={langPath("/get-an-offer/", lang)} variant="secondary" size="lg" slot="cta">{t.heroSecondaryCta}</Button>

    <ModuleDashboardFrame
      slot="visual"
      class="reveal max-w-5xl"
      label={t.dashboardLabel}
      src={spaceManagementDashboardSrc}
      alt={t.dashboardAlt}
      width={1903}
      height={913}
    />
  </Hero>

  <section class="py-20 md:py-24 bg-stone-50">
    <div class="container-page">
      <SectionIntro
        eyebrow={t.challengesEyebrow}
        heading={t.challengesHeading}
        surface="stone"
        class="mb-12"
      />

      {t.intro.length > 0 && (
        <div class="max-w-5xl space-y-5 mb-12 md:mb-14">
          {t.intro.map((paragraph) => (
            <p class="reveal text-lg text-stone-900/80 leading-relaxed">{paragraph}</p>
          ))}
        </div>
      )}

      <ModuleChallengeCards challenges={t.challenges} />
    </div>
  </section>

  <section class="py-20 md:py-24">
    <div class="container-page">
      <ModuleCapabilitiesIntro
        eyebrow={t.capabilitiesEyebrow}
        heading={t.capabilitiesHeading}
        lead={t.solutionLead}
        leadWithSensorLinks={t.solutionLeadWithSensorLinks}
        lang={lang}
        contextAlt={t.capabilitiesContextAlt}
        context={spaceManagementCapabilitiesContext}
      />

      <ModuleFeatureTabs
        features={t.features}
        images={spaceManagementFeatureImages}
        tabId="space-mgmt-features"
        imageClass={spaceMgmtImageClass}
        lang={lang}
      />
    </div>
  </section>

  <section class="py-20 md:py-24">
    <div class="container-page">
      <SectionIntro
        eyebrow={t.audiencesEyebrow}
        heading={t.audiencesHeading}
        lead={t.audiencesLead}
        surface="white"
        class="mb-12 md:mb-14"
      />

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8 items-stretch">
        <div class="reveal bg-stone-50 border border-stone-100 rounded-xl p-8 md:p-10">
          <div class="w-11 h-11 rounded-md bg-sky-500 text-white inline-flex items-center justify-center mb-5">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 21V9l9-6 9 6v12M9 21v-6h6v6" />
            </svg>
          </div>
          <h3 class="text-2xl font-semibold text-navy-500">{t.fmHeading}</h3>
          <ul class="mt-6 space-y-3 text-navy-500">
            {t.fmItems.map((item) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 w-5 h-5 inline-flex items-center justify-center rounded-md bg-sky-500 text-white shrink-0">
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2.5 6L5 8.5L9.5 3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="reveal bg-navy-500 text-white rounded-xl p-8 md:p-10">
          <div class="w-11 h-11 rounded-md bg-sky-500 text-white inline-flex items-center justify-center mb-5">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 3v18h18" />
              <path d="M7 16l4-8 4 5 5-9" />
            </svg>
          </div>
          <h3 class="text-2xl font-semibold text-white">{t.realEstateHeading}</h3>
          <ul class="mt-6 space-y-3">
            {t.realEstateItems.map((item) => (
              <li class="flex items-start gap-3 text-white/90">
                <span class="mt-0.5 w-5 h-5 inline-flex items-center justify-center rounded-md bg-white/15 shrink-0">
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2.5 6L5 8.5L9.5 3.5" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </span>
                <span class="text-white/90">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <ModuleCrossLink
    label={t.smarterTogetherLabel}
    body={t.smarterTogether}
    linkLabel={t.smarterTogetherIndoorClimateLink}
    href={langPath("/modules/indoor-climate/", lang)}
  />

  <ModuleFaqSection
    title={t.faqTitle}
    items={t.faqItems}
    contextAlt={t.faqContextAlt}
    context={moduleFaqContext}
  />

  <CtaBand
    variant="featured"
    title={t.ctaTitle}
    subtitle={t.ctaSubtitle}
    primaryLabel={t.heroPrimaryCta}
    primaryHref={langPath("/contact/book-demo/", lang)}
    secondaryLabel={t.heroSecondaryCta}
    secondaryHref={langPath("/get-an-offer/", lang)}
  />
</Layout>
