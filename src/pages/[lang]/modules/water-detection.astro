---
import ModuleLandingPage from "../../../components/modules/ModuleLandingPage.astro";
import { getWaterDetection } from "../../../data/i18n/waterDetection";
import {
  waterDetectionDashboard,
  getWaterDetectionFeatureImages,
  waterDetectionCapabilitiesContext,
  waterDetectionSpotlightImages,
} from "../../../data/waterDetectionImages";
import { locales, langPath, type Lang } from "../../../data/lang";

export function getStaticPaths() {
  return locales.map((l) => ({ params: { lang: l.code } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = getWaterDetection(lang);
---

<ModuleLandingPage
  lang={lang}
  moduleSlug="water-detection"
  t={t}
  dashboard={waterDetectionDashboard}
  featureImages={getWaterDetectionFeatureImages(lang)}
  relatedModuleHref={langPath("/modules/preservation/", lang)}
  featureTabId="water-detection-features"
  challengeIconSet="water"
  secondaryAudienceIcon="housing"
  capabilitiesContext={waterDetectionCapabilitiesContext}
  heroInlineTitleAccent={true}
  capabilitiesBeforeChallenges={true}
  heroVisual="none"
  spotlightImages={waterDetectionSpotlightImages}
  spotlightImageClass={{
    compact: "object-cover object-top",
    pro: "object-cover object-bottom",
  }}
  capabilitiesContextImageClass="object-cover object-top"
  imageClass={{
    "smart-notifications": "object-cover object-[center_32%]",
  }}
/>
