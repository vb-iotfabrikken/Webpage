---
import PlaceholderPage from "../../../components/PlaceholderPage.astro";
import LegalProse from "../../../components/legal/LegalProse.astro";
import { getLegalHub } from "../../../data/hubs/legal";
import { getLegal } from "../../../data/i18n/legal";
import { getAbout } from "../../../data/i18n/about";
import { locales, langPath, type Lang } from "../../../data/lang";
import { isAnalyticsWaveBuilt, isLivePath } from "../../../data/launch";

export function getStaticPaths() {
  if (!isAnalyticsWaveBuilt()) return [];
  return locales.map((l) => ({ params: { lang: l.code } }));
}

const { lang } = Astro.params as { lang: Lang };
const leaf = getLegalHub(lang).leaves.find((l) => l.slug === "cookies")!;
const legal = getLegal(lang);
const a = getAbout(lang);

const unwrapHidden = (html: string) =>
  html.replace(/<a href="(\/[^"]*)">(.*?)<\/a>/g, (m, href, text) =>
    isLivePath(href) ? m : text,
  );
const cookiesBody = unwrapHidden(legal.cookies.body);

const legalHubHref = langPath("legal", lang);
const legalCrumb = isLivePath(legalHubHref)
  ? { label: legal.common.legal, href: legalHubHref }
  : { label: legal.common.legal };
---

<PlaceholderPage
  title={legal.cookies.metaTitle}
  description={leaf.lead}
  heroTitle={leaf.title}
  heroTitleAccent={leaf.titleAccent}
  heroLead={leaf.lead}
  breadcrumbs={[
    { label: legal.common.home, href: langPath("", lang) },
    legalCrumb,
    { label: leaf.title.replace(/[.,]\s*$/, "") },
  ]}
  hideNotice={true}
  primaryCta={{ label: a.common.bookDemo, href: langPath("contact/book-demo", lang) }}
  secondaryCta={{ label: a.common.contactSales, href: langPath("contact/sales", lang) }}
  ctaBandTitle={legal.cookies.ctaTitle}
  ctaBandSubtitle={legal.cookies.ctaSubtitle}
>
  <LegalProse>
    <p class="text-sm text-stone-300 not-prose">
      <strong class="text-navy-500">{legal.common.lastUpdated}</strong> {legal.cookies.lastUpdatedDate}
    </p>
    <Fragment set:html={cookiesBody} />
  </LegalProse>
</PlaceholderPage>
