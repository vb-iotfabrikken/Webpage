---
import HubIndex from "../../../components/HubIndex.astro";
import { getLegalHub } from "../../../data/hubs/legal";
import { getLegal } from "../../../data/i18n/legal";
import { locales, langPath, type Lang } from "../../../data/lang";

export function getStaticPaths() {
  return locales.map((l) => ({ params: { lang: l.code } }));
}

const { lang } = Astro.params as { lang: Lang };
const c = getLegal(lang).common;
---

<HubIndex
  hub={getLegalHub(lang)}
  basePath={langPath("legal", lang)}
  lang={lang}
  breadcrumbs={[
    { label: c.home, href: langPath("", lang) },
    { label: c.legal },
  ]}
/>
