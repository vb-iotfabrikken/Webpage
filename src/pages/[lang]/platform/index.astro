---
import PlatformOverviewPage from "../../../components/platform/PlatformOverviewPage.astro";
import { getPlatformHub } from "../../../data/hubs/platform";
import { getPlatformContent } from "../../../data/content/platform";
import { getLegal } from "../../../data/i18n/legal";
import { getUi } from "../../../data/i18n/ui";
import { locales, langPath, type Lang } from "../../../data/lang";

export function getStaticPaths() {
  return locales.map((l) => ({ params: { lang: l.code } }));
}

const { lang } = Astro.params as { lang: Lang };
const hub = getPlatformHub(lang);
const t = getLegal(lang).common;
const platformLabel = getUi(lang).footer.links.platform;

const topics = hub.leaves.flatMap((leaf) => {
  const content = getPlatformContent(leaf.slug, lang);
  if (!content || content.sections.length === 0) return [];

  return [
    {
      slug: leaf.slug,
      title: content.heroTitle ?? leaf.title,
      titleAccent: content.heroTitleAccent ?? leaf.titleAccent,
      lead: content.heroLead ?? leaf.lead,
      sections: content.sections,
    },
  ];
});
---

<PlatformOverviewPage
  hub={hub}
  topics={topics}
  lang={lang}
  breadcrumbs={[
    { label: t.home, href: langPath("", lang) },
    { label: platformLabel },
  ]}
/>
