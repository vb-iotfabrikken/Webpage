---
import { getPlatformHub } from "../../../data/hubs/platform";
import { locales, langPath, localizeSegment, canonicalizeSegment, type Lang } from "../../../data/lang";

export function getStaticPaths() {
  return locales.flatMap((l) =>
    getPlatformHub(l.code).leaves.map((leaf) => ({
      params: { lang: l.code, slug: localizeSegment(leaf.slug, l.code) },
      props: { leafSlug: leaf.slug },
    })),
  );
}

const { lang } = Astro.params as { lang: Lang; slug: string };
const { leafSlug } = Astro.props;
const slug = canonicalizeSegment(Astro.params.slug as string, lang) || leafSlug;

return Astro.redirect(`${langPath("platform", lang)}#${slug}`, 301);
---
