---
import Layout from "../../../../layouts/Layout.astro";
import Hero from "../../../../components/Hero.astro";
import Button from "../../../../components/Button.astro";
import CtaBand from "../../../../components/CtaBand.astro";
import { getCollection } from "astro:content";
import { articlesIndexPath, langPath, locales, type Lang } from "../../../../data/lang";

export function getStaticPaths() {
  return locales.map((l) => ({ params: { lang: l.code } }));
}

const { lang } = Astro.params as { lang: Lang };
const homeHref = langPath("", lang);
const articlesHref = articlesIndexPath(lang);
const contactHref = langPath("contact", lang);

const entries = await getCollection("landingpages", ({ data }) => !data.draft);

type Dimension = {
  slug: string;
  name: string;
  description: string;
  prefix: string;
};

const dimensions: Dimension[] = [
  { slug: "module", name: "Modules", description: "Filter by the IoT Fabrikken module the article belongs to.", prefix: "module:" },
  { slug: "industry", name: "Industries", description: "Filter by the industry or sector the content addresses.", prefix: "industry:" },
  { slug: "sensor", name: "Sensors", description: "Filter by the sensor type the article is about.", prefix: "sensor:" },
  { slug: "standard", name: "Standards", description: "Filter by the regulation, standard or certification referenced.", prefix: "standard:" },
  { slug: "type", name: "Content types", description: "Filter by the format of the article — guide, comparison, deep dive, etc.", prefix: "type:" },
  { slug: "level", name: "Levels", description: "Filter by the expected reader level.", prefix: "level:" },
];

// Count tags per dimension.
const perDim: Record<string, Map<string, number>> = {};
for (const d of dimensions) perDim[d.slug] = new Map();

for (const e of entries) {
  for (const t of e.data.tags ?? []) {
    for (const d of dimensions) {
      if (t.toLowerCase().startsWith(d.prefix)) {
        const value = t.slice(d.prefix.length);
        const map = perDim[d.slug];
        map.set(value, (map.get(value) ?? 0) + 1);
      }
    }
  }
}
---

<Layout
  title="Tags | Articles | IoT Fabrikken"
  description="Browse the IoT Fabrikken articles by module, industry, sensor, standard, content type or reader level."
>
  <nav class="container-page pt-6" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-1.5 text-sm text-stone-300">
      <li><a href={homeHref} class="hover:text-coral-500 transition-colors">Home</a></li>
      <li aria-hidden="true">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4.5 3L7.5 6L4.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </li>
      <li><a href={articlesHref} class="hover:text-coral-500 transition-colors">Articles</a></li>
      <li aria-hidden="true">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4.5 3L7.5 6L4.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </li>
      <li><span class="text-navy-500">Tags</span></li>
    </ol>
  </nav>

  <Hero
    title="Browse by tag."
    titleAccent="Six ways to find the right article."
    lead="Pick a dimension below and drill into the articles tagged with a specific module, industry, sensor, standard, content type or reader level."
    align="left"
    compactTop
  >
    <Button href={articlesHref} variant="primary" size="lg" slot="cta">Back to articles</Button>
    <Button href={contactHref} variant="secondary" size="lg" slot="cta">Suggest a topic</Button>
  </Hero>

  <section class="py-16">
    <div class="container-page space-y-12">
      {dimensions.map((d) => {
        const entries = Array.from(perDim[d.slug].entries()).sort(
          (a, b) => b[1] - a[1] || a[0].localeCompare(b[0], "en"),
        );
        return (
          <div id={d.slug} class="reveal scroll-mt-24">
            <div class="flex flex-wrap items-end justify-between gap-4 mb-4 pb-3 border-b border-stone-100">
              <div>
                <h2 class="text-2xl md:text-3xl font-bold text-navy-500 tracking-tight">{d.name}</h2>
                <p class="mt-1 text-stone-900/70 max-w-2xl">{d.description}</p>
              </div>
              <span class="text-xs font-semibold uppercase tracking-wider text-stone-300">
                {entries.length} {entries.length === 1 ? "tag" : "tags"}
              </span>
            </div>
            {entries.length === 0 ? (
              <p class="text-sm text-stone-300 italic">No tags in this dimension yet.</p>
            ) : (
              <div class="flex flex-wrap gap-2">
                {entries.map(([value, count]) => (
                  <a
                    href={langPath(`articles/tags/${d.slug}/${value}`, lang)}
                    class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-white border border-stone-100 text-navy-500 hover:border-navy-500 text-sm font-medium transition-colors"
                  >
                    {value}
                    <span class="text-xs text-stone-300">{count}</span>
                  </a>
                ))}
              </div>
            )}
          </div>
        );
      })}
    </div>
  </section>

  <CtaBand
    title="Can't find what you're looking for?"
    subtitle="Tell us what topic is missing — we plan the articles together with our customers."
    primaryLabel="Book a free demo"
    secondaryLabel="Contact sales"
  />
</Layout>
