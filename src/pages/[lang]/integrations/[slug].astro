---
import PlaceholderPage from "../../../components/PlaceholderPage.astro";
import { integrationsHub } from "../../../data/site";
import { locales } from "../../../data/lang";

export function getStaticPaths() {
  return locales.flatMap((l) =>
    integrationsHub.leaves.map((leaf) => ({
      params: { lang: l.code, slug: leaf.slug },
      props: { leaf },
    })),
  );
}

const { leaf } = Astro.props;
---

<PlaceholderPage
  title={`${leaf.title.replace(/\.$/, "")} | IoT Fabrikken`}
  description={leaf.lead}
  heroTitle={leaf.title}
  heroTitleAccent={leaf.titleAccent}
  heroLead={leaf.lead}
  breadcrumbs={[
    { label: "Home", href: "/en/" },
    { label: "Integrations", href: "/en/integrations/" },
    { label: leaf.title.replace(/\.$/, "") },
  ]}
  primaryCta={leaf.primaryCta}
  secondaryCta={leaf.secondaryCta}
/>
