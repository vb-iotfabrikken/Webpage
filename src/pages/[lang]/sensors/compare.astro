---
import Layout from "../../../layouts/Layout.astro";
import Hero from "../../../components/Hero.astro";
import Button from "../../../components/Button.astro";
import CtaBand from "../../../components/CtaBand.astro";
import SensorCompareMatrix from "../../../components/sensors/SensorCompareMatrix.astro";
import {
  getCompareSensors,
  getCompareSensorsByCategory,
  getCompareUseCases,
} from "../../../data/sensorCompare";
import { getSensorsHub } from "../../../data/hubs/sensors";
import { getUi } from "../../../data/i18n/ui";
import { locales, langPath, type Lang } from "../../../data/lang";

export function getStaticPaths() {
  return locales.map((l) => ({ params: { lang: l.code } }));
}

const { lang } = Astro.params as { lang: Lang };
const sensors = getCompareSensors(lang);
const byCategory = getCompareSensorsByCategory(lang);
const compareUseCases = getCompareUseCases(lang);
const t = getUi(lang).sensors;

const compareLeaf = getSensorsHub(lang).leaves.find((leaf) => leaf.slug === "compare");
const compareTitle = compareLeaf?.title ?? "Compare sensors.";
const compareLead =
  compareLeaf?.lead ??
  "A side-by-side comparison of every sensor in the catalogue so you can pick the right one for your rooms.";

const duelStrings = {
  pickTwoDifferent: t.compare.pickTwoDifferent,
  sameProfile: t.compare.sameProfile,
  capability: t.compare.capability,
  yes: t.compare.yes,
  battery: t.compare.battery,
  connectivity: t.compare.connectivity,
};
---

<Layout title={`${compareTitle.replace(/\.$/, "")} | IoT Fabrikken`} description={compareLead}>
  <nav class="container-page pt-6" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-1.5 text-sm text-stone-300">
      <li class="flex items-center gap-1.5">
        <a href={langPath("/", lang)} class="hover:text-coral-500 transition-colors">{t.breadcrumb.home}</a>
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M4.5 3L7.5 6L4.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </li>
      <li class="flex items-center gap-1.5">
        <a href={langPath("/sensors/", lang)} class="hover:text-coral-500 transition-colors">{t.breadcrumb.sensors}</a>
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M4.5 3L7.5 6L4.5 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </li>
      <li><span class="text-navy-500">{t.breadcrumb.compare}</span></li>
    </ol>
  </nav>

  <Hero
    title={compareTitle}
    titleAccent={t.compare.heroAccent}
    lead={compareLead}
    align="left"
    compactTop
  >
    <Button href={langPath("/contact/book-demo/", lang)} variant="primary" size="lg" slot="cta">{t.common.bookDemo}</Button>
    <Button href={langPath("/sensors/product-sheets/", lang)} variant="secondary" size="lg" slot="cta">{t.common.productSheets}</Button>
  </Hero>

  <section class="pb-8 md:pb-12 bg-stone-50" data-hero-gap-keep>
    <div class="container-page">
      <div class="reveal bg-white border border-stone-100 rounded-xl p-5 md:p-8 shadow-sm overflow-visible">
        <div class="mb-6 pb-6 border-b border-stone-100 space-y-4">
          <div
            class="flex flex-wrap gap-1 rounded-lg border border-stone-100 p-1 bg-stone-50 w-fit"
            role="tablist"
            aria-label={t.compare.filterByLine}
          >
            <button
              type="button"
              id="category-all"
              class="category-btn px-3 py-2 text-sm font-semibold rounded-md transition-colors bg-white text-navy-500 shadow-sm"
              data-category="all"
              aria-pressed="true"
            >
              {t.compare.all} ({sensors.length})
            </button>
            {byCategory.map((group) => (
              <button
                type="button"
                class="category-btn px-3 py-2 text-sm font-semibold rounded-md transition-colors text-stone-900/60 hover:text-navy-500"
                data-category={group.category}
                aria-pressed="false"
              >
                {group.label.replace("RoomAlyzer ", "")} ({group.sensors.length})
              </button>
            ))}
          </div>

          <div class="flex flex-wrap gap-2" id="use-case-filters" role="group" aria-label={t.compare.highlightByUseCase}>
            {compareUseCases.map((useCase) => (
              <button
                type="button"
                class="use-case-btn px-3 py-1.5 rounded-full border border-stone-200 bg-stone-50 text-xs font-medium text-navy-500 hover:border-navy-500 transition-colors"
                data-slugs={useCase.slugs.join(",")}
                aria-pressed="false"
                title={useCase.description}
              >
                {useCase.label}
              </button>
            ))}
            <button
              type="button"
              id="use-case-clear"
              class="px-3 py-1.5 rounded-full border border-dashed border-stone-300 text-xs font-medium text-stone-900/45 hover:border-navy-500 hover:text-navy-500 transition-colors"
            >
              {t.compare.clear}
            </button>
          </div>
        </div>

        <SensorCompareMatrix sensors={sensors} lang={lang} showHeader={false} showSensorCards={false} />
      </div>
    </div>
  </section>

  <section class="py-14 md:py-16">
    <div class="container-page">
      <div class="reveal max-w-2xl mb-10">
        <p class="inline-block px-3 py-1 rounded-md bg-stone-100 text-navy-500 text-xs font-semibold uppercase tracking-wider mb-4">
          {t.compare.headToHead}
        </p>
        <h2 class="text-2xl md:text-3xl font-bold text-navy-500 tracking-tight">
          {t.compare.headToHeadHeading}
        </h2>
      </div>

      <div class="reveal bg-white border border-stone-100 rounded-xl p-6 md:p-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
          <label class="block">
            <span class="text-sm font-medium text-navy-500 mb-2 block">{t.compare.sensorA}</span>
            <select id="duel-a" class="w-full rounded-lg border border-stone-200 px-3 py-2.5 text-sm text-navy-500 bg-white focus:border-navy-500 focus:outline-none focus:ring-2 focus:ring-navy-500/20">
              {sensors.map((s, i) => (
                <option value={s.slug} selected={i === 0}>{s.name}</option>
              ))}
            </select>
          </label>
          <label class="block">
            <span class="text-sm font-medium text-navy-500 mb-2 block">{t.compare.sensorB}</span>
            <select id="duel-b" class="w-full rounded-lg border border-stone-200 px-3 py-2.5 text-sm text-navy-500 bg-white focus:border-navy-500 focus:outline-none focus:ring-2 focus:ring-navy-500/20">
              {sensors.map((s, i) => (
                <option value={s.slug} selected={i === 1}>{s.name}</option>
              ))}
            </select>
          </label>
        </div>
        <div id="duel-output" class="space-y-6"></div>
      </div>
    </div>
  </section>

  <CtaBand
    title={t.compare.ctaTitle}
    subtitle={t.compare.ctaSubtitle}
    primaryLabel={t.common.bookDemo}
    primaryHref={langPath("/contact/book-demo/", lang)}
    secondaryLabel={t.compare.browseAllSensors}
    secondaryHref={langPath("/sensors/", lang)}
  />
</Layout>

<script define:vars={{ compareUseCases, sensors, duelStrings }}>
  const matrixRoot = document.getElementById("sensor-compare-matrix");
  const categoryButtons = document.querySelectorAll(".category-btn");
  const useCaseButtons = document.querySelectorAll(".use-case-btn");
  const useCaseClear = document.getElementById("use-case-clear");
  const duelA = document.getElementById("duel-a");
  const duelB = document.getElementById("duel-b");
  const duelOutput = document.getElementById("duel-output");

  const matrixData = JSON.parse(matrixRoot?.dataset.matrix ?? "{}");
  const rowGroups = JSON.parse(matrixRoot?.dataset.rowGroups ?? "[]");
  const sensorMeta = JSON.parse(matrixRoot?.dataset.sensors ?? "[]");

  function setCategoryFilter(category) {
    categoryButtons.forEach((btn) => {
      const active = btn.dataset.category === category;
      btn.setAttribute("aria-pressed", String(active));
      btn.classList.toggle("bg-white", active);
      btn.classList.toggle("text-navy-500", active);
      btn.classList.toggle("shadow-sm", active);
      btn.classList.toggle("text-stone-900/60", !active);
    });

    matrixRoot?.querySelectorAll("[data-sensor-col]").forEach((col) => {
      const colCategory = col.getAttribute("data-category");
      const show = category === "all" || colCategory === category;
      col.classList.toggle("hidden", !show);
    });
  }

  function setUseCaseHighlight(slugs) {
    matrixRoot?.querySelectorAll("[data-sensor-col]").forEach((col) => {
      const slug = col.getAttribute("data-slug");
      const match = slugs.length === 0 || slugs.includes(slug);
      col.classList.toggle("compare-col-dim", slugs.length > 0 && !match);
      col.classList.toggle("compare-col-highlight", slugs.length > 0 && match);
    });

    useCaseButtons.forEach((btn) => {
      const btnSlugs = btn.dataset.slugs?.split(",") ?? [];
      const active = slugs.length > 0 && btnSlugs.join(",") === slugs.join(",");
      btn.setAttribute("aria-pressed", String(active));
      btn.classList.toggle("border-navy-500", active);
      btn.classList.toggle("bg-sky-50", active);
      btn.classList.toggle("text-sky-700", active);
    });
  }

  categoryButtons.forEach((btn) => {
    btn.addEventListener("click", () => setCategoryFilter(btn.dataset.category ?? "all"));
  });

  useCaseButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const slugs = btn.dataset.slugs?.split(",") ?? [];
      const isActive = btn.getAttribute("aria-pressed") === "true";
      setUseCaseHighlight(isActive ? [] : slugs);
    });
  });

  useCaseClear?.addEventListener("click", () => setUseCaseHighlight([]));

  function formatCell(value) {
    if (value === true) return { kind: "yes", text: duelStrings.yes };
    if (value === false) return { kind: "no", text: "—" };
    return { kind: "note", text: String(value) };
  }

  function renderDuel() {
    if (!duelOutput || !duelA || !duelB) return;
    const slugA = duelA.value;
    const slugB = duelB.value;
    const metaA = sensorMeta.find((s) => s.slug === slugA);
    const metaB = sensorMeta.find((s) => s.slug === slugB);
    const rowA = matrixData[slugA] ?? {};
    const rowB = matrixData[slugB] ?? {};

    if (slugA === slugB) {
      duelOutput.innerHTML = `<p class="text-stone-900/70 text-sm">${duelStrings.pickTwoDifferent}</p>`;
      return;
    }

    let rowsHtml = "";

    for (const group of rowGroups) {
      const groupRows = group.rows
        .map((row) => {
          const a = rowA[row.id];
          const b = rowB[row.id];
          if (a === b) return null;
          const cellA = formatCell(a);
          const cellB = formatCell(b);
          return `
            <tr class="border-b border-stone-100 last:border-0">
              <td class="py-3 pr-4 text-sm font-medium text-navy-500">${row.label}</td>
              <td class="py-3 px-3 text-sm text-center ${cellA.kind === "yes" ? "text-sky-700 font-semibold" : "text-stone-900/60"}">${cellA.text}</td>
              <td class="py-3 pl-3 text-sm text-center ${cellB.kind === "yes" ? "text-sky-700 font-semibold" : "text-stone-900/60"}">${cellB.text}</td>
            </tr>`;
        })
        .filter(Boolean)
        .join("");

      if (!groupRows) continue;

      rowsHtml += `
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-wider text-stone-900/50 mb-2">${group.label}</h3>
          <table class="w-full">
            <thead>
              <tr class="border-b border-stone-200">
                <th class="pb-2 text-left text-xs font-semibold text-stone-900/50">${duelStrings.capability}</th>
                <th class="pb-2 px-3 text-center text-xs font-semibold text-navy-500">${metaA?.name ?? slugA}</th>
                <th class="pb-2 pl-3 text-center text-xs font-semibold text-navy-500">${metaB?.name ?? slugB}</th>
              </tr>
            </thead>
            <tbody>${groupRows}</tbody>
          </table>
        </div>`;
    }

    const metaBlock = `
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pb-6 mb-6 border-b border-stone-100">
        <div class="rounded-lg bg-stone-50 p-4">
          <p class="font-semibold text-navy-500">${metaA?.name}</p>
          <p class="text-xs text-stone-900/60 mt-1">${metaA?.tagline}</p>
          <dl class="mt-3 space-y-1 text-xs">
            <div class="flex justify-between gap-2"><dt class="text-stone-900/50">${duelStrings.battery}</dt><dd class="text-navy-500 font-medium">${metaA?.batteryLife}</dd></div>
            <div class="flex justify-between gap-2"><dt class="text-stone-900/50">${duelStrings.connectivity}</dt><dd class="text-navy-500 font-medium">${metaA?.connectivity}</dd></div>
          </dl>
        </div>
        <div class="rounded-lg bg-stone-50 p-4">
          <p class="font-semibold text-navy-500">${metaB?.name}</p>
          <p class="text-xs text-stone-900/60 mt-1">${metaB?.tagline}</p>
          <dl class="mt-3 space-y-1 text-xs">
            <div class="flex justify-between gap-2"><dt class="text-stone-900/50">${duelStrings.battery}</dt><dd class="text-navy-500 font-medium">${metaB?.batteryLife}</dd></div>
            <div class="flex justify-between gap-2"><dt class="text-stone-900/50">${duelStrings.connectivity}</dt><dd class="text-navy-500 font-medium">${metaB?.connectivity}</dd></div>
          </dl>
        </div>
      </div>`;

    duelOutput.innerHTML =
      metaBlock + (rowsHtml || `<p class="text-stone-900/70 text-sm">${duelStrings.sameProfile}</p>`);
  }

  duelA?.addEventListener("change", renderDuel);
  duelB?.addEventListener("change", renderDuel);
  renderDuel();
</script>

<style>
  .compare-col-dim {
    opacity: 0.35;
  }
  .compare-col-highlight [data-col-head],
  .compare-col-highlight td {
    background-color: rgb(224 242 254 / 0.5);
  }
</style>
