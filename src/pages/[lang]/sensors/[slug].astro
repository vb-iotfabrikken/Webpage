---
import PlaceholderPage from "../../../components/PlaceholderPage.astro";
import SensorPageContent from "../../../components/content/SensorPageContent.astro";
import SensorProductGallery from "../../../components/sensors/SensorProductGallery.astro";
import { sensorsHub, getSensorsHub } from "../../../data/hubs/sensors";
import { getSensorContent } from "../../../data/content/sensors";
import { localizedSensorName } from "../../../data/sensorCategories";
import { getSensorProductImage, sensorProductOgImage } from "../../../data/sensorProductImages";
import { getSensorHeroSpecs } from "../../../data/sensorHeroSpecs";
import {
  getSensorProductSchemaProperties,
  isEnhancedProductPage,
} from "../../../data/sensorTechnicalSpecs";
import { productSchema } from "../../../lib/seo/schema";
import { getUi } from "../../../data/i18n/ui";
import { locales, langPath, localizeSegment, canonicalizeSegment, type Lang } from "../../../data/lang";

export function getStaticPaths() {
  const slugs = sensorsHub.leaves
    .filter((leaf) => leaf.slug !== "compare")
    .map((leaf) => leaf.slug);
  return locales.flatMap((l) =>
    slugs.map((slug) => ({ params: { lang: l.code, slug: localizeSegment(slug, l.code) } })),
  );
}

const { lang } = Astro.params as { lang: Lang; slug: string };
const slug = canonicalizeSegment(Astro.params.slug as string, lang);
const hub = getSensorsHub(lang);
const leaf = hub.leaves.find((entry) => entry.slug === slug)!;
const content = getSensorContent(slug, lang);
const t = getUi(lang).sensors;
const enhanced = isEnhancedProductPage(slug);

const getOfferHref = langPath("/get-an-offer/", lang);
const secondaryCta = { label: t.common.getAnOffer, href: getOfferHref };
const productSheetCta = leaf.productSheetUrl
  ? { label: t.common.downloadProductSheet, href: leaf.productSheetUrl }
  : undefined;

// Enforce the localized sensor name (e.g. de "Wasserdetektor") regardless of
// whether the translated hero copy supplies its own title.
const heroTitle = localizedSensorName(slug, content?.heroTitle ?? leaf.title, lang);
const productName = heroTitle.replace(/\.$/, "");
const productImage = getSensorProductImage(slug);
const ogImage = leaf.ogImage ?? sensorProductOgImage(slug);

const schemaProperties = enhanced
  ? getSensorProductSchemaProperties(slug, lang, t.detail.specs.rows)
  : undefined;

const sensorJsonLd = productSchema({
  name: productName,
  description: leaf.metaDescription ?? content?.heroLead ?? leaf.lead,
  url: Astro.url.pathname,
  image: ogImage,
  brand: "RoomAlyzer",
  additionalProperty: schemaProperties,
});

const heroSpecs = enhanced ? getSensorHeroSpecs(slug, lang) : undefined;
---

<PlaceholderPage
  title={`${leaf.seoTitle ?? productName} | IoT Fabrikken`}
  description={leaf.metaDescription ?? content?.heroLead ?? leaf.lead}
  ogImage={ogImage}
  ogImageAlt={productImage?.imageAlt}
  noindex={leaf.noindex}
  jsonLd={sensorJsonLd}
  analyticsPageType="sensor"
  analyticsContentId={slug}
  heroTitle={heroTitle}
  heroTitleAccent={content?.heroTitleAccent ?? leaf.titleAccent}
  heroLead={content?.heroLead ?? leaf.lead}
  breadcrumbs={[
    { label: t.breadcrumb.home, href: langPath("/", lang) },
    { label: t.breadcrumb.sensors, href: langPath("/sensors/", lang) },
    { label: productName },
  ]}
  primaryCta={leaf.primaryCta ?? { label: t.common.bookLiveDemo, href: langPath("/contact/book-demo/", lang) }}
  secondaryCta={secondaryCta}
  hideNotice={!!content}
  ctaBandTitle={t.detail.ctaBandTitle}
  ctaBandSubtitle={t.detail.ctaBandSubtitle}
  ctaBandPrimaryLabel={t.common.bookDemo}
  ctaBandPrimaryHref={langPath("/contact/book-demo/", lang)}
  ctaBandSecondaryLabel={enhanced ? t.common.getAnOffer : (productSheetCta?.label ?? t.common.contactSales)}
  ctaBandSecondaryHref={enhanced ? getOfferHref : (productSheetCta?.href ?? langPath("/contact/sales/", lang))}
>

  {content ? (
    <SensorPageContent
      content={content}
      slug={slug}
      lang={lang}
      productSheetUrl={leaf.productSheetUrl}
      heroSpecs={heroSpecs}
    />
  ) : (
    <section aria-labelledby={`${slug}-product-views`}>
      <p
        id={`${slug}-product-views`}
        class="inline-block px-3 py-1 rounded-md bg-stone-100 text-navy-500 text-xs font-semibold uppercase tracking-wider mb-5"
      >
        {t.detail.productViews}
      </p>
      <SensorProductGallery slug={slug} lang={lang} class="max-w-sm" />
    </section>
  )}
</PlaceholderPage>
