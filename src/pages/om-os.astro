---
import Layout from "../layouts/Layout.astro";
import StubPage from "../components/StubPage.astro";
---

<Layout
  title="Om os | IoT Fabrikken"
  description="100% dansk ejet SaaS- og IoT-virksomhed med egne udviklere og tæt samarbejde med kunderne."
>
  <StubPage
    eyebrow="Om os"
    title="100% dansk ejet."
    titleAccent="Bygget sammen med kunderne."
    lead="Vi udvikler sensorer og platform i tæt samarbejde med vores kunder. Det sikrer løsninger, der skaber reel værdi – ikke features for deres egen skyld."
  >
    <h2 class="text-2xl font-semibold text-navy-500 mb-4">Vores historie</h2>
    <p class="text-stone-900/70 leading-relaxed">
      Indhold om grundlæggerne, rejsen og holdet kommer snart. Vil du allerede nu møde os, så ræk ud.
    </p>
  </StubPage>
</Layout>
