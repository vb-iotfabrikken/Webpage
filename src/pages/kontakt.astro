---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import ContactForm from "../components/ContactForm.astro";
---

<Layout
  title="Kontakt | IoT Fabrikken"
  description="Tag fat i os – vi tager altid gerne en uforpligtende snak om dine muligheder."
>
  <Hero
    eyebrow="Kontakt"
    title="Lad os tage"
    titleAccent="en snak."
    lead="Har du spørgsmål, eller er du blot nysgerrig på vores løsning? Vi tager altid gerne en faglig og uforpligtende snak – online eller fysisk."
    align="left"
  />

  <ContactForm
    title="Skriv til os"
    subtitle="Udfyld formularen, så vender vi tilbage inden for én arbejdsdag."
  />
</Layout>
